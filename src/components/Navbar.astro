<style>
  :root {
    --brand-red: #e3132a;          /* merah utama */
    --brand-red-dark: #c00f22;     /* hover / pressed */
    --brand-red-bright: #ff4d5a;   /* aksen di atas hero gelap */
    --brand-red-soft: #fff1f2;     /* merah muda tipis (hover & item aktif) */
    --ink: #1a1a1a;
    --ink-soft: #4b5563;
    --ink-mute: #9ca3af;
    --line: rgba(0, 0, 0, 0.06);
  }

  /* ===== State navbar: transparan di atas hero -> solid saat scroll ===== */
  #site-navbar {
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.45s ease,
      box-shadow 0.45s ease,
      backdrop-filter 0.45s ease;
    will-change: transform;
  }

  #site-navbar.nav-hidden {
    transform: translateY(-110%);
  }

  #site-navbar.nav-hidden .nav-link {
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  #site-navbar:not(.nav-hidden) .nav-link {
    opacity: 0.92;
    transition: opacity 0.4s ease 0.15s;
  }

  #site-navbar.nav-transparent .nav-link,
  #site-navbar.nav-transparent .nav-icon-btn {
    color: #ffffff;
  }
  #site-navbar.nav-transparent .burger-line {
    background-color: #ffffff;
  }
  #site-navbar.nav-transparent {
    background: linear-gradient(to bottom, rgba(0,0,0,0.28), rgba(0,0,0,0));
  }

  #site-navbar.nav-solid {
    background-color: rgba(255,255,255,0.85);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    box-shadow:
      0 1px 0 rgba(0,0,0,0.05),
      0 20px 40px -20px rgba(0,0,0,0.18);
  }
  #site-navbar.nav-solid .nav-link,
  #site-navbar.nav-solid .nav-icon-btn {
    color: var(--ink);
  }
  #site-navbar.nav-solid .burger-line {
    background-color: var(--ink);
  }

  #site-navbar .flex.items-center.shrink-0 img {
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s ease;
  }
  #site-navbar.nav-hidden .flex.items-center.shrink-0 img {
    transform: translateY(-6px) scale(0.96);
    opacity: 0;
  }

  .nav-link {
    color: inherit;
    transition: color 0.3s ease, opacity 0.3s ease;
    opacity: 0.92;
  }
  .nav-link:hover {
    opacity: 1;
    color: var(--brand-red);
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0%;
    height: 1px;
    background-color: currentColor;
    transition: width 0.3s ease;
  }
  a.nav-link:hover::after {
    width: 100%;
  }

  /* ===== TAB AKTIF (desktop) ===== */
  .nav-link.is-active::after {
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background-color: var(--brand-red);
  }
  #site-navbar.nav-transparent .nav-link.is-active::after {
    background-color: var(--brand-red-bright);
  }
  #site-navbar.nav-solid .nav-link.is-active {
    color: var(--brand-red);
    opacity: 1;
  }

  /* =====================================================
     DROPDOWN DESKTOP
     - Kartu putih tipis dengan border halus
     - Heading kecil kapital merah dengan aksen garis merah
     - Item teks polos tanpa strip; hover & halaman aktif =
       background merah muda tipis + teks merah
     ===================================================== */

  /* Jembatan transparan supaya hover tidak putus di celah antara tombol dan panel */
  .dropdown-panel::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -16px;
    height: 16px;
  }

  .dd-card {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 16px;
    box-shadow:
      0 24px 48px -24px rgba(0, 0, 0, 0.22),
      0 2px 8px rgba(0, 0, 0, 0.04);
    text-transform: none;
  }

  /* kartu daftar sederhana (Governance, About Us) */
  .dd-card--list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.5rem;
  }

  /* kartu lebar (Products & Services): 2 kolom */
  .dd-card--wide {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    column-gap: 1.5rem;
    align-items: start;
    padding: 1.25rem 1.25rem 1.1rem;
  }
  .dd-col { min-width: 0; }
  .dd-col + .dd-col {
    padding-left: 1.5rem;
    border-left: 1px solid rgba(0, 0, 0, 0.06);
  }
  .dd-col--stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .dd-group {
    display: flex;
    flex-direction: column;
  }
  .dd-list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  /* daftar 2 kolom, item mengalir ke bawah dulu:
     kiri  = Lark, SealSuite, NetSuite
     kanan = Qiscus, Mekari, Oceanbase */
  .dd-list--grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(3, auto);
    grid-auto-flow: column;
    column-gap: 0.25rem;
    row-gap: 0.125rem;
  }

  /* heading kategori: teks merah, hover = background merah muda tipis */
  .dropdown-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
    padding: 0.4rem 0.75rem 0.6rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 0.6rem 0.6rem 0 0;
    font-family: inherit;
    font-size: 10.5px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--brand-red);
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .dropdown-heading::before {
    content: "";
    flex: 0 0 auto;
    width: 12px;
    height: 2px;
    border-radius: 2px;
    background-color: var(--brand-red);
  }
  .dropdown-heading:hover {
    color: var(--brand-red-dark);
    background-color: var(--brand-red-soft);
  }

/* item: background merah muda menyapu dari kiri saat hover */
.dropdown-item {
  position: relative;
  isolation: isolate;
  display: flex;
  align-items: center;
  padding: 0.5rem 0.75rem;
  border-radius: 0.6rem;
  font-family: inherit;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.35;
  letter-spacing: 0.01em;
  white-space: nowrap;
  color: #4b5563;
  transition:
    color 0.25s ease,
    padding-left 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}

/* lapisan merah muda (di belakang teks) */
.dropdown-item::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  border-radius: inherit;
  background-color: var(--brand-red-soft);
  opacity: 0;
  transform: scaleX(0.6);
  transform-origin: left center;
  transition:
    transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.25s ease;
}

.dropdown-item:hover,
.dropdown-item:focus-visible {
  color: var(--brand-red);
  padding-left: 1rem; /* teks geser halus ke kanan */
  outline: none;
}
.dropdown-item:hover::before,
.dropdown-item:focus-visible::before {
  opacity: 1;
  transform: scaleX(1);
}

/* halaman yang sedang dibuka */
.dropdown-item.is-active {
  color: var(--brand-red);
  font-weight: 600;
}
.dropdown-item.is-active::before {
  opacity: 1;
  transform: scaleX(1);
}

/* animasi muncul berurutan saat dropdown dibuka */
@keyframes ddItemIn {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}
.group:hover .dropdown-item,
.group:focus-within .dropdown-item {
  animation: ddItemIn 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.group:hover .dropdown-item:nth-child(1) { animation-delay: 0.04s; }
.group:hover .dropdown-item:nth-child(2) { animation-delay: 0.08s; }
.group:hover .dropdown-item:nth-child(3) { animation-delay: 0.12s; }
.group:hover .dropdown-item:nth-child(4) { animation-delay: 0.16s; }
.group:hover .dropdown-item:nth-child(5) { animation-delay: 0.20s; }
.group:hover .dropdown-item:nth-child(6) { animation-delay: 0.24s; }
  /* hover: merah muda tipis */
  .dropdown-item:hover {
    color: var(--brand-red);
    background-color: var(--brand-red-soft);
  }

  /* halaman yang sedang dibuka: merah muda tipis + teks merah */
  .dropdown-item.is-active {
    color: var(--brand-red);
    font-weight: 600;
    background-color: var(--brand-red-soft);
  }

  /* ===== TOMBOL BACK DI NAVBAR (mobile only) ===== */
  .nav-icon-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin-left: -8px;
    border-radius: 9999px;
    color: inherit;
    transition: background-color 0.25s ease, transform 0.25s ease, color 0.25s ease;
  }
  .nav-icon-btn.is-visible { display: inline-flex; }
  .nav-icon-btn:active { transform: scale(0.92); background-color: rgba(227,19,42,0.12); }
  @media (min-width: 1024px) {
    .nav-icon-btn { display: none !important; }
  }

  /* =====================================================
     MOBILE MENU (accordion polos, tanpa ikon panah)
     ===================================================== */
  .mm-panel {
    position: fixed;
    top: 0; left: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    z-index: 60;
    padding-top: 5rem;
    background:
      radial-gradient(120% 60% at 100% 0%, rgba(227,19,42,0.06), transparent 60%),
      #ffffff;
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-14px);
    transition:
      opacity 0.35s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.45s;
  }
  .mm-panel.menu-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-delay: 0s;
  }
  .mm-inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding: 0.75rem 1.25rem calc(1.5rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--line);
  }

  .mm-eyebrow {
    margin: 0.75rem 0.5rem 0.5rem;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brand-red);
  }

  .mm-list { display: flex; flex-direction: column; gap: 0.25rem; }

  /* item level 1 */
  .mm-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    padding: 0.8rem 0.9rem;
    border-radius: 1rem;
    font-size: 16px;
    font-weight: 600;
    text-align: left;
    color: var(--ink);
    background: transparent;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }
  .mm-item:active { transform: scale(0.985); background-color: var(--brand-red-soft); }
  .mm-text { flex: 1; }

  .mm-icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 0.8rem;
    color: var(--brand-red);
    background: var(--brand-red-soft);
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  .mm-icon svg { width: 20px; height: 20px; }

  /* HAPUS BLOK INI jika ingin accordion benar-benar tanpa indikator apa pun.
     Indikator plus tipis yang berubah menjadi minus saat terbuka (bukan panah). */
  .mm-toggle::after {
    content: "";
    flex: 0 0 auto;
    width: 12px;
    height: 12px;
    margin-right: 0.25rem;
    color: var(--ink-mute);
    background:
      linear-gradient(currentColor, currentColor) center / 100% 1.5px no-repeat,
      linear-gradient(currentColor, currentColor) center / 1.5px 100% no-repeat;
    transition: background-size 0.35s cubic-bezier(0.22, 1, 0.36, 1), color 0.25s ease;
  }
  .mm-acc.is-open > .mm-toggle::after {
    color: var(--brand-red);
    background-size: 100% 1.5px, 1.5px 0;
  }
  /* ---- akhir blok indikator ---- */

  /* item aktif */
  .mm-item.is-active {
    color: var(--brand-red);
    background-color: var(--brand-red-soft);
  }
  .mm-item.is-active::before {
    content: "";
    position: absolute;
    left: 0; top: 24%; bottom: 24%;
    width: 4px;
    border-radius: 0 4px 4px 0;
    background-color: var(--brand-red);
  }
  .mm-item.is-active .mm-icon {
    background: var(--brand-red);
    color: #ffffff;
    box-shadow: 0 8px 18px -8px rgba(227,19,42,0.8);
  }

  /* accordion terbuka */
  .mm-acc.is-open > .mm-toggle { background-color: #f9fafb; }
  .mm-acc.is-open > .mm-toggle.is-active { background-color: var(--brand-red-soft); }

  /* animasi buka-tutup */
  .mm-collapse {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mm-acc.is-open > .mm-collapse { grid-template-rows: 1fr; }
  .mm-collapse-inner {
    min-height: 0;
    overflow: hidden;
    visibility: hidden;
    transition: visibility 0s linear 0.45s;
  }
  .mm-acc.is-open > .mm-collapse > .mm-collapse-inner {
    visibility: visible;
    transition-delay: 0s;
  }

  /* sub-menu: garis kiri tipis, teks polos */
  .mm-sub {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0.25rem 0 0.5rem 2.1rem;
    padding: 0.25rem 0 0.25rem 1rem;
    border-left: 1px solid rgba(0,0,0,0.08);
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mm-acc.is-open .mm-sub {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.08s;
  }

  /* heading kategori mobile: merah, tekan = merah muda tipis (sama seperti desktop) */
  .mm-label {
    display: block;
    margin-top: 1.1rem;
    padding: 0.35rem 0.5rem;
    margin-left: -0.5rem;
    border-radius: 0.5rem;
    font-family: inherit;
    font-size: 10.5px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brand-red);
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .mm-label:first-child { margin-top: 0.15rem; }
  .mm-label:active,
  .mm-label:hover {
    color: var(--brand-red-dark);
    background-color: var(--brand-red-soft);
  }

  /* link sub-menu: teks polos, hover/aktif merah muda tipis */
  .mm-sublink {
    position: relative;
    display: flex;
    align-items: center;
    margin-left: -0.5rem;
    padding: 0.6rem 0.5rem;
    border-radius: 0.5rem;
    font-family: inherit;
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink-soft);
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mm-sublink:active,
  .mm-sublink:hover {
    color: var(--brand-red);
    background-color: var(--brand-red-soft);
    transform: translateX(3px);
  }
  .mm-sublink.is-active {
    color: var(--brand-red);
    font-weight: 600;
    background-color: var(--brand-red-soft);
  }

  /* footer panel */
  .mm-footer {
    margin-top: auto;
    padding-top: 1.75rem;
    display: flex;
    gap: 0.75rem;
  }
  .mm-cta {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 1.25rem;
    border-radius: 1rem;
    font-size: 14.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #ffffff;
    background: linear-gradient(135deg, var(--brand-red), var(--brand-red-dark));
    box-shadow: 0 12px 26px -12px rgba(227,19,42,0.8);
    transition: transform 0.15s ease, box-shadow 0.2s ease;
  }
  .mm-cta:active { transform: scale(0.97); box-shadow: 0 6px 14px -8px rgba(227,19,42,0.8); }
  .mm-copy {
    margin: 1rem 0 0;
    text-align: center;
    font-size: 11.5px;
    color: var(--ink-mute);
  }

  /* animasi masuk berurutan (stagger) */
  @keyframes mmIn {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .mm-panel.menu-open .mm-eyebrow,
  .mm-panel.menu-open .mm-list > *,
  .mm-panel.menu-open .mm-footer,
  .mm-panel.menu-open .mm-copy {
    animation: mmIn 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(0.08s + var(--i, 0) * 0.05s);
  }

@media (prefers-reduced-motion: reduce) {
  .mm-panel, .mm-collapse, .mm-sub, .mm-sublink, .mm-sublink::before,
  .mm-toggle::after, .dropdown-item, .dropdown-item::before {
    transition-duration: 0.01ms !important;
  }
  .group:hover .dropdown-item,
  .group:focus-within .dropdown-item { animation: none !important; }
  .mm-panel.menu-open .mm-eyebrow,
  .mm-panel.menu-open .mm-list > *,
  .mm-panel.menu-open .mm-footer,
  .mm-panel.menu-open .mm-copy { animation: none !important; }
}
</style>

<script>
  const navbar = document.getElementById('site-navbar');
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const navBack = document.getElementById('nav-back');

  const heroThreshold = 60;
  const hoverRevealZone = 80; // px dari atas layar untuk trigger hover reveal

  // Halaman dengan hero: navbar mulai transparan. Halaman lain: selalu solid.
  // Diset dari Layout lewat <body data-navbar-transparent="true">
  const hasHero: boolean =
    document.body.dataset.navbarTransparent === 'true' ||
    document.querySelector('.hero') !== null;

  let lastScrollY = window.scrollY;
  let menuOpen = false;
  let currentPath = '/';

  /* ================= NAVBAR BACKGROUND / HIDE-SHOW ================= */

  function updateNavbarBackground(): void {
    if (!navbar) return;
    const solid = !hasHero || menuOpen || window.scrollY > heroThreshold;
    navbar.classList.toggle('nav-solid', solid);
    navbar.classList.toggle('nav-transparent', !solid);
  }

  function showNavbar(): void {
    if (navbar) navbar.classList.remove('nav-hidden');
  }

  function hideNavbar(): void {
    if (menuOpen) return; // jangan sembunyikan kalau menu mobile lagi kebuka
    if (navbar) navbar.classList.add('nav-hidden');
  }

  function handleScroll(): void {
    const currentScrollY = window.scrollY;

    updateNavbarBackground();

    if (currentScrollY <= heroThreshold) {
      showNavbar();
    } else if (currentScrollY > lastScrollY) {
      hideNavbar();
    } else if (currentScrollY < lastScrollY) {
      showNavbar();
    }

    lastScrollY = currentScrollY;
  }

  function handleMouseMove(e: MouseEvent): void {
    if (e.clientY <= hoverRevealZone) showNavbar();
  }

  function handleResize(): void {
    if (window.innerWidth >= 1024 && menuOpen) closeMobileMenu();
    updateNavbarBackground();
  }

  /* ================= TAB AKTIF ================= */

  function normalizePath(p: string): string {
    let path = p.replace(/index\.html$/, '');
    if (path.length > 1) path = path.replace(/\/+$/, '');
    return path || '/';
  }

  // Panjang path jika link cocok dengan halaman sekarang, selain itu -1
  function matchLength(href: string | null): number {
    if (!href || href.charAt(0) === '#') return -1;
    let url: URL;
    try {
      url = new URL(href, window.location.origin);
    } catch (err) {
      return -1;
    }
    if (url.origin !== window.location.origin) return -1; // link eksternal diabaikan
    const p = normalizePath(url.pathname);
    if (p === '/') return currentPath === '/' ? 1 : -1;
    if (currentPath === p || currentPath.indexOf(p + '/') === 0) return p.length;
    return -1;
  }

  function setActive(el: Element): void {
    el.classList.add('is-active');
    el.setAttribute('aria-current', 'page');
  }

  // Dalam satu grup hanya link dengan path paling spesifik yang aktif
  function markGroupActive(links: HTMLAnchorElement[]): boolean {
    let best = -1;
    let bestEl: HTMLAnchorElement | null = null;
    for (const a of links) {
      const len = matchLength(a.getAttribute('href'));
      if (len > best) {
        best = len;
        bestEl = a;
      }
    }
    if (bestEl !== null) {
      setActive(bestEl);
      return true;
    }
    return false;
  }

  function markActiveNav(): void {
    if (!navbar) return;
    const nav: HTMLElement = navbar;

    nav.querySelectorAll('.is-active').forEach((el) => {
      el.classList.remove('is-active');
      el.removeAttribute('aria-current');
    });
    currentPath = normalizePath(window.location.pathname);

    // Home (desktop + mobile)
    nav.querySelectorAll<HTMLAnchorElement>('a[data-nav-home]').forEach((a) => {
      if (currentPath === '/') setActive(a);
    });

    // Dropdown desktop
    nav.querySelectorAll<HTMLElement>('.dropdown-panel[data-nav-group]').forEach((panel) => {
      const links = Array.from(panel.querySelectorAll<HTMLAnchorElement>('a.dropdown-item'));
      if (markGroupActive(links)) {
        const trigger = panel.closest('.group');
        const btn = trigger ? trigger.querySelector('button.nav-link') : null;
        if (btn) btn.classList.add('is-active');
      }
    });

    // Accordion mobile
    nav.querySelectorAll<HTMLElement>('.mm-acc[data-nav-group]').forEach((acc) => {
      const links = Array.from(acc.querySelectorAll<HTMLAnchorElement>('a.mm-sublink'));
      if (markGroupActive(links)) {
        const toggle = acc.querySelector('.mm-toggle');
        if (toggle) toggle.classList.add('is-active');
      }
    });

    updateBackButton();
  }

  /* ================= TOMBOL BACK NAVBAR ================= */

  function updateBackButton(): void {
    if (!navBack) return;
    const show = currentPath !== '/' && !menuOpen;
    navBack.classList.toggle('is-visible', show);
  }

  if (navBack) {
    navBack.addEventListener('click', () => {
      let sameOrigin = false;
      try {
        sameOrigin =
          Boolean(document.referrer) &&
          new URL(document.referrer).origin === window.location.origin;
      } catch (err) {
        sameOrigin = false;
      }
      if (sameOrigin && window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/'; // fallback kalau user masuk langsung dari link
      }
    });
  }

  /* ================= MOBILE MENU (accordion) ================= */

  function setAccordion(acc: Element, open: boolean): void {
    acc.classList.toggle('is-open', open);
    const btn = acc.querySelector('.mm-toggle');
    if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  function closeAllAccordions(except?: Element): void {
    if (!mobileMenu) return;
    mobileMenu.querySelectorAll('.mm-acc').forEach((acc) => {
      if (acc !== except) setAccordion(acc, false);
    });
  }

  // Buka otomatis grup yang berisi halaman aktif
  function openActiveAccordion(): void {
    if (!mobileMenu) return;
    const activeToggle = mobileMenu.querySelector('.mm-toggle.is-active');
    const acc = activeToggle ? activeToggle.closest('.mm-acc') : null;
    if (acc) setAccordion(acc, true);
  }

  if (mobileMenu) {
    mobileMenu.addEventListener('click', (e: MouseEvent) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const toggle = target.closest('.mm-toggle');
      if (toggle) {
        const acc = toggle.closest('.mm-acc');
        if (acc) {
          const willOpen = !acc.classList.contains('is-open');
          closeAllAccordions(acc); // satu grup terbuka dalam satu waktu
          setAccordion(acc, willOpen);
        }
        return;
      }

      // klik link -> tutup panel
      if (target.closest('a[href]')) closeMobileMenu();
    });
  }

  function setBurgerState(open: boolean): void {
    if (!toggleBtn) return;
    const lines = toggleBtn.querySelectorAll<HTMLElement>('.burger-line');
    if (lines.length < 3) return;

    if (open) {
      lines[0].style.transform = 'translateY(6.5px) rotate(45deg)';
      lines[1].style.opacity = '0';
      lines[2].style.transform = 'translateY(-6.5px) rotate(-45deg)';
    } else {
      lines[0].style.transform = 'none';
      lines[1].style.opacity = '1';
      lines[2].style.transform = 'none';
    }
  }

  function openMobileMenu(): void {
    if (!mobileMenu || !toggleBtn) return;
    menuOpen = true;
    mobileMenu.classList.add('menu-open');
    mobileMenu.setAttribute('aria-hidden', 'false');
    mobileMenu.scrollTop = 0;
    toggleBtn.classList.add('is-active');
    toggleBtn.setAttribute('aria-expanded', 'true');

    setBurgerState(true);
    document.body.style.overflow = 'hidden';
    showNavbar();
    updateNavbarBackground();
    updateBackButton();

    closeAllAccordions();
    openActiveAccordion();
  }

  function closeMobileMenu(): void {
    if (!mobileMenu || !toggleBtn) return;
    menuOpen = false;
    mobileMenu.classList.remove('menu-open');
    mobileMenu.setAttribute('aria-hidden', 'true');
    toggleBtn.classList.remove('is-active');
    toggleBtn.setAttribute('aria-expanded', 'false');

    setBurgerState(false);
    document.body.style.overflow = '';
    updateNavbarBackground();
    updateBackButton();
  }

  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      if (menuOpen) closeMobileMenu();
      else openMobileMenu();
    });
  }

  // tombol Esc menutup menu
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && menuOpen) closeMobileMenu();
  });

  /* ================= INIT ================= */

  updateNavbarBackground();
  markActiveNav();
  window.addEventListener('scroll', handleScroll, { passive: true });
  window.addEventListener('mousemove', handleMouseMove, { passive: true });
  window.addEventListener('resize', handleResize, { passive: true });

</script>