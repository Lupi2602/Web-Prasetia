---
import MainLayout from '../../../layouts/MainLayout.astro';
---

<MainLayout title="Telecommunication & Infrastructure Contractor | PT Prasetia Dwidharma">
  <!-- Hero Section -->
  <section class="bg-gray-900 text-white py-16 lg:py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-25">
      <img
        src="/images/hero/hero4.jpg"
        alt="Telecommunication Tower"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container mx-auto px-6 max-w-6xl relative z-10">
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-4 max-w-3xl leading-tight">
        Telecommunication &amp; Infrastructure Contractor.
      </h1>
      <p class="text-lg md:text-xl text-gray-300 max-w-2xl mb-8 leading-relaxed">
        We provide tower construction services, starting from planning, construction, mechanical, and electrical.
      </p>

      <div class="flex items-center gap-6 pt-4 border-t border-gray-700/60 max-w-md">
        <div class="text-xs text-gray-400 uppercase tracking-widest font-semibold">
          Certified by:
        </div>
        <div class="flex items-center gap-4 text-xs text-gray-300">
          <span class="border border-gray-500 rounded px-2.5 py-1">ISO 9001 (Lloyd's Register)</span>
          <span class="border border-gray-500 rounded px-2.5 py-1">UKAS Management Systems 001</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats & Scope Section -->
  <section class="py-16 bg-gray-50 border-b border-gray-200">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left: Stats (5 cols) -->
        <div class="lg:col-span-5 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-lg border border-gray-200 text-center shadow-sm">
            <span class="text-xs uppercase font-bold text-gray-500 block mb-1">New Site</span>
            <span class="text-3xl lg:text-4xl font-extrabold text-gray-900">1,204</span>
          </div>

          <div class="bg-white p-6 rounded-lg border border-gray-200 text-center shadow-sm">
            <span class="text-xs uppercase font-bold text-gray-500 block mb-1">Co-Location</span>
            <span class="text-3xl lg:text-4xl font-extrabold text-gray-900">1,122</span>
          </div>

          <div class="bg-white p-6 rounded-lg border border-gray-200 text-center shadow-sm">
            <span class="text-xs uppercase font-bold text-gray-500 block mb-1">Sitac</span>
            <span class="text-3xl lg:text-4xl font-extrabold text-gray-900">4,015</span>
          </div>

          <div class="bg-white p-6 rounded-lg border border-gray-200 text-center shadow-sm">
            <span class="text-xs uppercase font-bold text-gray-500 block mb-1">Maintenance</span>
            <span class="text-3xl lg:text-4xl font-extrabold text-gray-900">8,714</span>
          </div>

          <div class="bg-white p-6 rounded-lg border border-gray-200 text-center shadow-sm sm:col-span-1 lg:col-span-2">
            <span class="text-xs uppercase font-bold text-gray-500 block mb-1">Fiber Optic</span>
            <span class="text-3xl lg:text-4xl font-extrabold text-gray-900">450<span class="text-xl font-medium text-gray-600">km</span></span>
          </div>
        </div>

        <!-- Right: Scope of Work (7 cols) -->
        <div class="lg:col-span-7 lg:pl-6">
          <p class="text-lg text-gray-800 leading-relaxed mb-6 font-medium">
            We focus our services through our expertise in telecommunication infrastructure, mainly constructing Base Transceiver Station (BTS) towers. The scope of work includes:
          </p>
          <ul class="space-y-3">
            <li class="flex items-center gap-3 text-gray-700">
              <span class="w-2 h-2 rounded-full bg-red-700 shrink-0"></span>
              <span>Construction of BTS towers</span>
            </li>
            <li class="flex items-center gap-3 text-gray-700">
              <span class="w-2 h-2 rounded-full bg-red-700 shrink-0"></span>
              <span>Co-location work of BTS towers</span>
            </li>
            <li class="flex items-center gap-3 text-gray-700">
              <span class="w-2 h-2 rounded-full bg-red-700 shrink-0"></span>
              <span>Site Acquisition (SITAC)</span>
            </li>
            <li class="flex items-center gap-3 text-gray-700">
              <span class="w-2 h-2 rounded-full bg-red-700 shrink-0"></span>
              <span>Maintenance and Repair</span>
            </li>
            <li class="flex items-center gap-3 text-gray-700">
              <span class="w-2 h-2 rounded-full bg-red-700 shrink-0"></span>
              <span>Fiber Optic</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Clients & Partners Section -->
  <section class="py-16 bg-white border-b border-gray-200">
    <div class="container mx-auto px-6 max-w-6xl">
      <!-- Clients -->
      <div class="mb-12">
        <h3 class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-6 text-center">Client</h3>
        <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
          <span class="text-xl font-bold text-gray-600">Telkomsel</span>
          <span class="text-xl font-bold text-gray-600">Indosat</span>
          <span class="text-xl font-bold text-gray-600">XL</span>
          <span class="text-xl font-bold text-gray-600">Axis</span>
        </div>
      </div>

      <!-- Partners -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-6 text-center">Partner</h3>
        <div class="flex flex-wrap items-center justify-center gap-6 md:gap-10">
          <img src="/images/client/logo-tower-bersama-group.png" alt="Tower Bersama Group" class="h-8 max-w-[120px] object-contain" />
          <img src="/images/client/Logo_Mitratel.png" alt="Mitratel" class="h-8 max-w-[120px] object-contain" />
          <img src="/images/client/logo-telkom-infra.jpg" alt="Telkom Infra" class="h-8 max-w-[120px] object-contain" />
          <img src="/images/client/logo-protelindo.jpg" alt="Protelindo" class="h-8 max-w-[120px] object-contain" />
          <img src="/images/client/logo-msn.png" alt="MSN" class="h-8 max-w-[120px] object-contain" />
          <span class="text-lg font-bold text-gray-600">Balitower</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 Pillars Section -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-3">PT Prasetia Dwidharma</h2>
        <p class="text-gray-600 max-w-xl mx-auto">
          We provide tower construction services, starting from planning, construction, mechanical, and electrical
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- 1 -->
        <div class="bg-white p-6 rounded-lg border border-gray-200 text-center shadow-sm">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-red-50 text-red-700 flex items-center justify-center text-lg font-bold">
            1
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">Quality Is Our Priority</h3>
          <p class="text-sm text-gray-600">
            We dedicate ourselves to have the best Quality, Cost, and Delivery
          </p>
        </div>

        <!-- 2 -->
        <div class="bg-white p-6 rounded-lg border border-gray-200 text-center shadow-sm">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-red-50 text-red-700 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071a10 10 0 0114.142 0M1.393 9.393a15 15 0 0121.214 0" /></svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">We Connect Everyone</h3>
          <p class="text-sm text-gray-600">
            With the best quality, we contribute to connecting everyone
          </p>
        </div>

        <!-- 3 -->
        <div class="bg-white p-6 rounded-lg border border-gray-200 text-center shadow-sm">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-red-50 text-red-700 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">Our Focus Is Technology</h3>
          <p class="text-sm text-gray-600">
            With the best technology we provide the best services
          </p>
        </div>

        <!-- 4 -->
        <div class="bg-white p-6 rounded-lg border border-gray-200 text-center shadow-sm">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-red-50 text-red-700 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">We Care About Our Earth</h3>
          <p class="text-sm text-gray-600">
            We committed to protecting and enhancing the environment
          </p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
