---
import MainLayout from '../../../layouts/MainLayout.astro';

const services = [
  {
    id: 'service-01',
    number: '01',
    title: 'Construction of BTS Towers',
    description:
      'End-to-end BTS tower construction covering infrastructure preparation, tower erection, mechanical, and electrical installation.',
    image: '/images/herotelcom/herotelcom2.jpg',
    alt: 'Construction of BTS Towers - Steel Lattice Tower Erection',
    highlights: [
      'Site preparation & foundation civil works',
      'Tower structure erection & fabrication',
      'Mechanical & electrical engineering installation',
      'Lightning protection & grounding systems',
    ],
  },
  {
    id: 'service-02',
    number: '02',
    title: 'Co-location',
    description:
      'Supporting multiple operators and equipment through efficient co-location solutions on existing telecommunications infrastructure.',
    image: '/images/herotelcom/herotelcom3.jpg',
    alt: 'Co-location Services - Multi-Operator Equipment Deployment',
    highlights: [
      'Tower load analysis & space allocation',
      'Multi-tenant antenna bracket installation',
      'Power sharing & backup power integration',
      'Shelter & transmission equipment hosting',
    ],
  },
  {
    id: 'service-03',
    number: '03',
    title: 'Site Acquisition (SITAC)',
    description:
      'Supporting site acquisition and preparation to establish suitable locations for telecommunications infrastructure deployment.',
    image: '/images/herotelcom/herotelcom4.jpg',
    alt: 'Site Acquisition SITAC - Survey & Permit Field Engineering',
    highlights: [
      'Candidate site survey & technical evaluation',
      'Landowner negotiation & legal lease clearance',
      'Community approval & environmental permits',
      'Government authority licensing & IMB processing',
    ],
  },
  {
    id: 'service-04',
    number: '04',
    title: 'Maintenance & Repair',
    description:
      'Reliable maintenance and repair services to help ensure telecommunications infrastructure remains operational and dependable.',
    image: '/images/herotelcom/herotelcom5.jpg',
    alt: 'Maintenance & Repair - Field Line and Tower Servicing',
    highlights: [
      'Preventive routine inspection & structural testing',
      'Corrective repair & 24/7 emergency response',
      'Aviation obstruction light & generator maintenance',
      'Corrosion treatment & structural reinforcement',
    ],
  },
  {
    id: 'service-05',
    number: '05',
    title: 'Fiber Optic',
    description:
      'Fiber optic infrastructure deployment supporting high-speed and reliable telecommunications connectivity.',
    image: '/images/herotelcom/herotelcom7.jpg',
    alt: 'Fiber Optic Infrastructure Deployment',
    highlights: [
      'Aerial & underground fiber cable deployment',
      'Optical distribution frame (ODF) termination',
      'OTDR testing & optical link loss certification',
      'Last-mile connection to BTS & enterprise nodes',
    ],
  },
];

const statistics = [
  { value: 1204, suffix: '', label: 'NEW SITE', formatComma: true },
  { value: 1122, suffix: '', label: 'CO-LOCATION', formatComma: true },
  { value: 4015, suffix: '', label: 'SITAC', formatComma: true },
  { value: 8714, suffix: '', label: 'MAINTENANCE', formatComma: true },
  { value: 450, suffix: 'km', label: 'FIBER OPTIC', formatComma: false },
];

const clientLogosRow1 = [
  { name: 'Tower Bersama Group', src: '/images/client/logo-tower-bersama-group.png' },
  { name: 'Mitratel', src: '/images/client/Logo_Mitratel.png' },
  { name: 'Telkom Infra', src: '/images/client/logo-telkom-infra.jpg' },
  { name: 'Protelindo', src: '/images/client/logo-protelindo.jpg' },
  { name: 'MSN', src: '/images/client/logo-msn.png' },
];

const clientLogosRow2 = [
  { name: 'AXIS', src: '/images/client/axis.png' },
  { name: 'Bali Tower', src: '/images/client/balitower.png' },
  { name: 'Indosat', src: '/images/client/indosat.png' },
  { name: 'Telkomsel', src: '/images/client/telkomsel.png' },
  { name: 'XL Axiata', src: '/images/client/xl.png' },
];

const commitments = [
  {
    number: '01',
    title: 'Quality Is Our Priority',
    description: 'We dedicate ourselves to deliver the highest standard in Quality, Cost, and Delivery across every project.',
  },
  {
    number: '02',
    title: 'We Connect Everyone',
    description: 'With uncompromised engineering quality, we contribute directly to expanding connectivity across Indonesia.',
  },
  {
    number: '03',
    title: 'Our Focus Is Technology',
    description: 'Leveraging best-in-class technology, safety standards, and modern deployment methods to deliver superior services.',
  },
  {
    number: '04',
    title: 'We Care About Our Earth',
    description: 'Committed to responsible construction, environmental safety, and energy-efficient infrastructure solutions.',
  },
];
---

<MainLayout title="Telecommunication & Infrastructure Contractor | PT Prasetia Dwidharma" transparentNavbar={true}>

  <!-- ========================================================
       1. HERO SECTION — headline muncul bertahap (word stagger)
  ======================================================== -->
  <section class="hero-section relative min-h-[88vh] lg:min-h-screen flex items-center text-white overflow-hidden bg-slate-950">
    <div class="absolute inset-0">
      <img
        src="/images/herotelcom/herotelcom1.jpg"
        alt="Telecommunication Tower Infrastructure"
        class="hero-bg-img w-full h-full object-cover object-center"
        loading="eager"
      />
<div class="absolute inset-0 bg-gradient-to-r from-slate-950/50 via-slate-950/30 to-transparent"></div>

<div class="absolute inset-0 bg-gradient-to-t from-slate-950/50 via-transparent to-slate-950/10"></div>
    </div>

    <div class="container mx-auto px-5 sm:px-6 lg:px-12 max-w-7xl relative z-10 pt-24 lg:pt-28 pb-14 lg:pb-20">
      <div class="max-w-2xl">
        <h1 class="hero-title text-hero-title mb-4 sm:mb-5 text-white">
          <span class="hero-word" style="animation-delay:0.05s">Telecommunication</span><br>
          <span class="hero-word" style="animation-delay:0.15s">&amp; Infrastructure</span><br>
          <span class="hero-word text-red-500" style="animation-delay:0.35s">Contractor.</span>
        </h1>

        <p class="hero-fade text-body-lead text-slate-200/90 max-w-xl mb-8" style="animation-delay:0.5s">
          We provide end-to-end tower construction services, starting from planning, construction, mechanical, and electrical.
        </p>

        <div class="hero-fade inline-flex items-center gap-3 sm:gap-4 px-4 py-3 sm:px-5 sm:py-4 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 shadow-lg" style="animation-delay:0.65s">
          <div class="p-1.5 rounded-xl bg-white shrink-0">
            <img
              src="/images/herotelcom/iso.png"
              alt="ISO 9001 Certified Logo"
              class="h-9 sm:h-11 w-auto object-contain"
              loading="eager"
            />
          </div>
          <div class="text-left">
            <p class="text-sm sm:text-base font-semibold text-white leading-snug">
              ISO 9001 Quality Management Certified
            </p>
            <p class="text-[11px] sm:text-xs text-slate-300">
              Audited by Lloyd's Register Quality Assurance
            </p>
          </div>
        </div>
      </div>
    </div>


  </section>

  <!-- ========================================================
       2. INTRO + METRICS
  ======================================================== -->
  <section id="metrics" class="relative py-16 sm:py-20 lg:py-28 bg-slate-950 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/herotelcom/herotelcom6.jpg" alt="" class="w-full h-full object-cover object-center" loading="lazy" />
      <div class="absolute inset-0 bg-slate-950/50"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950/10 via-slate-950/30 to-slate-950/50"></div>
          </div>
    <div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(circle, #ffffff 1px, transparent 1px); background-size: 32px 32px;"></div>

    <div class="container mx-auto px-5 sm:px-6 lg:px-12 max-w-7xl relative z-10">
      <div class="max-w-2xl mb-10 sm:mb-14 lg:mb-16">
        <div class="reveal-fade flex items-center gap-3 mb-3">
          <span class="w-7 h-0.5 bg-red-500 rounded-full"></span>
          <span class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.2em] text-red-500">
            TELECOMMUNICATION INFRASTRUCTURE
          </span>
        </div>
        <h2 class="reveal-fade text-section-title text-white mb-4">
          Building the infrastructure behind connectivity.
        </h2>
        <p class="reveal-fade text-body-lead text-slate-200">
          We provide integrated telecommunication infrastructure services, from site acquisition and tower construction to maintenance, co-location, and fiber optic deployment.
        </p>
      </div>

      <div class="reveal-fade bg-white/10 backdrop-blur-xl rounded-3xl border border-white/20 p-6 sm:p-8 lg:p-12 shadow-2xl">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6 sm:gap-8 lg:gap-10 divide-y sm:divide-y-0 sm:divide-x divide-white/15">
          {statistics.map((stat, idx) => (
            <div class={`stat-item flex flex-col justify-center text-center ${idx > 0 ? 'pt-5 sm:pt-0 sm:pl-6 lg:pl-8' : ''}`} style={`transition-delay:${idx * 70}ms`}>
              <div class="flex items-baseline justify-center">
                <span
                  class="text-[clamp(1.5rem,3.2vw,2.5rem)] font-bold text-white tracking-tight"
                  data-counter={stat.value}
                  data-format-comma={stat.formatComma ? 'true' : 'false'}
                >
                  0
                </span>
                {stat.suffix && (
                  <span class="text-base text-body-lead font-semibold text-red-400 ml-1">{stat.suffix}</span>
                )}
              </div>
              <span class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-slate-200 mt-1.5 block">
                {stat.label}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================
       3. OUR TELECOMMUNICATION SERVICES
  ======================================================== -->
  <section id="services" class="py-16 sm:py-20 lg:py-28 bg-white relative">
    <div class="container mx-auto px-5 sm:px-6 lg:px-12 max-w-7xl">
      <div class="max-w-2xl mb-10 sm:mb-14 lg:mb-16">
        <div class="reveal-fade flex items-center gap-3 mb-3">
          <span class="w-7 h-0.5 bg-red-600 rounded-full"></span>
          <span class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.2em] text-red-600">OUR CAPABILITIES</span>
        </div>
        <h2 class="reveal-fade text-section-title text-slate-900 mb-4">
          Our Telecommunication Services
        </h2>
        <p class="reveal-fade text-body-lead text-slate-600">
          End-to-end infrastructure solutions built to connect, maintain, and expand reliable telecommunications networks.
        </p>
      </div>

      <!-- DESKTOP: sticky storytelling -->
      <div class="hidden lg:grid lg:grid-cols-12 gap-12 xl:gap-16 items-start relative">
        <div class="lg:col-span-6 sticky top-24 pt-2">
          <div class="relative w-full aspect-[4/3] rounded-3xl overflow-hidden bg-slate-950 shadow-2xl border border-slate-200">
            {services.map((svc, index) => (
              <div
                id={`stage-image-${index}`}
                class={`stage-image absolute inset-0 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] ${index === 0 ? 'opacity-100 scale-100 z-10' : 'opacity-0 scale-95 z-0'}`}
              >
                <img src={svc.image} alt={svc.alt} class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"></div>
              </div>
            ))}
            <div class="absolute top-5 left-5 z-20">
              <span id="stage-active-badge" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-950/80 backdrop-blur-md border border-white/20 text-white font-sans text-[11px] font-semibold tracking-wider shadow-lg">
                <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
                01 / 05 · BTS TOWERS
              </span>
            </div>
            <div class="absolute bottom-5 left-5 right-5 z-20 flex items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                {services.map((svc, index) => (
                  <button
                    type="button"
                    class={`progress-dot h-1.5 rounded-full transition-all duration-300 ${index === 0 ? 'w-7 bg-red-600' : 'w-1.5 bg-white/40'}`}
                    data-step={index}
                    aria-label={`Jump to ${svc.title}`}
                  ></button>
                ))}
              </div>
              <span id="stage-active-name" class="text-[11px] font-medium text-white/90 drop-shadow truncate max-w-[200px]">
                Construction of BTS Towers
              </span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 space-y-24 xl:space-y-32 pb-16">
          {services.map((svc, index) => (
            <div
              id={svc.id}
              class="service-scroll-target reveal-fade scroll-mt-32 p-7 xl:p-9 rounded-3xl bg-[#F8FAFC] border border-slate-200/80 hover:border-slate-300 hover:-translate-y-1 transition-all duration-300"
              data-index={index}
              style={`transition-delay:${(index % 3) * 80}ms`}
            >
              <div class="flex items-center justify-between mb-3.5">
                <span class="font-sans text-xs font-bold text-red-600 tracking-wider">CAPABILITY {svc.number}</span>
                <span class="text-[10px] font-semibold uppercase tracking-widest text-slate-400">PT Prasetia Dwidharma</span>
              </div>
              <h3 class="text-body-lead font-bold text-slate-900 tracking-tight mb-3">{svc.title}</h3>
              <p class="text-sm xl:text-base text-slate-600 leading-relaxed mb-6">{svc.description}</p>
              <div class="pt-5 border-t border-slate-200/80">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 block mb-3">Key Scope of Execution</span>
                <ul class="space-y-2.5">
                  {svc.highlights.map((hl) => (
                    <li class="flex items-start gap-2.5 text-[15px] sm:text-[15.5px] text-slate-700">
                      <span class="w-1.5 h-1.5 rounded-full bg-red-600 mt-1.5 shrink-0"></span>
                      <span>{hl}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- MOBILE / TABLET: sekarang tiap kartu punya reveal + stagger, jadi ada "pengalaman scroll" -->
      <div class="lg:hidden space-y-7 sm:space-y-9">
        {services.map((svc, index) => (
          <div
            class="reveal-fade bg-[#F8FAFC] rounded-3xl border border-slate-200/80 overflow-hidden shadow-sm active:scale-[0.99] transition-transform"
            style={`transition-delay:${(index % 3) * 90}ms`}
          >
            <div class="relative w-full h-48 sm:h-64 overflow-hidden bg-slate-900">
              <img src={svc.image} alt={svc.alt} class="w-full h-full object-cover" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
              <span class="absolute top-3.5 left-3.5 px-2.5 py-1 rounded-full bg-slate-950/80 backdrop-blur-md border border-white/20 text-white font-sans text-[11px] font-bold">
                {svc.number}
              </span>
            </div>
            <div class="p-5 sm:p-7">
              <span class="text-[10px] font-bold uppercase tracking-widest text-red-600 font-sans block mb-2">SERVICE {svc.number}</span>
              <h3 class="text-body-lead font-bold text-slate-900 mb-2.5">{svc.title}</h3>
              <p class="text-[15px] sm:text-[15.5px] text-slate-600 leading-relaxed mb-5">{svc.description}</p>
              <div class="pt-4 border-t border-slate-200">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 block mb-2.5">Key Scope</span>
                <ul class="space-y-2">
                  {svc.highlights.map((hl) => (
                    <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-700">
                      <span class="w-1.5 h-1.5 rounded-full bg-red-600 mt-1.5 shrink-0"></span>
                      <span>{hl}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       4. CLIENTS & PARTNERS — marquee dipercepat khusus mobile
  ======================================================== -->
  <section class="py-14 sm:py-16 lg:py-24 bg-white border-y border-slate-200/70 overflow-hidden">
    <div class="reveal-fade container mx-auto px-5 sm:px-6 lg:px-12 max-w-7xl mb-9 sm:mb-12 text-center">
      <div class="inline-flex items-center gap-2 mb-2.5">
        <span class="w-2 h-2 rounded-full bg-red-600"></span>
      </div>
      <h2 class="text-body-lead text-section-title font-bold text-slate-900 tracking-tight">Our Clients &amp; Partners</h2>
      <p class="text-[15px] sm:text-[15.5px] lg:text-base text-slate-600 max-w-xl mx-auto mt-2 leading-relaxed">
        Powering Indonesia's telecommunications ecosystem alongside leading network operators and infrastructure providers.
      </p>
    </div>

    <div class="marquee-wrapper relative w-full overflow-hidden py-4">
      <div class="marquee-track flex items-center">
        {clientLogosRow1.map((item) => (
          <div class="marquee-item flex items-center justify-center px-7 sm:px-14 shrink-0">
            <img src={item.src} alt={item.name} class="h-11 sm:h-16 lg:h-20 max-w-[140px] sm:max-w-[190px] object-contain transition-transform duration-300 hover:scale-110" loading="lazy" />
          </div>
        ))}
        {clientLogosRow1.map((item) => (
          <div class="marquee-item flex items-center justify-center px-7 sm:px-14 shrink-0" aria-hidden="true">
            <img src={item.src} alt={item.name} class="h-11 sm:h-16 lg:h-20 max-w-[140px] sm:max-w-[190px] object-contain transition-transform duration-300 hover:scale-110" loading="lazy" />
          </div>
        ))}
      </div>
    </div>

    <div class="marquee-wrapper relative w-full overflow-hidden py-4 mt-2">
      <div class="marquee-track marquee-track-reverse flex items-center">
        {clientLogosRow2.map((item) => (
          <div class="marquee-item flex items-center justify-center px-7 sm:px-14 shrink-0">
            <img src={item.src} alt={item.name} class="h-11 sm:h-16 lg:h-20 max-w-[140px] sm:max-w-[190px] object-contain transition-transform duration-300 hover:scale-110" loading="lazy" />
          </div>
        ))}
        {clientLogosRow2.map((item) => (
          <div class="marquee-item flex items-center justify-center px-7 sm:px-14 shrink-0" aria-hidden="true">
            <img src={item.src} alt={item.name} class="h-11 sm:h-16 lg:h-20 max-w-[140px] sm:max-w-[190px] object-contain transition-transform duration-300 hover:scale-110" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       5. CORPORATE COMMITMENT
  ======================================================== -->
  <section class="py-16 sm:py-20 lg:py-28 bg-gradient-to-br from-red-700 via-red-600 to-red-800 text-white relative overflow-hidden">
    <div class="absolute -top-32 -right-24 w-[28rem] h-[28rem] bg-red-500/40 rounded-full blur-3xl opacity-70 pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-24 w-[26rem] h-[26rem] bg-red-900/40 rounded-full blur-3xl opacity-80 pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.06] pointer-events-none" style="background-image: radial-gradient(circle, #ffffff 1px, transparent 1px); background-size: 30px 30px;"></div>

    <div class="container mx-auto px-5 sm:px-6 lg:px-12 max-w-7xl relative z-10">
      <div class="reveal-fade max-w-2xl mb-10 sm:mb-14 lg:mb-16">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-7 h-0.5 bg-white rounded-full"></span>
          <span class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.2em] text-white/90">CORPORATE COMMITMENT</span>
        </div>
        <h2 class="text-section-title text-white mb-4">PT Prasetia Dwidharma</h2>
        <p class="text-body-lead text-red-50">
          We provide tower construction services, starting from planning, construction, mechanical, and electrical guided by four core commitments.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-12 items-stretch">
        <div class="reveal-fade lg:col-span-5 relative rounded-3xl overflow-hidden min-h-[300px] sm:min-h-[360px] lg:min-h-full border border-white/20 shadow-2xl flex flex-col justify-end p-6 sm:p-8 lg:p-10 group">
          <img
            src="/images/herotelcom/herotelcom6.jpg"
            alt="Field Linemen Teamwork on Tower Crossarm"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-red-950 via-red-950/60 to-transparent"></div>
          <div class="relative z-10">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white text-red-700 font-sans text-[10px] font-bold uppercase tracking-wider mb-3 shadow-sm">Values in Action</span>
            <blockquote class="text-base text-body-lead font-semibold text-white leading-snug">
              "We believe telecommunication is more than steel and signals, it is about connecting people and communities across the nation."
            </blockquote>
          </div>
        </div>

        <div class="lg:col-span-7 flex flex-col justify-between gap-3.5">
          {commitments.map((item, idx) => (
            <div
              class="reveal-fade group relative p-5 sm:p-7 rounded-2xl bg-white/10 hover:bg-white/20 border border-white/20 hover:border-white/40 backdrop-blur-sm transition-all duration-300"
              style={`transition-delay:${idx * 90}ms`}
            >
              <div class="flex items-start gap-5">
                <span class="font-sans text-body-lead font-black text-white shrink-0">{item.number}</span>
                <div>
                  <h3 class="text-base text-body-lead font-bold text-white mb-1.5 transition-colors">{item.title}</h3>
                  <p class="text-[15px] sm:text-[15.5px] text-red-50 leading-relaxed font-light">{item.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================
       STYLES
  ======================================================== -->
  <style>
    html { scroll-behavior: smooth; }

    /* Hero entrance */
    .hero-bg-img {
      animation: heroZoom 6s ease-out forwards;
    }
    @keyframes heroZoom {
      0% { transform: scale(1.08); opacity: 0.6; }
      100% { transform: scale(1); opacity: 1; }
    }
    .hero-word {
      display: inline-block;
      opacity: 0;
      transform: translateY(18px);
      animation: wordUp 0.6s cubic-bezier(0.16,1,0.3,1) forwards;
    }
    .hero-fade {
      opacity: 0;
      transform: translateY(14px);
      animation: wordUp 0.6s cubic-bezier(0.16,1,0.3,1) forwards;
    }
    @keyframes wordUp {
      to { opacity: 1; transform: translateY(0); }
    }
    .scroll-cue { animation: fadeIn 1s ease 1.1s forwards; opacity: 0; }
    @keyframes fadeIn { to { opacity: 1; } }
    .scroll-cue-dot { animation: cueBounce 1.6s ease-in-out infinite; }
    @keyframes cueBounce {
      0%, 100% { transform: translateY(0); opacity: 0.7; }
      50% { transform: translateY(8px); opacity: 0.2; }
    }

    /* Marquee */
    .marquee-wrapper::before,
    .marquee-wrapper::after {
      content: '';
      position: absolute;
      top: 0; bottom: 0;
      width: 60px;
      z-index: 2;
      pointer-events: none;
    }
    .marquee-wrapper::before { left: 0; background: linear-gradient(to right, #fff, transparent); }
    .marquee-wrapper::after { right: 0; background: linear-gradient(to left, #fff, transparent); }

    .marquee-track {
      width: max-content;
      animation: marqueeScroll 36s linear infinite;
    }
    .marquee-track:hover { animation-play-state: paused; }
    .marquee-track-reverse {
      animation-name: marqueeScroll;
      animation-duration: 32s;
      animation-direction: reverse;
    }
    @keyframes marqueeScroll {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* Mobile: marquee dipercepat + kena scroll aktif dipause biar gak "berat" saat scroll */
    @media (max-width: 767px) {
      .marquee-wrapper::before,
      .marquee-wrapper::after { width: 36px; }
      .marquee-track { animation-duration: 14s; }
      .marquee-track-reverse { animation-duration: 12s; }
    }

    /* Scroll reveal (dipakai di semua section) */
    .reveal-fade {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal-fade.is-revealed { opacity: 1; transform: translateY(0); }

    .stat-item {
      opacity: 0;
      transform: translateY(14px) scale(0.96);
      transition: opacity 0.5s cubic-bezier(0.16,1,0.3,1), transform 0.5s cubic-bezier(0.16,1,0.3,1);
    }
    .stat-item.is-revealed { opacity: 1; transform: translateY(0) scale(1); }

    @media (prefers-reduced-motion: reduce) {
      .marquee-track, .marquee-track-reverse { animation: none; }
      .reveal-fade, .stat-item, .hero-word, .hero-fade, .hero-bg-img, .scroll-cue, .scroll-cue-dot {
        opacity: 1 !important;
        transform: none !important;
        animation: none !important;
        transition: none !important;
      }
    }
  </style>

  <!-- ========================================================
       VANILLA JAVASCRIPT
  ======================================================== -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      initScrollReveal();
      initCounterAnimation();
      initStickyServiceStorytelling();
      initMarqueePauseOnScroll();
    });

    function initScrollReveal() {
      const revealElements = document.querySelectorAll('.reveal-fade');
      if (!revealElements.length) return;

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReduced) {
        revealElements.forEach((el) => el.classList.add('is-revealed'));
        return;
      }

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );

      revealElements.forEach((el) => observer.observe(el));
    }

    function initCounterAnimation() {
      const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
      if (!counters.length) return;

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              const statItem = el.closest('.stat-item');
              if (statItem) statItem.classList.add('is-revealed');
              obs.unobserve(el);

              const target = parseInt(el.getAttribute('data-counter') || '0', 10);
              const formatComma = el.getAttribute('data-format-comma') === 'true';

              if (prefersReduced) {
                el.textContent = formatComma ? target.toLocaleString('en-US') : target.toString();
                return;
              }

              const duration = 1600;
              const startTime = performance.now();

              function animate(currentTime: number) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const ease = 1 - Math.pow(1 - progress, 3);
                const current = Math.round(target * ease);

                el.textContent = formatComma ? current.toLocaleString('en-US') : current.toString();

                if (progress < 1) {
                  requestAnimationFrame(animate);
                } else {
                  el.textContent = formatComma ? target.toLocaleString('en-US') : target.toString();
                }
              }

              requestAnimationFrame(animate);
            }
          });
        },
        { threshold: 0.25 }
      );

      counters.forEach((el) => observer.observe(el));
    }

    function initStickyServiceStorytelling() {
      const targets = document.querySelectorAll<HTMLElement>('.service-scroll-target');
      const stageImages = document.querySelectorAll<HTMLElement>('.stage-image');
      const activeBadge = document.getElementById('stage-active-badge');
      const activeName = document.getElementById('stage-active-name');
      const progressDots = document.querySelectorAll<HTMLElement>('.progress-dot');

      if (!targets.length || !stageImages.length) return;

      const badgeTitles = [
        '01 / 05 · BTS TOWERS',
        '02 / 05 · CO-LOCATION',
        '03 / 05 · SITAC',
        '04 / 05 · MAINTENANCE',
        '05 / 05 · FIBER OPTIC',
      ];
      const fullTitles = [
        'Construction of BTS Towers',
        'Co-location',
        'Site Acquisition (SITAC)',
        'Maintenance & Repair',
        'Fiber Optic',
      ];

      function setActiveStep(index: number) {
        stageImages.forEach((img, i) => {
          if (i === index) {
            img.classList.remove('opacity-0', 'scale-95', 'z-0');
            img.classList.add('opacity-100', 'scale-100', 'z-10');
          } else {
            img.classList.remove('opacity-100', 'scale-100', 'z-10');
            img.classList.add('opacity-0', 'scale-95', 'z-0');
          }
        });

        if (activeBadge && badgeTitles[index]) {
          activeBadge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>${badgeTitles[index]}`;
        }
        if (activeName && fullTitles[index]) {
          activeName.textContent = fullTitles[index];
        }

        progressDots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.remove('w-1.5', 'bg-white/40');
            dot.classList.add('w-7', 'bg-red-600');
          } else {
            dot.classList.remove('w-7', 'bg-red-600');
            dot.classList.add('w-1.5', 'bg-white/40');
          }
        });
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const idx = parseInt(entry.target.getAttribute('data-index') || '0', 10);
              setActiveStep(idx);
            }
          });
        },
        { rootMargin: '-30% 0px -50% 0px', threshold: 0 }
      );

      targets.forEach((target) => observer.observe(target));

      progressDots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const stepIndex = parseInt(dot.getAttribute('data-step') || '0', 10);
          const target = targets[stepIndex];
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      });
    }

    // Pause marquee saat user aktif scroll di mobile, biar terasa lebih ringan & tidak "berat"
    function initMarqueePauseOnScroll() {
      const isMobile = window.matchMedia('(max-width: 767px)').matches;
      if (!isMobile) return;

      const tracks = document.querySelectorAll<HTMLElement>('.marquee-track');
      if (!tracks.length) return;

      let scrollTimeout: ReturnType<typeof setTimeout>;
      window.addEventListener('scroll', () => {
        tracks.forEach((t) => (t.style.animationPlayState = 'paused'));
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          tracks.forEach((t) => (t.style.animationPlayState = 'running'));
        }, 250);
      }, { passive: true });
    }
  </script>

</MainLayout>
