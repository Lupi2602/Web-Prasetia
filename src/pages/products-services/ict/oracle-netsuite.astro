---
import MainLayout from '../../../layouts/MainLayout.astro';

const CONTACT_PAGE   = '/about/contact/';
const CONTACT_PHONE  = '(021) 3524999';
const CONTACT_ADDRESS = 'Graha Aruna, Jl. Antara No.47, Jakarta Pusat';
const DEMO_URL       = 'https://www.virtuenet.id/netsuite';

const modules = [
  { label: 'Finance & Accounting' },
  { label: 'Human Resources' },
  { label: 'Inventory Management' },
  { label: 'CRM' },
  { label: 'Sales & Marketing' },
  { label: 'Reporting & Analytics' },
  { label: 'Production' },
  { label: 'Planning' },
];

const challenges = [
  {
    num: '01',
    title: 'Data Terpisah di Mana-mana',
    body: 'Tim keuangan, operasional, dan sales masing-masing memegang data sendiri. Akibatnya, rekonsiliasi manual jadi rutinitas yang menyita waktu setiap bulannya.',
  },
  {
    num: '02',
    title: 'Laporan Keuangan Butuh Waktu Lama',
    body: 'Proses tutup buku bisa memakan berminggu-minggu. Saat laporan selesai, datanya sudah usang dan tidak bisa lagi mendukung keputusan bisnis yang tepat waktu.',
  },
  {
    num: '03',
    title: 'Sistem Lama Tidak Bisa Scale',
    body: 'Begitu bisnis berkembang, sistem konvensional mulai kewalahan. Setiap ekspansi cabang atau lini produk baru membawa kompleksitas dan biaya yang kian bertambah.',
  },
];

const capabilities = [
  {
    path: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    title: 'Financial Management',
    desc: 'Kelola general ledger, accounts payable/receivable, budgeting, sampai financial reporting dalam satu sistem terintegrasi. Tutup buku lebih cepat, laporan lebih akurat.',
  },
  {
    path: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
    title: 'Supply Chain & Inventory',
    desc: 'Pantau stok secara real-time, atur demand forecasting, dan pastikan ketersediaan barang di semua lokasi gudang tanpa risiko overstock atau kekurangan stok.',
  },
  {
    path: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
    title: 'CRM & Sales',
    desc: 'Dapatkan pandangan 360 derajat terhadap setiap pelanggan. Data penjualan, marketing, dan layanan pelanggan terhubung langsung ke keuangan dan operasional.',
  },
  {
    path: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01',
    title: 'Order Management',
    desc: 'Kelola siklus lengkap dari purchase order, sales order, pengadaan, fulfillment, hingga retur, semua terpantau di setiap tahap dalam satu platform.',
  },
  {
    path: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
    title: 'Project Management',
    desc: 'Rencanakan resource, catat waktu pengerjaan, dan ukur progress proyek secara akurat. Bantu tim bekerja lebih efisien dengan data yang selalu tersinkron.',
  },
  {
    path: 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z',
    title: 'E-Commerce Integration',
    desc: 'Sistem back-end NetSuite terhubung langsung ke platform e-commerce. Data pelanggan, pesanan, dan stok selalu konsisten di semua saluran penjualan.',
  },
];

const values = [
  {
    label: 'Financial Management',
    title: 'Visibilitas Keuangan Real-Time',
    body1: 'Ketika semua data keuangan tersimpan di satu sistem, tim finance tidak lagi perlu mengumpulkan data dari berbagai spreadsheet atau aplikasi terpisah. Posisi keuangan perusahaan bisa dilihat kapan saja, dengan data yang selalu mutakhir.',
    body2: 'Proses tutup buku bulanan menjadi jauh lebih singkat karena data transaksi sudah tersusun otomatis. Manajemen bisa akses laporan konsolidasi tanpa perlu menunggu siklus rekonsiliasi manual.',
    accent: 'teal',
  },
  {
    label: 'Otomatisasi',
    title: 'Kurangi Pekerjaan Manual',
    body1: 'Banyak tugas administratif yang berulang di bagian keuangan, operasional, dan sales, mulai dari entri data, persetujuan dokumen, sampai rekonsiliasi, bisa berjalan otomatis di dalam NetSuite.',
    body2: 'Dengan proses yang terotomatisasi, risiko human error berkurang signifikan. Tim Anda bisa fokus pada hal-hal yang benar-benar membutuhkan analisis dan keputusan strategis.',
    accent: 'blue',
  },
  {
    label: 'Visibilitas Bisnis',
    title: 'Kendali Penuh 360 Derajat',
    body1: 'Karena semua fungsi bisnis terhubung di satu platform, manajemen bisa memantau performa keseluruhan perusahaan, dari keuangan, operasional, hingga penjualan, lewat satu dashboard terpadu.',
    body2: 'Visibilitas yang menyeluruh ini membantu pengambilan keputusan jadi lebih percaya diri, terutama saat skala bisnis terus berkembang dan kompleksitasnya meningkat.',
    accent: 'teal',
  },
  {
    label: 'Cloud ERP',
    title: 'Akses dari Mana Saja, Kapan Saja',
    body1: 'NetSuite berbasis cloud murni, artinya tim Anda bisa akses data dan menjalankan operasional dari luar kantor sekalipun, dari perangkat apa pun. Cocok untuk perusahaan dengan banyak cabang atau tim yang bekerja secara fleksibel.',
    body2: 'Tidak perlu lagi investasi besar untuk server on-premise. Pembaruan sistem dan keamanan dikelola otomatis, sehingga beban tim IT jauh lebih ringan.',
    accent: 'blue',
  },
];

const whyItems = [
  {
    num: '01',
    title: 'Satu Platform untuk Semua Divisi',
    body: 'Tidak perlu lagi mengelola banyak aplikasi terpisah. NetSuite menyatukan keuangan, stok, pelanggan, dan operasional dalam satu sistem. Semua divisi bekerja dari satu sumber data yang sama.',
    delay: 0,
  },
  {
    num: '02',
    title: 'Data Real-Time di Seluruh Bisnis',
    body: 'Manajemen dan tim operasional bisa pantau performa bisnis dari satu dashboard yang selalu diperbarui secara langsung. Keputusan jadi lebih cepat dan lebih berdasarkan fakta.',
    delay: 80,
  },
  {
    num: '03',
    title: 'Proses Otomatis, Lebih Sedikit Kesalahan',
    body: 'Alur kerja mulai dari persetujuan transaksi, pelaporan, hingga pengadaan stok bisa berjalan otomatis. Rutinitas manual yang membuang waktu berkurang, dan risiko salah input ikut turun.',
    delay: 160,
  },
  {
    num: '04',
    title: 'Tumbuh Bersama Bisnis Anda',
    body: 'NetSuite dirancang untuk mendukung pertumbuhan jangka panjang. Buka cabang baru, tambah entitas bisnis, atau ekspansi ke pasar internasional, sistemnya bisa menyesuaikan tanpa perlu ganti platform.',
    delay: 240,
  },
  {
    num: '05',
    title: 'Semua Data Sinkron dan Terpusat',
    body: 'Satu sumber data untuk seluruh tim memastikan informasi selalu konsisten dan terkini. Tidak ada lagi perbedaan angka antar divisi, dan risiko keputusan berdasarkan data yang salah pun hilang.',
    delay: 320,
  },
  {
    num: '06',
    title: 'Infrastruktur Lebih Efisien',
    body: 'Berbasis cloud, tidak ada investasi server on-premise yang mahal. Pembaruan sistem dan keamanan dikelola secara terpusat, sehingga tim IT bisa fokus pada hal yang lebih strategis.',
    delay: 400,
  },
];

const steps = [
  { step: '01', icon: '/images/heronetsuite/icon1.svg', title: 'Konsultasi Kebutuhan', body: 'Analisis mendalam terhadap proses bisnis, kebutuhan, dan tantangan operasional perusahaan sebelum konfigurasi dimulai.' },
  { step: '02', icon: '/images/heronetsuite/icon2.svg', title: 'Perancangan Sistem', body: 'Desain modul, alur kerja, dan struktur data yang disesuaikan dengan cara kerja bisnis Anda.' },
  { step: '03', icon: '/images/heronetsuite/icon3.svg', title: 'Konfigurasi & Pengembangan', body: 'Konfigurasi sistem, migrasi data dari sistem lama, dan integrasi dengan aplikasi yang sudah berjalan.' },
  { step: '04', icon: '/images/heronetsuite/icon4.svg', title: 'Testing Menyeluruh', body: 'Pemeriksaan dan pengujian sistem secara ketat untuk memastikan semua alur berjalan lancar sebelum go-live.' },
  { step: '05', icon: '/images/heronetsuite/icon5.svg', title: 'Go-Live', body: 'Peluncuran resmi dengan pendampingan intensif agar transisi berjalan mulus dan stabil di semua divisi.' },
  { step: '06', icon: '/images/heronetsuite/icon6.svg', title: 'Support Berkelanjutan', body: 'Layanan dukungan teknis dan konsultasi berkala untuk memastikan sistem terus optimal seiring perkembangan bisnis.' },
];

const aiItems = [
  { title: 'Invoice Capture', body: 'Faktur dipindai dan diinput otomatis menggunakan teknologi OCR berbasis AI, tanpa perlu entri manual.' },
  { title: 'Anomaly Detection', body: 'AI memantau data keuangan secara real-time dan mendeteksi ketidakwajaran transaksi sebelum menjadi masalah.' },
  { title: 'Narasi Laporan Otomatis', body: 'Ringkasan dan narasi laporan keuangan dibuat otomatis langsung dari data transaksi di dalam sistem.' },
  { title: 'Predictive Planning', body: 'AI mengidentifikasi pola dan tren dari data historis untuk mendukung perencanaan yang lebih akurat.' },
  { title: 'Forecast Explanations', body: 'Pahami faktor-faktor yang memengaruhi angka proyeksi AI, sehingga tim keuangan lebih percaya pada hasilnya.' },
  { title: 'Intelligent Recommendations', body: 'Rekomendasi produk personal berdasarkan riwayat pembelian untuk mendukung peningkatan nilai transaksi.' },
];
---

<MainLayout title="Oracle NetSuite | PT Prasetia Dwidharma" transparentNavbar={true}>

<!-- =================================================================
     HERO
================================================================= -->
<section class="hero-section ns-hero relative isolate overflow-hidden min-h-[90vh] flex items-center text-white">
  <div class="absolute inset-0" aria-hidden="true">
    <img src="/images/heronetsuite/nethero2.jpg" alt=""
      class="h-full w-full object-cover object-center" loading="eager" decoding="async" />
    <div class="absolute inset-0 bg-black/30"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#1a3a5c]/92 via-[#1e4d6b]/80 to-[#2d6a8f]/50"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#1a3a5c]/50 via-transparent to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-[#f8fafc]"></div>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-6 py-36 lg:px-12 lg:pt-52 lg:pb-52">
    <div class="max-w-2xl" data-reveal>
      <div class="mb-6 flex items-center gap-3">
        <img src="/images/heronetsuite/netsuitelogo.png" alt="Oracle NetSuite"
          class="h-8 brightness-0 invert opacity-90" />
      </div>
      <span class="ns-badge-hero mb-6 inline-block">Cloud ERP Terintegrasi</span>
      <h1 class="font-display text-[clamp(2rem,4.5vw,3.4rem)] font-extrabold leading-[1.1] tracking-tight">
        Satu Platform.<br />
        <span class="ns-gold-text">Semua Proses Terhubung.</span>
      </h1>
      <p class="mt-5 text-[1rem] leading-relaxed text-white/85 max-w-xl" data-reveal data-delay="100">
        Oracle NetSuite adalah sistem ERP berbasis cloud yang menyatukan keuangan, inventaris,
        CRM, dan operasional bisnis Anda dalam satu platform terintegrasi yang bisa diakses dari mana saja.
      </p>
      <div class="mt-8 flex flex-wrap gap-3" data-reveal data-delay="200">
        <a href={CONTACT_PAGE} class="ns-btn-primary">Konsultasi Gratis</a>
        <a href={DEMO_URL} target="_blank" rel="noopener noreferrer" class="ns-btn-outline-hero">Request Demo</a>
      </div>
    </div>
  </div>
</section>


<!-- =================================================================
     MODULE TICKER (seamless loop)
================================================================= -->
<section class="ns-ticker-section overflow-hidden py-4">
  <div class="ns-ticker-track flex gap-10 items-center">
    {[...modules, ...modules, ...modules].map((m) => (
      <span class="ns-ticker-item flex-shrink-0 flex items-center gap-2 text-sm font-semibold text-[#2d6a8f]">
        <span class="h-1.5 w-1.5 rounded-full bg-[#c9a227] inline-block flex-shrink-0"></span>
        {m.label}
      </span>
    ))}
  </div>
</section>


<!-- =================================================================
     APA ITU NETSUITE
================================================================= -->
<section id="what-is-netsuite" class="bg-[#f8fafc] py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-12">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">

      <div data-reveal>
        <span class="ns-eyebrow mb-4 block">Apa itu Oracle NetSuite</span>
        <h2 class="ns-h2 mb-5">Cloud ERP yang Dirancang untuk Menyatukan Bisnis Anda</h2>
        <div class="space-y-4 text-[15px] leading-relaxed text-slate-600">
          <p>
            Oracle NetSuite adalah sistem Enterprise Resource Planning (ERP) berbasis cloud
            yang membantu perusahaan mengelola fungsi inti bisnis seperti keuangan, inventaris,
            CRM, dan operasional dalam satu platform terhubung.
          </p>
          <p>
            Karena berjalan di cloud, tidak ada software yang perlu diinstal dan tidak ada
            infrastruktur server on-premise yang perlu dirawat. Tim Anda bisa akses data dari
            perangkat apa pun, di mana pun, kapan pun.
          </p>
          <p>
            NetSuite bersifat modular. Perusahaan bisa mulai dari kapabilitas yang paling
            dibutuhkan sekarang, lalu tambahkan modul baru seiring pertumbuhan bisnis tanpa
            perlu ganti atau migrasi ke sistem lain.
          </p>
        </div>
        <div class="mt-8 grid grid-cols-2 gap-4">
          {[
            { val: '8+', label: 'Modul Terintegrasi' },
            { val: '100%', label: 'Berbasis Cloud' },
            { val: 'Real-Time', label: 'Update Data' },
            { val: 'Scalable', label: 'Siap Tumbuh Bersama Anda' },
          ].map(s => (
            <div class="ns-stat-card">
              <p class="text-xl font-extrabold text-[#1a3a5c]">{s.val}</p>
              <p class="text-xs text-slate-500 mt-0.5">{s.label}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="relative" data-reveal data-delay="120">
        <div class="absolute -inset-4 rounded-3xl bg-gradient-to-br from-[#2d6a8f]/10 to-[#c9a227]/10 -z-10"></div>
        <div class="overflow-hidden rounded-2xl shadow-xl">
          <img src="/images/heronetsuite/nethero1.jpg"
            alt="Oracle NetSuite modul terintegrasi: Finance, HR, CRM, Inventory, dan lainnya"
            class="w-full object-contain bg-white p-4" loading="lazy" decoding="async" />
        </div>
      </div>

    </div>
  </div>
</section>


<!-- =================================================================
     TANTANGAN BISNIS
================================================================= -->
<section class="ns-challenge-bg relative overflow-hidden py-20 lg:py-28">
  <div class="absolute inset-0" aria-hidden="true">
    <img src="/images/heronetsuite/nethero4.jpg" alt=""
      class="h-full w-full object-cover object-top" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-[#1a3a5c]/50"></div>
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="absolute inset-0" style="background: radial-gradient(circle at 80% 50%, rgba(201,162,39,0.08) 0%, transparent 60%);"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-12">
    <div class="mb-14 max-w-xl" data-reveal>
      <span class="ns-eyebrow-light mb-4 block">Tantangan yang Sering Terjadi</span>
      <h2 class="ns-h2 text-white">Ketika Bisnis Berkembang Lebih Cepat dari Sistemnya</h2>
      <p class="mt-4 text-[15px] text-white/80 leading-relaxed">
        Seiring bisnis tumbuh, celah dari proses yang terpisah dan manual semakin terasa
        mahal, baik dari sisi waktu, akurasi, maupun kemampuan mengambil keputusan.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
      {challenges.map((item, i) => (
        <div class="ns-challenge-card" data-reveal data-delay={String(i * 90)}>
          <span class="ns-challenge-num">{item.num}</span>
          <h3 class="text-base font-bold text-white mb-2">{item.title}</h3>
          <p class="text-[13.5px] leading-relaxed text-white/80">{item.body}</p>
        </div>
      ))}
    </div>

    <div class="mt-14 ns-bridge-box" data-reveal>
      <img src="/images/heronetsuite/nethero3.gif" alt="Cloud ERP Terintegrasi"
        class="h-14 w-14 object-contain flex-shrink-0" loading="lazy" />
      <p class="text-[15px] leading-relaxed text-[#1a3a5c] font-medium">
        Inilah tantangan nyata yang dirancang untuk dijawab oleh sistem ERP terpadu,
        menggantikan berbagai perangkat yang terpisah dengan satu sumber data tunggal yang selalu sinkron.
      </p>
    </div>
  </div>
</section>


<!-- =================================================================
     NETSUITE SEBAGAI SOLUSI
================================================================= -->
<section class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-12">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center">

      <div class="lg:col-span-5" data-reveal>
        <span class="ns-eyebrow mb-4 block">Solusi Terpadu</span>
        <h2 class="ns-h2 mb-5">Satukan Semua Bagian Bisnis dalam Satu Sistem</h2>
        <div class="space-y-4 text-[15px] leading-relaxed text-slate-600">
          <p>
            Oracle NetSuite mengonsolidasikan fungsi-fungsi kritis bisnis, mulai dari
            akuntansi, keuangan, inventaris, order management, CRM, dan lainnya ke
            dalam satu sistem terintegrasi.
          </p>
          <p>
            Setiap modul berbagi basis data yang sama, sehingga semua tim selalu
            mengacu pada gambaran bisnis yang konsisten. Perubahan di satu divisi
            langsung tercermin ke seluruh bagian sistem secara real-time.
          </p>
          <p>
            Hasilnya adalah visibilitas yang lebih jelas, proses manual yang berkurang,
            dan fondasi yang siap menopang pertumbuhan bisnis Anda ke depan.
          </p>
        </div>
      </div>

      <div class="lg:col-span-7" data-reveal data-delay="120">
        <div class="grid grid-cols-2 gap-4">
          {[
            { icon: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z', label: 'Akses Berbasis Cloud', body: 'Tidak perlu instalasi. Akses data bisnis dari browser apa pun, perangkat apa pun, dan dari mana saja.' },
            { icon: 'M13 10V3L4 14h7v7l9-11h-7z', label: 'Data Real-Time', body: 'Semua informasi diperbarui otomatis di setiap modul, memastikan tim selalu bekerja dengan data terkini.' },
            { icon: 'M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5', label: 'Modular & Terintegrasi', body: 'Mulai dari modul yang Anda butuhkan, lalu tambahkan kapabilitas baru seiring bisnis berkembang.' },
            { icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15', label: 'Otomatisasi Proses', body: 'Otomatiskan alur kerja keuangan, operasional, dan administrasi untuk meminimalkan pekerjaan manual.' },
            { icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z', label: 'Scalable', body: 'Dirancang fleksibel untuk berkembang dari satu entitas hingga multi-cabang atau global.' },
            { icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z', label: 'Keamanan Tinggi', body: 'Standar keamanan enterprise dengan disaster recovery dan uptime andal untuk seluruh perusahaan.' },
          ].map((item, i) => (
            <div class="ns-solution-card" data-reveal data-delay={String(i * 55)}>
              <div class="ns-solution-icon-wrap">
                <svg class="h-4 w-4 text-[#2d6a8f]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
              </div>
              <p class="text-[13px] font-bold text-[#1a3a5c] mb-1.5">{item.label}</p>
              <p class="text-[12px] leading-relaxed text-slate-500">{item.body}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>


<!-- =================================================================
     KAPABILITAS UTAMA
================================================================= -->
<section id="capabilities" class="ns-cap-section py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-12">

    <div class="mb-14 text-center max-w-2xl mx-auto" data-reveal>
      <span class="ns-eyebrow mb-4 block">Kapabilitas Utama</span>
