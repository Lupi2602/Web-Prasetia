<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');

  /* ================================================================
     DESIGN TOKENS
  ================================================================ */
  :root {
  --ns-navy:    #2F6590;
  --ns-teal:    #4895BC;
  --ns-teal-lt: #73B8D8;
  --ns-gold:    #E5C34A;
  --ns-gold-lt: #F7DD7A;
  --ns-bg:      #f8fafc;
}

  .font-display { font-family: 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif; }

  /* ================================================================
     TYPOGRAPHY HELPERS
  ================================================================ */
  .ns-h2 {
    font-family: 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.45rem, 2.5vw, 2.1rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ns-navy);
  }

  .ns-eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ns-teal);
  }
  .ns-eyebrow-light {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(201,162,39,0.85);
  }

  .ns-gold-text {
    background: linear-gradient(90deg, #c9a227, #e8c547);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ================================================================
     HERO
  ================================================================ */
  .ns-badge-hero {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    border: 1.5px solid rgba(255,255,255,0.22);
    background: rgba(255,255,255,0.10);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
    backdrop-filter: blur(8px);
  }

  .ns-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.75rem;
    border-radius: 999px;
    background: #fff;
    color: var(--ns-navy);
    font-size: 0.875rem;
    font-weight: 700;
    box-shadow: 0 4px 18px rgba(26,58,92,0.25);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    white-space: nowrap;
  }
  .ns-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(26,58,92,0.32); }

  .ns-btn-outline-hero {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.75rem;
    border-radius: 999px;
    border: 1.5px solid rgba(255,255,255,0.30);
    background: rgba(255,255,255,0.08);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 700;
    backdrop-filter: blur(6px);
    transition: border-color 0.25s ease, background 0.25s ease;
    white-space: nowrap;
  }
  .ns-btn-outline-hero:hover { border-color: rgba(255,255,255,0.6); background: rgba(255,255,255,0.15); }

  /* ================================================================
     TICKER
  ================================================================ */
  .ns-ticker-section { background: #eaf4f9; border-top: 1px solid #d1e9f5; border-bottom: 1px solid #d1e9f5; }

  .ns-ticker-track {
    animation: ns-ticker-scroll 28s linear infinite;
    width: max-content;
  }
  .ns-ticker-track:hover { animation-play-state: paused; }

  @keyframes ns-ticker-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-33.3333%); }
  }

  .ns-ticker-item { padding: 0 0.5rem; }

  /* ================================================================
     STAT CARDS (intro section)
  ================================================================ */
  .ns-stat-card {
    border-radius: 0.875rem;
    padding: 1rem 1.25rem;
    background: linear-gradient(135deg, #eaf4f9 0%, #f8fafc 100%);
    border: 1.5px solid #d1e9f5;
  }

  /* ================================================================
     CHALLENGE SECTION
  ================================================================ */
  .ns-challenge-card {
    border-radius: 1rem;
    padding: 1.75rem;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    backdrop-filter: blur(8px);
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .ns-challenge-card:hover { background: rgba(255,255,255,0.10); border-color: rgba(201,162,39,0.35); }

  .ns-challenge-num {
    display: block;
    font-family: 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, rgba(201,162,39,0.6), rgba(232,197,71,0.4));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .ns-bridge-box {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
    background: #fff;
    box-shadow: 0 4px 24px rgba(26,58,92,0.10);
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }

  /* ================================================================
     SOLUTION CARDS
  ================================================================ */
  .ns-solution-card {
    border-radius: 0.875rem;
    padding: 1.25rem;
    background: #f8fafc;
    border: 1.5px solid #e2f0f8;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }
  .ns-solution-card:hover { border-color: #a8d4eb; box-shadow: 0 4px 16px rgba(45,106,143,0.12); transform: translateY(-2px); }

  .ns-solution-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.625rem;
    background: #fff;
    box-shadow: 0 1px 6px rgba(45,106,143,0.12);
    border: 1px solid #d1e9f5;
    margin-bottom: 0.875rem;
  }

  /* ================================================================
     CAPABILITIES SECTION
  ================================================================ */
  .ns-cap-section {
    background: linear-gradient(160deg, #eaf4f9 0%, #f8fafc 50%, #fef9ec 100%);
  }

  .ns-cap-card {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    padding: 1.75rem;
    background: #fff;
    border: 1.5px solid #e2f0f8;
    box-shadow: 0 2px 12px rgba(45,106,143,0.06);
    transition: box-shadow 0.3s ease, transform 0.3s ease, border-color 0.3s ease;
  }
  .ns-cap-card:hover { box-shadow: 0 8px 30px rgba(45,106,143,0.14); transform: translateY(-3px); border-color: #a8d4eb; }

  .ns-cap-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    background: linear-gradient(135deg, #eaf4f9, #d1e9f5);
    border: 1.5px solid #c0dcf0;
  }

  .ns-cap-card-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
