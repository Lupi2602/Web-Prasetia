---
import MainLayout from '../../../layouts/MainLayout.astro';
---

<MainLayout title="Oracle NetSuite | PT Prasetia Dwidharma">
  <div class="container mx-auto px-6 max-w-4xl py-20 text-center">
    <span class="inline-block px-3 py-1 bg-gray-100 text-gray-500 text-xs font-semibold uppercase tracking-wider rounded mb-4">
      ICT Solution
    </span>
    <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 mb-6">
      Oracle NetSuite
    </h1>

    <div class="border border-dashed border-gray-300 rounded-xl p-12 max-w-lg mx-auto bg-gray-50">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-widest mb-2">
        [CONTENT NOT AVAILABLE YET]
      </p>
      <p class="text-xs text-gray-400">
        Informasi dan konten produk Oracle NetSuite akan diperbarui setelah materi referensi tersedia.
      </p>
    </div>
  </div>
</MainLayout>
