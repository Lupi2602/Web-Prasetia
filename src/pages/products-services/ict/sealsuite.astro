    background: var(--ss-bg);
  }
  .hr-bg { position: absolute; inset: 0; z-index: -3; overflow: hidden; }
  .hr-bg img {
    width: 100%; height: 100%; max-width: none;
    object-fit: cover; object-position: center;
    transform: translate3d(0, calc(var(--sp) * 40px), 0) scale(1.08);
    will-change: transform;
  }
  /* scrim terang: putih kebiruan di kiri (area teks), gambar mulai terlihat di kanan */
  .ss-hero::before {
    content: ""; position: absolute; inset: 0; z-index: -2; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(244, 249, 255, 0.96) 0%, rgba(240, 248, 255, 0.86) 45%, rgba(236, 246, 255, 0.5) 100%),
      radial-gradient(60% 70% at 88% 15%, rgba(0, 229, 229, 0.18), transparent 70%);
  }
  /* bagian bawah memudar ke warna halaman */
  .ss-hero::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 140px;
    z-index: -1; pointer-events: none;
    background: linear-gradient(to bottom, rgba(244, 249, 255, 0), var(--ss-bg));
  }

  .ss-hero-inner { position: relative; z-index: 1; }
