  }
  .ss-frame img { width: 100%; height: 100%; object-fit: contain; border-radius: 1rem; }

  .js .ss-slide .hr-item { opacity: 0; transform: translate3d(0, 22px, 0); transition: opacity 0.3s ease, transform 0.3s ease; }
  .js .ss-hero.is-ready .ss-slide.is-active .hr-item {
    opacity: 1; transform: none;
    transition: opacity 0.7s var(--ss-ease) var(--d, 0ms), transform 0.8s var(--ss-ease) var(--d, 0ms);
  }

  .ss-controls { display: flex; align-items: center; gap: 0.6rem; margin-top: 2.25rem; }
  .ss-dot { position: relative; width: 40px; height: 4px; border-radius: 999px; background: rgba(0, 106, 255, 0.2); overflow: hidden; }
  .ss-dot::after { content: ""; position: absolute; inset: -12px -4px; }
  .ss-dot-fill { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--ss-blue), var(--ss-cyan)); }
  .ss-dot.is-active .ss-dot-fill { animation: ss-fill 2s linear forwards; }
  .ss-hero.is-paused .ss-dot.is-active .ss-dot-fill { animation-play-state: paused; }
  @keyframes ss-fill { from { width: 0; } to { width: 100%; } }

  /* dekorasi hero */
  .hr-decor { position: absolute; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  .hr-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(0, 106, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 106, 255, 0.06) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse at 75% 40%, #000 0%, transparent 65%);
    mask-image: radial-gradient(ellipse at 75% 40%, #000 0%, transparent 65%);
  }
  .hr-orb { position: absolute; border-radius: 50%; filter: blur(50px); }
  .hr-orb-blue { width: min(32vw, 420px); aspect-ratio: 1; top: 8%; left: -6%; background: rgba(0, 106, 255, 0.12); animation: hr-float-a 9s ease-in-out infinite alternate; }
  .hr-orb-cyan { width: min(28vw, 360px); aspect-ratio: 1; bottom: 6%; right: -4%; background: rgba(0, 229, 229, 0.16); animation: hr-float-c 11s ease-in-out infinite alternate; }
  @keyframes hr-float-a { from { transform: translate3d(0, 0, 0) scale(1); } to { transform: translate3d(14px, -22px, 0) scale(1.05); } }
  @keyframes hr-float-b { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(0, -10px, 0); } }
  @keyframes hr-float-c { from { transform: translate3d(0, 0, 0) rotate(-8deg); } to { transform: translate3d(8px, -14px, 0) rotate(10deg); } }
  .ss-hero.is-offscreen .hr-decor *, .ss-hero.is-offscreen .ss-frame { animation-play-state: paused; }

  /* hero responsive */
  @media (max-width: 1023px) {
