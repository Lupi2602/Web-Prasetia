  }
  .ss-slide.is-active { opacity: 1; visibility: visible; pointer-events: auto; transition-delay: 0s; }
  .ss-slide-grid { display: grid; gap: 2.25rem; align-items: center; width: 100%; grid-template-columns: minmax(0, 1fr); }
