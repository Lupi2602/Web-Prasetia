  }

  .pillar-stack-title {
    margin: 0 0 0.85rem;
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 800;
    color: #0f172a;
  }

  .pillar-stack-desc {
    margin: 0 0 1.25rem;
    max-width: 420px;
