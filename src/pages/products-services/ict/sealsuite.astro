  @media (min-width: 640px) { .why-card { padding: 2.25rem; border-radius: 1.75rem; } }
  .why-icon {
    width: 38px; height: 38px; flex: none; display: flex; align-items: center; justify-content: center;
    border-radius: 0.8rem; color: var(--ss-blue);
    background: linear-gradient(135deg, rgba(0, 106, 255, 0.12), rgba(0, 229, 229, 0.16));
  }

  /* LOGO CHIP */
  .logo-chip {
    display: inline-flex; align-items: stretch; overflow: hidden; max-width: 100%;
    border-radius: 999px; background: #ffffff; border: 1px solid rgba(0, 106, 255, 0.18);
    box-shadow: 0 10px 26px -12px rgba(0, 70, 180, 0.4);
  }
  .logo-seg { display: inline-flex; align-items: center; justify-content: center; min-width: 0; }
  .logo-seg-light { padding: 0.6rem 1.1rem 0.6rem 1.2rem; background: linear-gradient(135deg, #ffffff 0%, #f0f7ff 100%); }
  .logo-seg-dark { padding: 0.6rem 1.2rem 0.6rem 1.1rem; background: linear-gradient(135deg, #006aff 0%, #0a4fc4 100%); }
  @media (max-width: 379px) {
    .logo-seg-light { padding: 0.5rem 0.75rem; }
    .logo-seg-dark { padding: 0.5rem 0.75rem; }
  }

  /* MARQUEE PELANGGAN */
  @keyframes infinite-marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  .marquee-wrap { padding: 0.5rem 0; max-width: 100%; overflow: hidden; }
  .marquee-row { --mg: 2rem; display: flex; width: 100%; max-width: 100%; overflow: hidden; padding: 0.6rem 0; }
  @media (min-width: 640px) { .marquee-row { --mg: 3.5rem; } }
  @media (min-width: 768px) { .marquee-row { --mg: 4.5rem; padding: 0.9rem 0; } }
  .marquee-track { display: flex; width: max-content; }
  .animate-infinite-marquee { animation: infinite-marquee 50s linear infinite; }
  .animate-infinite-marquee.is-reverse { animation-direction: reverse; }
  @media (max-width: 767px) { .animate-infinite-marquee { animation-duration: 40s; } }
  .marquee-group { display: flex; flex: none; align-items: center; gap: var(--mg); padding-right: var(--mg); }
  .marquee-row:hover .marquee-track { animation-play-state: paused; }
  .marquee-fade { position: absolute; top: 0; bottom: 0; width: 28px; z-index: 10; pointer-events: none; }
  .marquee-fade-l { left: 0; background: linear-gradient(to right, var(--ss-bg), transparent); }
  .marquee-fade-r { right: 0; background: linear-gradient(to left, var(--ss-bg), transparent); }
  @media (min-width: 640px) { .marquee-fade { width: 96px; } }
  .customer-logo { flex: none; height: 4.25rem; width: auto; max-width: none; object-fit: contain; transition: transform 0.4s ease; }
  @media (min-width: 480px) { .customer-logo { height: 5.5rem; } }
  @media (min-width: 640px) { .customer-logo { height: 6.5rem; } }
  @media (min-width: 768px) { .customer-logo { height: 7.5rem; } .customer-logo:hover { transform: scale(1.08); } }

  /* SCROLL REVEAL */
  .js .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.7s var(--ss-ease), transform 0.7s var(--ss-ease); transition-delay: var(--delay, 0ms); }
  .js .reveal.visible { opacity: 1; transform: none; }
  .js .reveal-stagger > * { opacity: 0; transform: translateY(20px); transition: opacity 0.6s var(--ss-ease), transform 0.6s var(--ss-ease), box-shadow 0.3s ease, border-color 0.3s ease; }
  .js .reveal-stagger.visible > * { opacity: 1; transform: none; transition-delay: calc(var(--i, 0) * 70ms), calc(var(--i, 0) * 70ms), 0ms, 0ms; }

  /* FAQ */
  .faq-item {
    background: #ffffff; border-radius: 1.1rem; border: 1px solid rgba(0, 106, 255, 0.1);
    box-shadow: 0 2px 8px rgba(0, 70, 180, 0.04); transition: box-shadow 0.3s ease, border-color 0.3s ease;
    overflow: hidden;
  }
  .faq-item[open] { box-shadow: 0 14px 30px -18px rgba(0, 70, 180, 0.3); border-color: rgba(0, 106, 255, 0.25); }
  .faq-item summary { min-height: 56px; }
  .faq-item summary > div { flex: 1; min-width: 0; }
  .faq-item summary span.font-semibold { overflow-wrap: anywhere; }
  .faq-num {
    flex: none; width: 26px; height: 26px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.7rem; font-weight: 700; color: #fff; background: linear-gradient(135deg, #006aff, #00b8b8);
  }
  .faq-icon {
    flex: none; margin-left: 0.5rem; width: 32px; height: 32px; border-radius: 50%;
    border: 1px solid #e2e8f0; color: #94a3b8;
    display: flex; align-items: center; justify-content: center;
    transition: border-color 0.3s ease, color 0.3s ease;
  }
  .faq-item[open] .faq-icon { border-color: var(--ss-blue); color: var(--ss-blue); }
  .faq-item .ml-10 { overflow-wrap: anywhere; }
  @media (max-width: 479px) { .faq-item .ml-10 { margin-left: 0; } }
  details[open] .fi-br-plus { display: none !important; }
  details[open] .fi-br-minus { display: flex !important; }
  details:not([open]) .fi-br-minus { display: none !important; }
  details:not([open]) .fi-br-plus { display: flex !important; }
  details[open] > div { animation: faq-in 0.4s var(--ss-ease); }
  @keyframes faq-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }

  /* CTA */
  .cta-box {
    position: relative; isolation: isolate; overflow: hidden; border-radius: 2rem;
    border: 1px solid rgba(0, 106, 255, 0.12); box-shadow: 0 30px 70px -36px rgba(0, 70, 180, 0.4);
  }
  .cta-box .grid > * { min-width: 0; }
  .cta-inner-box {
    width: 100%; max-width: 24rem; padding: 1.75rem; border-radius: 1.5rem; background: #ffffff;
    border: 1px solid rgba(0, 106, 255, 0.12); box-shadow: 0 20px 44px -26px rgba(0, 70, 180, 0.35);
  }
  @media (max-width: 1023px) { .cta-inner-box { max-width: none; } .cta-box .grid { gap: 1.75rem; } }
  @media (max-width: 639px) {
    .cta-box { border-radius: 1.5rem; }
    .cta-box .grid { padding: 1.5rem 1.25rem; }
    .cta-inner-box { padding: 1.25rem; }
  }

  /* SENTUHAN */
  @media (hover: none) {
    .btn-fx:hover { transform: none; }
    .btn-fx:hover::before { display: none; }
    .cert-card:hover { transform: none; }
  }

  /* REDUCE MOTION */
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .js .ss-page { animation: none; }
    .js .reveal, .js .reveal-stagger > * { opacity: 1 !important; transform: none !important; transition: none !important; }
    .animate-infinite-marquee, .ss-frame, .zt-glow, #zt-image, .hr-decor * { animation: none !important; }
    .btn-fx, .btn-fx:hover, .btn-fx:active { transform: none !important; transition: none !important; }
    .js .ss-slide .hr-item { opacity: 1 !important; transform: none !important; transition: none !important; }
    .ss-slide { transition: opacity 0.3s ease !important; }
    .ss-slides { transform: none !important; }
    .ss-dot.is-active .ss-dot-fill { animation: none; width: 100%; }
    .js-zt-active #zt-container, .js-zt-active #zt-mask { opacity: 1 !important; transform: none !important; }
    .pillar-stack-card { position: relative; top: auto; height: auto; margin-bottom: 1.5rem; }
    .pillar-stack::after { display: none; }
    .pillar-next { margin-top: 0; box-shadow: none; }
    .pillar-card-inner { height: auto; }
    .pillar-stack-card.is-covered { visibility: visible; }
    .pillar-stack-img { transform: none !important; transition: none !important; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // SCROLL REVEAL
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -48px 0px' }
  );

  document.querySelectorAll<HTMLElement>('.reveal, .reveal-stagger').forEach((el) => {
    const delay = el.dataset.delay;
    if (delay) el.style.setProperty('--delay', `${delay}ms`);
    if (el.classList.contains('reveal-stagger')) {
      Array.from(el.children).forEach((child, i) => {
        (child as HTMLElement).style.setProperty('--i', String(i));
      });
    }
    if (reduceMotion) el.classList.add('visible');
    else observer.observe(el);
  });

  // SPOTLIGHT PADA TOMBOL
  document.querySelectorAll<HTMLElement>('.btn-fx').forEach((btn) => {
    btn.addEventListener('pointermove', (e: PointerEvent) => {
      if (e.pointerType !== 'mouse') return;
      const r = btn.getBoundingClientRect();
      btn.style.setProperty('--mx', `${e.clientX - r.left}px`);
      btn.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });

  // PROGRESS SCROLL DAN LATAR AMBIENT
  (() => {
    const bar = document.querySelector<HTMLElement>('.ss-progress span');
    const ambient = document.querySelector<HTMLElement>('[data-ambient]');
    let queued = false;

    const update = () => {
      queued = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? Math.min(Math.max(window.scrollY / max, 0), 1) : 0;
      if (bar) bar.style.transform = `scaleX(${p.toFixed(4)})`;
      if (ambient && !reduceMotion) ambient.style.setProperty('--page-p', p.toFixed(4));
    };
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    }, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  })();

  // HERO: carousel otomatis setiap 2 detik
  (() => {
    const root = document.querySelector<HTMLElement>('[data-carousel]');
    if (!root) return;

    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const total = slides.length;
    const INTERVAL = 3500;

    let index = 0;
    let timer: number | undefined;
    let keyboardFocus = false;
    let visible = true;

    const go = (i: number) => {
      index = (i + total) % total;
      slides.forEach((s, n) => {
        const active = n === index;
        s.classList.toggle('is-active', active);
        s.setAttribute('aria-hidden', String(!active));
        s.toggleAttribute('inert', !active);
      });
      dots.forEach((d, n) => {
        const active = n === index;
        d.classList.remove('is-active');
        if (active) {
          void d.offsetWidth;
          d.classList.add('is-active');
        }
        d.setAttribute('aria-current', String(active));
      });
    };

    const stopTimer = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };
    const refreshAutoplay = () => {
      stopTimer();
      const run = !reduceMotion && !keyboardFocus && visible && !document.hidden;
      root.classList.toggle('is-paused', !run);
      if (run) timer = window.setInterval(() => go(index + 1), INTERVAL);
    };
    const manual = (i: number) => { go(i); refreshAutoplay(); };

    dots.forEach((d, n) => d.addEventListener('click', () => manual(n)));

    root.addEventListener('focusin', (e) => {
      keyboardFocus = (e.target as HTMLElement).matches(':focus-visible');
      refreshAutoplay();
    });
    root.addEventListener('focusout', () => { keyboardFocus = false; refreshAutoplay(); });
    document.addEventListener('visibilitychange', refreshAutoplay);

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') manual(index - 1);
      if (e.key === 'ArrowRight') manual(index + 1);
    });

    let startX = 0;
    let tracking = false;
    root.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      startX = e.clientX;
      tracking = true;
    });
    root.addEventListener('pointerup', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 50) manual(dx < 0 ? index + 1 : index - 1);
    });
    root.addEventListener('pointercancel', () => { tracking = false; });

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      root.classList.toggle('is-offscreen', !visible);
      refreshAutoplay();
    }).observe(root);

    go(0);
    refreshAutoplay();
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.add('is-ready')));

    if (reduceMotion) return;

    let queued = false;
    let heroH = root.offsetHeight;
    const updateScroll = () => {
      queued = false;
      if (window.scrollY > heroH) return;
      const p = Math.min(Math.max(window.scrollY / heroH, 0), 1);
      root.style.setProperty('--sp', p.toFixed(4));
      root.style.setProperty('--fo', Math.max(1 - p * 0.9, 0).toFixed(3));
    };
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(updateScroll);
    }, { passive: true });
    window.addEventListener('resize', () => { heroH = root.offsetHeight; updateScroll(); }, { passive: true });
    updateScroll();
  })();

  // ZERO TRUST: animasi kartu dan gambar saat scroll, tanpa memotong gambar
  (() => {
    const wrapper = document.getElementById('zt-wrapper');
    if (!wrapper || reduceMotion) return;

    const mask = document.getElementById('zt-mask');
    if (!mask) return;

    wrapper.classList.add('js-zt-active');

    const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
    let queued = false;

    const update = () => {
      queued = false;
      const h = window.innerHeight;
      const wr = wrapper.getBoundingClientRect();
      if (wr.top > h + 200 || wr.bottom < -200) return;

      const cardP = clamp01((h * 0.98 - wr.top) / (h * 0.98 - h * 0.55));
      const mr = mask.getBoundingClientRect();
      const imgP = clamp01((h * 0.92 - mr.top) / (h * 0.92 - h * 0.5));

      wrapper.style.setProperty('--zt-card', cardP.toFixed(3));
      wrapper.style.setProperty('--zt-img', imgP.toFixed(3));
    };

    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    }, { passive: true });
    window.addEventListener('resize', () => requestAnimationFrame(update), { passive: true });
    update();
  })();

  // 4 PILAR: sticky stacking cards
  (() => {
    const stack = document.querySelector<HTMLElement>('[data-pillar-stack]');
    if (!stack) return;

    const cards = Array.from(stack.querySelectorAll<HTMLElement>('[data-pillar-card]'));
    if (!cards.length) return;

    const nextSection = document.querySelector<HTMLElement>('[data-pillar-next]');

    cards.forEach((card, index) => { card.style.zIndex = String(10 + index); });

    if (reduceMotion) {
      cards.forEach((card) => card.style.setProperty('--pillar-image-y', '0px'));
      return;
    }

    const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
    let ticking = false;

    const getStickyTop = () =>
      parseFloat(getComputedStyle(cards[0]).getPropertyValue('--stack-top')) || 104;

    const updateStack = () => {
      ticking = false;
      const viewportH = window.innerHeight;
      const stickyTop = getStickyTop();

      cards.forEach((card, index) => {
        const rect = card.getBoundingClientRect();
        const isLast = index === cards.length - 1;

        let covered = false;
        if (!isLast) {
          covered = cards[index + 1].getBoundingClientRect().top <= stickyTop + 1;
        } else if (nextSection) {
          covered = nextSection.getBoundingClientRect().top <= stickyTop + 1;
        }
        card.classList.toggle('is-covered', covered);

        const imageProgress = clamp((viewportH * 0.75 - rect.top) / (viewportH * 0.75), 0, 1);
        card.style.setProperty('--pillar-image-y', `${((0.5 - imageProgress) * 12).toFixed(2)}px`);
      });
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateStack);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    window.addEventListener('load', requestUpdate, { once: true });
    if ('ResizeObserver' in window) new ResizeObserver(requestUpdate).observe(stack);
    requestUpdate();
  })();
</script>