---
import MainLayout from '../../../layouts/MainLayout.astro';

const BASE_IMG_URL = "/images/reference/ICT/sealsuite";
const HERO_BG = "/images/reference/ICT/sealsuite/herosealsuite.png";

const customers = [
  `${BASE_IMG_URL}/customer-1.png`,
  `${BASE_IMG_URL}/customer-2.png`,
  `${BASE_IMG_URL}/customer-3.png`,
  `${BASE_IMG_URL}/customer-4.png`,
  `${BASE_IMG_URL}/customer-5.png`,
  `${BASE_IMG_URL}/customer-6.png`,
  `${BASE_IMG_URL}/customer-7.png`,
];

// Logo dibagi jadi 2 baris. Tiap baris diulang beberapa kali agar marquee selalu penuh & mulus.
const repeat = (arr: string[], n: number) => Array.from({ length: n }, () => arr).flat();
const customerRows = [
  repeat(customers.slice(0, 4), 3),
  repeat(customers.slice(4), 4),
];

const heroSlides = [
  {
    tag: "Platform Keamanan Terpadu",
    title: "SealSuite: All-in-One IT Governance & Security Platform",
    desc: "Amankan identitas, perangkat, dan jaringan perusahaan Anda dalam satu platform berbasis Zero Trust.",
    img: "data-security-solution.png",
    alt: "SealSuite IT Governance and Security Platform",
  },
  {
    tag: "Forrester Thought Leadership",
    title: "Forrester Thought Leadership Paper",
    desc: "SealSuite menugaskan Forrester Consulting untuk menyusun paper tentang bagaimana zero trust membantu platform keamanan mencegah kebocoran data, membangun kepercayaan, dan mendorong pertumbuhan.",
    img: "forrester-report.png",
    alt: "Forrester Thought Leadership Paper",
  },
];

const certifications = [
  { name: "SOC 2 Type I AICPA", img: "soc2-aicpa.png" },
  { name: "ISO 9001:2015", img: "iso-27001.png" },
  { name: "ISO/IEC 27701:2019", img: "iso-27001.png" },
  { name: "ISO/IEC 27017:2015", img: "iso-27001.png" },
  { name: "ISO/IEC 20000-1:2018", img: "iso-27001.png" },
  { name: "ISO/IEC 27001:2022", img: "iso-27001.png" },
  { name: "ISO 22301:2019", img: "iso-27001.png" },
  { name: "Data Protection Assured", img: "data-protection-assured.png" },
  { name: "APEC Cross Border Privacy Rules System Singapore", img: "apec-cross-border-privacy.png" },
  { name: "APEC Privacy Recognition for Processors System Singapore", img: "apec-privacy-processors.png" },
];

const faqs = [
  {
    q: "Apa perbedaan SealSuite dengan solusi keamanan tradisional?",
    a: "SealSuite menerapkan arsitektur Zero Trust yang tidak hanya mengamankan batas jaringan, tetapi memverifikasi setiap identitas dan perangkat secara dinamis sebelum memberikan akses."
  },
  {
    q: "Apakah cocok untuk perusahaan multi-cabang?",
    a: "Sangat cocok. Dengan manajemen cloud terpusat, Anda dapat memantau dan menerapkan kebijakan keamanan yang sama ke seluruh cabang tanpa perangkat keras tambahan di setiap lokasi."
  },
  {
    q: "Bagaimana proses implementasi & estimasi waktunya?",
    a: "Implementasi dimulai dari fase konsultasi, diikuti konfigurasi dan pilot testing sebelum go-live. Waktu implementasi bervariasi bergantung pada skala dan kompleksitas lingkungan perusahaan Anda."
  },
  {
    q: "Apakah ada uji coba/demo?",
    a: "Ya, kami menyediakan sesi demo gratis dan konsultasi awal untuk memahami kecocokan SealSuite dengan kebutuhan bisnis Anda."
  },
  {
    q: "Bagaimana langkah awal untuk mulai?",
    a: "Silakan isi formulir di bagian bawah halaman ini, dan tim konsultan kami akan segera menghubungi Anda untuk menjadwalkan diskusi lebih lanjut."
  }
];

const pillars = [
  {
    title: "Identity & Access Management",
    desc: "Satu sistem untuk kelola identitas, Single Sign-On, dan hak akses yang lebih aman dan efisien.",
    features: [
      "Single sign-on & provisioning otomatis",
      "Role-based access & audit trail",
      "Integrasi ke berbagai aplikasi kerja modern"
    ],
    img: "iam-product.png",
    color: "from-[#006aff]/10 to-[#00e5e5]/10",
    accentColor: "bg-[#006aff]",
  },
  {
    title: "Endpoint Management & Security",
    desc: "Amankan perangkat kerja dengan MDM, DLP, dan firewall untuk perlindungan menyeluruh.",
    features: [
      "Perangkat selalu terpantau agar mengikuti standar keamanan",
      "Proteksi ancaman & penegakan kebijakan",
      "Device control (USB, clipboard, dll.)"
    ],
    img: "endpoint-product.png",
    color: "from-[#00e5e5]/10 to-[#006aff]/10",
    accentColor: "bg-[#00b8b8]",
  },
  {
    title: "Network Management & Security",
    desc: "Kontrol akses jaringan, VPN, dan SD-WAN untuk konektivitas aman dan efisien.",
    features: [
      "Koneksi aman antar lokasi",
      "Kontrol akses jaringan",
      "Manajemen Wi-Fi perusahaan"
    ],
    img: "network-product.png",
    color: "from-[#006aff]/10 to-[#00e5e5]/10",
    accentColor: "bg-[#006aff]",
  },
  {
    title: "SaaS Protection",
    desc: "Amankan aplikasi cloud dan AI untuk melindungi data bisnis dari ancaman terkini.",
    features: [
      "Data Loss Prevention untuk browser",
      "Kontrol penggunaan AI generatif",
      "Monitor konfigurasi aplikasi SaaS"
    ],
    img: "saas-product.png",
    color: "from-[#00e5e5]/10 to-[#006aff]/10",
    accentColor: "bg-[#00b8b8]",
  }
];
---

<MainLayout title="SealSuite | PT Prasetia Dwidharma" transparentNavbar={true}>

  <script is:inline>document.documentElement.classList.add('js');</script>

  <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/2.6.0/uicons-bold-rounded/css/uicons-bold-rounded.css" />
  <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/2.6.0/uicons-solid-rounded/css/uicons-solid-rounded.css" />

  <div class="ss-progress" aria-hidden="true"><span></span></div>

  <div class="ss-page">

    {/* Latar ambient yang ikut bergerak halus saat scroll, supaya seluruh halaman terasa menyatu */}
    <div class="ss-ambient" aria-hidden="true" data-ambient>
      <span class="amb amb-1"></span>
      <span class="amb amb-2"></span>
    </div>

    {/* 1. HERO */}
<section class="ss-hero" aria-label="Hero" aria-roledescription="carousel" data-carousel>

  <div class="hr-bg" aria-hidden="true">
    <img src={HERO_BG} alt="" decoding="async" fetchpriority="high" loading="eager" />
  </div>

  <div class="hr-decor" aria-hidden="true">
    <div class="hr-grid"></div>
    <span class="hr-orb hr-orb-blue"></span>
    <span class="hr-orb hr-orb-cyan"></span>
    <span class="hr-ring"></span>
  </div>

  <div class="ss-hero-inner mx-auto max-w-7xl px-6 lg:px-8 w-full">
    <div class="ss-slides">
      {heroSlides.map((s, i) => {
        const Heading = i === 0 ? 'h1' : 'h2';
        return (
          <div
            class={`ss-slide${i === 0 ? ' is-active' : ''}`}
            data-slide
            inert={i !== 0}
            aria-roledescription="slide"
            aria-label={`${i + 1} dari ${heroSlides.length}`}
          >
            <div class="ss-slide-grid">
              <div class="ss-copy">
                <span class="hr-item ss-eyebrow" style="--d:0ms;">
                  <span class="ss-eyebrow-dot"></span>{s.tag}
                </span>
                <Heading class="hr-item hr-h1" style="--d:100ms;">{s.title}</Heading>
                <span class="hr-item hr-rule" style="--d:160ms;" aria-hidden="true"></span>
                <p class="hr-item hr-lead" style="--d:220ms;">{s.desc}</p>
                <div class="hr-item mt-8 flex flex-wrap items-center gap-3" style="--d:320ms;">
                  <a href="#zero-trust" class="btn-fx btn-primary">Pelajari Lebih Lanjut</a>
                  <a href="#contact" class="btn-fx btn-ghost">Minta Demo</a>
                </div>
              </div>

              <div class="hr-item ss-visual" style="--d:180ms;">
                <div class="ss-frame">
                  <img
                    src={`${BASE_IMG_URL}/${s.img}`}
                    alt={s.alt}
                    decoding="async"
                    fetchpriority={i === 0 ? 'high' : 'auto'}
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div class="ss-controls" aria-label="Pilih slide">
      {heroSlides.map((_, i) => (
        <button
          type="button"
          class={`ss-dot${i === 0 ? ' is-active' : ''}`}
          data-dot={String(i)}
          aria-label={`Slide ${i + 1}`}
          aria-current={i === 0 ? 'true' : 'false'}
        >
          <span class="ss-dot-fill"></span>
        </button>
      ))}
    </div>
  </div>
</section>
    {/* 2. SERTIFIKASI */}
    <section class="py-14 sm:py-16" aria-label="Sertifikasi dan Kredensial">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-5 reveal-stagger">
          {certifications.map((cert) => (
            <div class="cert-card group">
              <div class="w-12 h-12 sm:w-14 sm:h-14 flex items-center justify-center mb-2.5">
                <img
                  src={`${BASE_IMG_URL}/${cert.img}`}
                  alt={cert.name}
                  class="max-h-full max-w-full object-contain"
                  loading="lazy"
                />
              </div>
              <span class="text-center text-[10px] sm:text-[11px] font-medium text-gray-600 group-hover:text-[#006aff] transition-colors duration-300 leading-tight">{cert.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* 3. ZERO TRUST */}
    <section id="zero-trust" class="zt-section py-16 sm:py-24 relative" aria-label="Zero Trust Solution">
      <div id="zt-wrapper" class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div id="zt-container" class="zt-card">

          <div class="zt-text reveal">
            <span class="ss-eyebrow">
              <i class="fi fi-br-shield-check" style="font-size:0.85rem; line-height:1; display:flex;"></i>
              Zero Trust Architecture
            </span>
            <h2 class="ss-h2 mt-4">
              SealSuite: <span class="gradient-text">Solusi Keamanan Zero Trust Modern</span><br class="hidden sm:block" /> untuk Bisnis Indonesia
            </h2>
            <p class="ss-sub mt-4 max-w-2xl mx-auto">
              SealSuite menghadirkan keamanan modern berbasis Zero Trust, menyatukan identitas, perangkat, dan jaringan untuk memberikan pengawasan lengkap, kontrol fleksibel, serta aturan konsisten di seluruh sistem.
            </p>
          </div>

          <div id="zt-mask" class="zt-visual">
            <span class="zt-glow" aria-hidden="true"></span>
            <img
              id="zt-image"
              src={`${BASE_IMG_URL}/zero-trust-solution.png`}
              alt="Zero Trust Solution"
              loading="lazy"
            />
          </div>

          <ul class="zt-points reveal-stagger">
            <li><span class="zt-dot"></span>Identitas terverifikasi</li>
            <li><span class="zt-dot"></span>Perangkat terpantau</li>
            <li><span class="zt-dot"></span>Jaringan terkontrol</li>
          </ul>
        </div>
      </div>
    </section>

    {/* 4. EMPAT PILAR, STICKY STACKING CARDS */}
    <section class="pillar-stack-section py-20 sm:py-28" aria-label="4 Pilar Keamanan">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">

        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-14 reveal">
          <h2 class="ss-h2">
            4 Pilar Keamanan Utama SealSuite<br /><span class="gradient-text">untuk Perlindungan Zero Trust</span>
          </h2>
          <p class="ss-sub mt-4 max-w-2xl mx-auto">
            Empat lapisan keamanan yang bekerja bersama untuk melindungi identitas, perangkat, jaringan, dan aplikasi cloud perusahaan.
          </p>
        </div>

        <div class="pillar-stack" data-pillar-stack>
          {pillars.map((pillar, index) => (
            <article
              class="pillar-stack-card"
              data-pillar-card
              data-index={String(index)}
              style={`--stack-index:${index};`}
            >
              <div class="pillar-card-inner">
                <div class={`pillar-stack-content bg-gradient-to-br ${pillar.color}`}>
                  <div class="pillar-content-inner">
                    <div class="pillar-meta">
                      <span class={`pillar-number ${pillar.accentColor}`}>
                        {String(index + 1).padStart(2, '0')}
                      </span>
                    </div>

                    <h3 class="pillar-stack-title">{pillar.title}</h3>
                    <p class="pillar-stack-desc">{pillar.desc}</p>

                    <ul class="pillar-feature-list">
                      {pillar.features.map((feat) => (
                        <li class="pillar-stack-feature">
                          <span class={`pillar-feature-icon ${pillar.accentColor}`}>
                            <i class="fi fi-br-check text-white" style="font-size:0.6rem;"></i>
                          </span>
                          <span>{feat}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="pillar-stack-image">
                  <img
                    src={`${BASE_IMG_URL}/${pillar.img}`}
                    alt={pillar.title}
                    class="pillar-stack-img"
                    loading="lazy"
                  />
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* 5. IMPLEMENTASI & VIRTUENET (menutupi card 4) */}
    <section class="pillar-next py-20 sm:py-28 overflow-hidden" data-pillar-next aria-label="Implementasi dan Virtuenet">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="text-center mb-12 sm:mb-14 reveal">
          <h2 class="ss-h2">
            Proses Implementasi SealSuite<br /><span class="gradient-text">Bersama Virtuenet</span>
          </h2>
          <p class="ss-sub mt-4 max-w-xl mx-auto">Assessment hingga Go Live. Kami dampingi setiap tahap perjalanan digital Anda.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-start">

          <div class="reveal">
            <div class="space-y-0">
              <div class="relative flex gap-5 pb-8">
                <div class="flex flex-col items-center">
                  <div class="step-num">1</div>
                  <div class="step-line"></div>
                </div>
                <div class="pt-1">
                  <div class="flex items-center gap-2 mb-1.5">
                    <i class="fi fi-br-search text-[#006aff]" style="font-size:0.95rem;"></i>
                    <h3 class="text-base sm:text-lg font-bold text-gray-900">Konsultasi &amp; Assessment</h3>
                  </div>
                  <p class="ss-sub">Pemetaan risiko, identitas, perangkat, dan jaringan untuk menentukan strategi implementasi terbaik.</p>
                </div>
              </div>

              <div class="relative flex gap-5 pb-8">
                <div class="flex flex-col items-center">
                  <div class="step-num">2</div>
                  <div class="step-line"></div>
                </div>
                <div class="pt-1">
                  <div class="flex items-center gap-2 mb-1.5">
                    <i class="fi fi-br-settings text-[#006aff]" style="font-size:0.95rem;"></i>
                    <h3 class="text-base sm:text-lg font-bold text-gray-900">Konfigurasi &amp; Pilot</h3>
                  </div>
                  <p class="ss-sub">Kebijakan akses, integrasi SSO, deployment agen endpoint untuk testing lingkungan terbatas.</p>
                </div>
              </div>

              <div class="relative flex gap-5">
                <div class="flex flex-col items-center">
                  <div class="step-num">3</div>
                </div>
                <div class="pt-1">
                  <div class="flex items-center gap-2 mb-1.5">
                    <i class="fi fi-br-chart-line-up text-[#006aff]" style="font-size:0.95rem;"></i>
                    <h3 class="text-base sm:text-lg font-bold text-gray-900">Go-live &amp; Optimasi</h3>
                  </div>
                  <p class="ss-sub">Pelatihan, dashboard monitoring, review kebijakan berkala untuk optimasi berkelanjutan.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="reveal" data-delay="100">
            <div class="why-card">
              <div class="logo-chip mb-6">
                <span class="logo-seg logo-seg-light">
                  <img src={`${BASE_IMG_URL}/logo.png`} alt="SealSuite Logo" class="h-6 w-auto object-contain" loading="lazy" />
                </span>
                <span class="logo-seg logo-seg-dark">
                  <img src={`${BASE_IMG_URL}/virtuenet-logo-white.png`} alt="Virtuenet Logo" class="h-5 w-auto object-contain" loading="lazy" />
                </span>
              </div>

              <div class="mb-5">
                <h3 class="text-lg sm:text-xl font-extrabold text-gray-900 mb-1.5">Mengapa Virtuenet</h3>
                <p class="ss-sub">Mitra resmi SealSuite di Indonesia yang siap mendampingi Anda dari awal hingga akhir.</p>
              </div>

              <ul class="space-y-4">
                <li class="flex items-start gap-3.5">
                  <div class="why-icon"><i class="fi fi-br-users" style="font-size:1rem;"></i></div>
                  <div>
                    <div class="font-semibold text-gray-900 text-sm mb-0.5">Tim Lokal Berpengalaman &amp; Responsif</div>
                    <div class="text-xs text-gray-500 leading-relaxed">Dukungan dari tim yang memahami kebutuhan bisnis Indonesia</div>
                  </div>
                </li>
                <li class="flex items-start gap-3.5">
                  <div class="why-icon"><i class="fi fi-br-link" style="font-size:1rem;"></i></div>
                  <div>
                    <div class="font-semibold text-gray-900 text-sm mb-0.5">Integrasi Lintas Solusi</div>
                    <div class="text-xs text-gray-500 leading-relaxed">Lark, NetSuite, dan ekosistem digital lainnya</div>
                  </div>
                </li>
                <li class="flex items-start gap-3.5">
                  <div class="why-icon"><i class="fi fi-br-handshake" style="font-size:1rem;"></i></div>
                  <div>
                    <div class="font-semibold text-gray-900 text-sm mb-0.5">Pendampingan End-to-End</div>
                    <div class="text-xs text-gray-500 leading-relaxed">Dari pilot hingga scale-up, kami ada di setiap tahap</div>
                  </div>
                </li>
                <li class="flex items-start gap-3.5">
                  <div class="why-icon"><i class="fi fi-br-shield-check" style="font-size:1rem;"></i></div>
                  <div>
                    <div class="font-semibold text-gray-900 text-sm mb-0.5">Dukungan Aftersales &amp; Continuous Improvement</div>
                    <div class="text-xs text-gray-500 leading-relaxed">Purna jual terjamin untuk keamanan yang selalu up-to-date</div>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 6. LOGO PELANGGAN (2 baris, berwarna) */}
    <section class="customers-section py-20 sm:py-28 overflow-hidden" aria-label="Pelanggan SealSuite">
      <div class="mx-auto max-w-7xl px-6 lg:px-8 mb-10 sm:mb-12">
        <div class="text-center reveal">
          <h2 class="ss-h2">SealSuite Dipercaya oleh Perusahaan<br class="hidden sm:block" /> <span class="gradient-text">Terkemuka di Indonesia</span></h2>
        </div>
      </div>

      <div class="marquee-wrap relative w-full overflow-hidden reveal">
        <div class="marquee-fade marquee-fade-l"></div>
        <div class="marquee-fade marquee-fade-r"></div>

        {customerRows.map((row, rowIndex) => (
          <div class="marquee-row">
            <div class={`marquee-track animate-infinite-marquee${rowIndex % 2 === 1 ? ' is-reverse' : ''}`}>
              <div class="marquee-group">
                {row.map((logo) => (
                  <img class="customer-logo" src={logo} alt="Customer Logo" loading="lazy" />
                ))}
              </div>
              <div class="marquee-group" aria-hidden="true">
                {row.map((logo) => (
                  <img class="customer-logo" src={logo} alt="" loading="lazy" aria-hidden="true" />
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* 7. FAQ */}
    <section class="py-16 sm:py-24" aria-label="FAQ">
      <div class="mx-auto max-w-3xl px-6 lg:px-8">
        <div class="text-center mb-10 reveal">
          <h2 class="ss-h2">Pertanyaan yang Sering Diajukan</h2>
          <p class="ss-sub mt-3 max-w-md mx-auto">Jawaban atas pertanyaan umum seputar SealSuite dan implementasinya.</p>
        </div>

        <div class="space-y-3 reveal-stagger">
          {faqs.map((faq, i) => (
            <details class="faq-item group">
              <summary class="flex cursor-pointer items-center justify-between p-4 sm:p-5 select-none list-none">
                <div class="flex items-center gap-3.5">
                  <span class="faq-num">{i + 1}</span>
                  <span class="font-semibold text-gray-900 text-sm pr-3">{faq.q}</span>
                </div>
                <span class="faq-icon">
                  <i class="fi fi-br-plus" style="font-size:0.7rem; align-items:center;"></i>
                  <i class="fi fi-br-minus" style="font-size:0.7rem; align-items:center;"></i>
                </span>
              </summary>
              <div class="px-4 sm:px-5 pb-2">
                <div class="ml-10 text-gray-600 leading-relaxed text-sm border-t border-gray-100 pt-3.5 pb-3">
                  {faq.a}
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* 8. CTA */}
    <section id="contact" class="py-16 sm:py-24" aria-label="CTA">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="cta-box reveal">
          <div class="absolute inset-0 -z-10">
            <img
              src={`${BASE_IMG_URL}/it-management-solution.png`}
              alt=""
              class="w-full h-full object-cover"
              loading="lazy"
              aria-hidden="true"
            />
            <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(236,246,255,0.92) 55%, rgba(224,244,250,0.9) 100%);"></div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center p-8 sm:p-12 lg:p-14">
            <div>
              <div class="logo-chip mb-6">
                <span class="logo-seg logo-seg-light">
                  <img src={`${BASE_IMG_URL}/sealsuite-logo.png`} alt="SealSuite" class="h-6 w-auto object-contain" loading="lazy" />
                </span>
                <span class="logo-seg logo-seg-dark">
                  <img src={`${BASE_IMG_URL}/virtuenet-logo-white.png`} alt="Virtuenet" class="h-5 w-auto object-contain" loading="lazy" />
                </span>
