  @media (max-width: 1023px) {
    .pillar-stack-card { --stack-top: 96px; }
    .pillar-card-inner { grid-template-columns: minmax(260px, 0.4fr) minmax(0, 0.6fr); }
    .pillar-stack-content { padding: 1.5rem; }
    .pillar-stack-img { padding: 0.75rem; }
  }

  @media (max-width: 767px) {
    .pillar-stack-card {
      --stack-top: 88px;
      margin-bottom: 20vh;
      border-radius: 1.5rem;
      /* tinggi SAMA untuk semua card: kunci agar tertutup sempurna */
      height: max(520px, calc(100svh - var(--stack-top) - 16px));
    }

    .pillar-stack-card:last-child { margin-bottom: 0; }

    .pillar-next { border-radius: 1.5rem; }

    .pillar-card-inner {
      grid-template-columns: 1fr;
      grid-template-rows: auto minmax(0, 1fr);
    }

    .pillar-stack-content {
      grid-column: 1;
      grid-row: 1;
      min-height: 0;
      padding: 1.25rem 1.25rem 0.75rem;
      align-items: flex-start;
    }

    .pillar-content-inner { max-width: none; }
    .pillar-label { display: none; }
    .pillar-number { width: 34px; height: 34px; }
    .pillar-stack-title { font-size: 1.4rem; margin-bottom: 0.5rem; }
    .pillar-stack-desc { font-size: 0.82rem; margin-bottom: 0.75rem; }
    .pillar-feature-list { gap: 0.4rem; }
    .pillar-stack-feature { font-size: 0.78rem; }

    .pillar-stack-image {
      grid-column: 1;
      grid-row: 2;
      min-height: 0;
    }

    .pillar-stack-img { padding: 0.5rem; }

    .pillar-image-badge {
      top: 1rem;
      right: 1rem;
      font-size: 0.65rem;
      padding: 0.55rem 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pillar-stack-card {
      position: relative;
      top: auto;
      height: auto;
      margin-bottom: 1.5rem;
      transform: none !important;
    }
    .pillar-stack::after { display: none; }
    .pillar-next { margin-top: 0; box-shadow: none; }
    .pillar-card-inner { height: auto; }
    .pillar-stack-card.is-covered { visibility: visible; }
    .pillar-stack-img { transform: none !important; transition: none !important; }
    .pillar-stack-feature { opacity: 1 !important; transform: none !important; transition: none !important; }
  }

  /* ================================================================ */
  /* ZERO TRUST SHOWCASE (NESTED MASK & PARALLAX)                       */
  /* ================================================================ */
  #zt-wrapper {
    --card-reveal: 0;
    --card-parallax: 0;
    --zt-reveal: 0;
    --zt-parallax: 0;
    will-change: transform;
  }

  #zt-container, #zt-mask { will-change: clip-path, opacity, transform; }
  #zt-image { will-change: transform; }

  .js-zt-active #zt-wrapper {
    transform: translateY(calc(var(--card-parallax) * 50px));
  }

  .js-zt-active #zt-container {
    clip-path: inset(
      calc(10% * (1 - var(--card-reveal)))
      calc(5% * (1 - var(--card-reveal)))
      calc(10% * (1 - var(--card-reveal)))
      calc(5% * (1 - var(--card-reveal)))
      round calc(3rem - (1.5rem * (1 - var(--card-reveal))))
    );
    opacity: calc(0.3 + 0.7 * var(--card-reveal));
    transform: scale(calc(0.95 + 0.05 * var(--card-reveal)));
  }

  .js-zt-active #zt-mask {
    clip-path: inset(
      calc(15% * (1 - var(--zt-reveal)))
      calc(10% * (1 - var(--zt-reveal)))
      calc(15% * (1 - var(--zt-reveal)))
      calc(10% * (1 - var(--zt-reveal)))
      round calc(3rem * (1 - var(--zt-reveal)))
    );
    opacity: calc(0.25 + 0.75 * var(--zt-reveal));
  }

  .js-zt-active #zt-image {
    transform:
      scale(calc(1 + 0.1 * (1 - var(--zt-reveal))))
      translateY(calc(var(--zt-parallax) * 60px));
  }

  @media (max-width: 768px) {
    .js-zt-active #zt-wrapper {
      transform: translateY(calc(var(--card-parallax) * 20px));
    }
    .js-zt-active #zt-container {
      clip-path: inset(
        calc(5% * (1 - var(--card-reveal)))
        calc(2% * (1 - var(--card-reveal)))
        calc(5% * (1 - var(--card-reveal)))
        calc(2% * (1 - var(--card-reveal)))
        round 2rem
      );
    }
    .js-zt-active #zt-image {
      transform:
        scale(calc(1 + 0.08 * (1 - var(--zt-reveal))))
        translateY(calc(var(--zt-parallax) * 25px));
    }
    .js-zt-active #zt-mask {
      clip-path: inset(
        calc(10% * (1 - var(--zt-reveal)))
        calc(5% * (1 - var(--zt-reveal)))
        calc(10% * (1 - var(--zt-reveal)))
        calc(5% * (1 - var(--zt-reveal)))
        round 1.5rem
      );
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ===== SCROLL REVEAL =====
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -48px 0px' }
  );

  document
    .querySelectorAll<HTMLElement>('.reveal, .reveal-stagger')
    .forEach((el) => {
      const delay = el.dataset.delay;
      if (delay) el.style.setProperty('--delay', `${delay}ms`);
      if (el.classList.contains('reveal-stagger')) {
        Array.from(el.children).forEach((child, i) => {
          (child as HTMLElement).style.setProperty('--i', String(i));
        });
      }
      if (reduceMotion) el.classList.add('visible');
      else observer.observe(el);
    });

  // ===== SPOTLIGHT ON BUTTONS =====
  document.querySelectorAll<HTMLElement>('.btn-fx').forEach((btn) => {
    btn.addEventListener('pointermove', (e: PointerEvent) => {
      if (e.pointerType !== 'mouse') return;
      const r = btn.getBoundingClientRect();
      btn.style.setProperty('--mx', `${e.clientX - r.left}px`);
      btn.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });

  // ===== HERO (carousel + reveal + parallax) =====
  (() => {
    const root = document.querySelector<HTMLElement>('[data-carousel]');
    if (!root) return;

    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const bgs = Array.from(root.querySelectorAll<HTMLElement>('[data-bg]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const total = slides.length;
    const INTERVAL = 7000;

    let index = 0;
    let timer: number | undefined;
    let hovering = false;
    let focused = false;
    let visible = true;

    const go = (i: number) => {
      index = (i + total) % total;
      slides.forEach((s, n) => {
        const active = n === index;
        s.classList.toggle('is-active', active);
        s.setAttribute('aria-hidden', String(!active));
        s.toggleAttribute('inert', !active);
      });
      bgs.forEach((b, n) => b.classList.toggle('is-active', n === index));
      dots.forEach((d, n) => {
        d.classList.toggle('is-active', n === index);
        d.setAttribute('aria-current', String(n === index));
      });
    };

    const stopTimer = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };
    const refreshAutoplay = () => {
      stopTimer();
      const run = !reduceMotion && !hovering && !focused && visible && !document.hidden;
      if (run) timer = window.setInterval(() => go(index + 1), INTERVAL);
    };
    const manual = (i: number) => { go(i); refreshAutoplay(); };

    dots.forEach((d, n) => d.addEventListener('click', () => manual(n)));

    root.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { hovering = true; refreshAutoplay(); } });
    root.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') { hovering = false; refreshAutoplay(); } });
    root.addEventListener('focusin', () => { focused = true; refreshAutoplay(); });
    root.addEventListener('focusout', () => { focused = false; refreshAutoplay(); });
    document.addEventListener('visibilitychange', refreshAutoplay);

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') manual(index - 1);
      if (e.key === 'ArrowRight') manual(index + 1);
    });

    let startX = 0;
    let tracking = false;
    root.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      startX = e.clientX;
      tracking = true;
    });
    root.addEventListener('pointerup', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 50) manual(dx < 0 ? index + 1 : index - 1);
    });
    root.addEventListener('pointercancel', () => { tracking = false; });

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      root.classList.toggle('is-offscreen', !visible);
      refreshAutoplay();
    }).observe(root);

    go(0);
    refreshAutoplay();

    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.add('is-ready')));

    if (reduceMotion) return;

    let tx = 0, ty = 0;
    let cx = 0, cy = 0;
    let mouseRaf = 0;
    let scrollQueued = false;
    let heroH = root.offsetHeight;

    const mouseTick = () => {
      mouseRaf = 0;
      cx += (tx - cx) * 0.08;
      cy += (ty - cy) * 0.08;
      root.style.setProperty('--nx', cx.toFixed(4));
      root.style.setProperty('--ny', cy.toFixed(4));
      if (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001) {
        mouseRaf = requestAnimationFrame(mouseTick);
      }
    };
    const requestMouse = () => { if (!mouseRaf) mouseRaf = requestAnimationFrame(mouseTick); };

    root.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = root.getBoundingClientRect();
      tx = Math.max(-1, Math.min(1, ((e.clientX - r.left) / r.width - 0.5) * 2));
      ty = Math.max(-1, Math.min(1, ((e.clientY - r.top) / r.height - 0.5) * 2));
      requestMouse();
    });
    root.addEventListener('pointerleave', () => { tx = 0; ty = 0; requestMouse(); });

    const updateScroll = () => {
      scrollQueued = false;
      if (!visible && window.scrollY > heroH) return;
      const p = Math.min(Math.max(window.scrollY / heroH, 0), 1);
      const fo = p <= 0.5 ? 1 - 0.4 * p : 0.8 - 1.6 * (p - 0.5);
      root.style.setProperty('--sp', p.toFixed(4));
      root.style.setProperty('--fo', Math.max(fo, 0).toFixed(3));
    };
    window.addEventListener('scroll', () => {
      if (scrollQueued) return;
      scrollQueued = true;
      requestAnimationFrame(updateScroll);
    }, { passive: true });
    window.addEventListener('resize', () => { heroH = root.offsetHeight; updateScroll(); }, { passive: true });
    updateScroll();

    root.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((btn) => {
      btn.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        const r = btn.getBoundingClientRect();
        const dx = (e.clientX - (r.left + r.width / 2)) / (r.width / 2);
        const dy = (e.clientY - (r.top + r.height / 2)) / (r.height / 2);
        btn.style.translate = `${(dx * 4).toFixed(2)}px ${(dy * 3).toFixed(2)}px`;
      });
      btn.addEventListener('pointerleave', () => { btn.style.translate = ''; });
    });
  })();

  // ================================================================
  // 4 PILAR — TRUE STICKY STACKING CARDS
  // ================================================================
  (() => {
    const stack = document.querySelector<HTMLElement>('[data-pillar-stack]');
    if (!stack) return;

    const cards = Array.from(
      stack.querySelectorAll<HTMLElement>('[data-pillar-card]')
    );
    if (!cards.length) return;

    // Section yang menimpa card terakhir
    const nextSection = document.querySelector<HTMLElement>('[data-pillar-next]');

    cards.forEach((card, index) => {
      card.style.zIndex = String(10 + index);
    });

    if (reduceMotion) {
      cards.forEach((card) => {
        card.classList.add('is-active');
        card.style.opacity = '1';
        card.style.transform = 'none';
        card.style.setProperty('--pillar-image-y', '0px');
      });
      return;
    }

    const clamp = (value: number, min: number, max: number) =>
      Math.min(max, Math.max(min, value));

    let activeIndex = 0;
    let ticking = false;

    // Ambil dari CSS (--stack-top) supaya selalu sinkron dengan media query
    const getStickyTop = () =>
      parseFloat(getComputedStyle(cards[0]).getPropertyValue('--stack-top')) || 104;

    const updateStack = () => {
      ticking = false;

      const viewportH = window.innerHeight;
      const stickyTop = getStickyTop();

      let detectedIndex = 0;
      let closestDistance = Infinity;

      cards.forEach((card, index) => {
        const rect = card.getBoundingClientRect();

        if (rect.top <= stickyTop + 8) {
          const distance = Math.abs(rect.top - stickyTop);

          if (distance < closestDistance) {
            closestDistance = distance;
            detectedIndex = index;
          }
        }
      });

      activeIndex = detectedIndex;

      cards.forEach((card, index) => {
        const rect = card.getBoundingClientRect();
        const isLast = index === cards.length - 1;

        card.style.transform = 'none';
        card.style.opacity = '1';
        card.classList.toggle('is-active', index === activeIndex);

        // Tertutup penuh:
        // - card 1-3: card berikutnya sudah menempel di posisi sticky
        // - card 4  : section berikutnya sudah naik sampai atas card
        let covered = false;
        if (!isLast) {
          covered = cards[index + 1].getBoundingClientRect().top <= stickyTop + 1;
        } else if (nextSection) {
          covered = nextSection.getBoundingClientRect().top <= stickyTop + 1;
        }
        card.classList.toggle('is-covered', covered);

        // Parallax halus hanya pada gambar
        const imageProgress = clamp(
          (viewportH * 0.75 - rect.top) / (viewportH * 0.75),
          0,
          1
        );

        card.style.setProperty(
          '--pillar-image-y',
          `${((0.5 - imageProgress) * 12).toFixed(2)}px`
        );
      });
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateStack);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    window.addEventListener('load', requestUpdate, { once: true });

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(requestUpdate);
      resizeObserver.observe(stack);
    }

    requestUpdate();
  })();

  // ===== ZERO TRUST NESTED MASK & PARALLAX SCROLL-DRIVEN =====
  (() => {
    const ztWrapper = document.getElementById('zt-wrapper');
    const ztContainer = document.getElementById('zt-container');
    const ztMask = document.getElementById('zt-mask');
    const ztImage = document.getElementById('zt-image');

    if (!ztWrapper || !ztContainer || !ztMask || !ztImage || reduceMotion) return;

    ztWrapper.classList.add('js-zt-active');

    let isQueued = false;

    const updateZT = () => {
      isQueued = false;
      const windowH = window.innerHeight;
      const wrapperRect = ztWrapper.getBoundingClientRect();

      if (wrapperRect.top > windowH + 200 || wrapperRect.bottom < -200) return;

      // 1. CARD ANIMATION
      const cardRevealStart = windowH * 0.95;
      const cardRevealEnd = windowH * 0.50;
      const cardRevealP = Math.max(0, Math.min(1, (cardRevealStart - wrapperRect.top) / (cardRevealStart - cardRevealEnd)));

      const cardCenterOffset = (wrapperRect.top + wrapperRect.height / 2) - (windowH / 2);
      const cardParallaxP = cardCenterOffset / (windowH / 2 + wrapperRect.height / 2);

      ztWrapper.style.setProperty('--card-reveal', cardRevealP.toFixed(3));
      ztWrapper.style.setProperty('--card-parallax', cardParallaxP.toFixed(3));

      // 2. IMAGE ANIMATION
      const maskRect = ztMask.getBoundingClientRect();
      const imgRevealStart = windowH * 0.85;
      const imgRevealEnd = windowH * 0.40;
      const imgRevealP = Math.max(0, Math.min(1, (imgRevealStart - maskRect.top) / (imgRevealStart - imgRevealEnd)));

      const imgCenterOffset = (maskRect.top + maskRect.height / 2) - (windowH / 2);
      const imgParallaxP = imgCenterOffset / (windowH / 2 + maskRect.height / 2);

      ztWrapper.style.setProperty('--zt-reveal', imgRevealP.toFixed(3));
      ztWrapper.style.setProperty('--zt-parallax', imgParallaxP.toFixed(3));
    };

    window.addEventListener('scroll', () => {
      if (!isQueued) {
        isQueued = true;
        requestAnimationFrame(updateZT);
      }
    }, { passive: true });

    window.addEventListener('resize', () => requestAnimationFrame(updateZT), { passive: true });

    updateZT();
  })();
</script>