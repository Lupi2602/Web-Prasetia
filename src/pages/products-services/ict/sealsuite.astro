  }
  .ss-sub { font-size: 0.9rem; line-height: 1.7; color: #64748b; }
  @media (min-width: 640px) { .ss-sub { font-size: 0.95rem; } }

  .gradient-text {
    background: linear-gradient(135deg, var(--ss-blue), var(--ss-teal));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .ss-eyebrow {
    display: inline-flex; align-items: center; gap: 0.45rem; max-width: 100%;
    padding: 0.35rem 0.85rem; border-radius: 999px;
    background: rgba(0, 106, 255, 0.08); border: 1px solid rgba(0, 106, 255, 0.15);
    color: var(--ss-blue);
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
  }

  /* HERO: versi terang, menyatu dengan warna halaman (#f4f9ff) */
  .ss-hero {
    --sp: 0; --fo: 1;
    position: relative; overflow: hidden; isolation: isolate;
    display: flex; flex-direction: column; justify-content: center;
    min-height: clamp(600px, 92svh, 860px);
