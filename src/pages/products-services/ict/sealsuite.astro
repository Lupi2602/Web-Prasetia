  </div>
</MainLayout>

<style is:global>
  /* ===== COLOR PALETTE ===== */
  :root {
    --ss-blue: #006aff;
    --ss-cyan: #00e5e5;
    --ss-dark: #001a40;
  }

  /* Background halaman: warna di belakang sudut radius & margin section 5 */
  .ss-page {
    background: #f4f9ff;
  }

  /* ===== GRADIENT TEXT ===== */
  .gradient-text {
    background: linear-gradient(135deg, var(--ss-blue), var(--ss-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ================================================================ */
  /* HERO                                                              */
  /* ================================================================ */
  .ss-hero {
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --nx: 0; --ny: 0; --sp: 0; --fo: 1;
    --m: 1; --sm: 1;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: max(100svh, 680px);
    background: #001a40;
    color: #fff;
    touch-action: pan-y;
  }
  @media (max-height: 560px) { .ss-hero { min-height: 760px; } }
  @media (max-width: 1023px) { .ss-hero { --m: 0.5; --sm: 0.6; } }
  @media (max-width: 767px)  { .ss-hero { --m: 0;   --sm: 0.4; } }

  .ss-bgs { position: absolute; inset: 0; z-index: 0; }
  .ss-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    transform: scale(1.03);
    transition: opacity 1s ease, transform 1.6s var(--ease);
  }
  .ss-bg.is-active { opacity: 1; transform: none; }
  .ss-bg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
    transform: translate3d(calc(var(--nx) * 12px * var(--m)), calc(var(--ny) * 8px * var(--m) + var(--sp) * 60px * var(--sm)), 0) scale(calc(1.06 + var(--sp) * 0.05 * var(--sm)));
  }
  .ss-overlay { position: absolute; inset: 0; }
  .ss-overlay-1 { background: linear-gradient(180deg, transparent 65%, rgba(0, 26, 64, 0.55) 100%), linear-gradient(90deg, rgba(0, 26, 64, 0.92) 0%, rgba(0, 26, 64, 0.72) 45%, rgba(0, 26, 64, 0.22) 100%); }
  .ss-overlay-2 { background: linear-gradient(180deg, transparent 65%, rgba(0, 26, 64, 0.55) 100%), linear-gradient(90deg, rgba(0, 26, 64, 0.95) 0%, rgba(0, 26, 64, 0.78) 50%, rgba(0, 26, 64, 0.4) 100%); }
  @media (max-width: 767px) { .ss-overlay-1, .ss-overlay-2 { background: rgba(0, 26, 64, 0.82); } }

  .ss-slides { position: absolute; inset: 0; z-index: 2; }
  .ss-slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding-top: 5rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: scale(1.02);
    transition: opacity 0.9s ease, transform 1.4s var(--ease), visibility 0s linear 0.9s;
  }
  .ss-slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    transition-delay: 0s;
  }

  .ss-fg {
    width: 100%;
    opacity: var(--fo);
    will-change: transform, opacity;
    transform: translate3d(calc(var(--nx) * -4px * var(--m)), calc(var(--ny) * -3px * var(--m) + var(--sp) * -60px * var(--sm)), 0) scale(calc(1 - var(--sp) * 0.04 * var(--sm)));
  }

  .hr-h1 { font-size: clamp(1.9rem, 3.6vw, 3.25rem); font-weight: 800; line-height: 1.12; letter-spacing: -0.02em; max-width: 18em; }
  .hr-h2 { font-size: clamp(1.6rem, 3vw, 2.5rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.015em; }
  .hr-lead { font-size: clamp(0.95rem, 1.1vw, 1.1rem); line-height: 1.65; color: rgba(219, 234, 254, 0.85); max-width: 36rem; }

  .js .ss-slide .hr-item { opacity: 0; transform: translate3d(0, 40px, 0); transition: opacity 0.3s ease, transform 0.3s ease; }
  .js .ss-slide .hr-title { clip-path: inset(0 0 100% 0); transition: opacity 0.3s ease, transform 0.3s ease, clip-path 0.3s ease; }
  .js .ss-hero.is-ready .ss-slide.is-active .hr-item { opacity: 1; transform: none; transition: opacity 0.9s var(--ease) var(--d, 0ms), transform 1s var(--ease) var(--d, 0ms); }
  .js .ss-hero.is-ready .ss-slide.is-active .hr-title { clip-path: inset(-10% -5% -10% -5%); transition: opacity 0.9s var(--ease) var(--d, 0ms), transform 1s var(--ease) var(--d, 0ms), clip-path 1.1s var(--ease) var(--d, 0ms); }

  .hr-decor { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .hr-layer { position: absolute; inset: -40px; will-change: transform; transform: translate3d(calc(var(--nx) * var(--k) * 12px * var(--m)), calc(var(--ny) * var(--k) * 8px * var(--m) + var(--sp) * var(--s) * 1px * var(--sm)), 0); }
  .hr-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px); background-size: 64px 64px; -webkit-mask-image: radial-gradient(ellipse at 70% 40%, #000 0%, transparent 65%); mask-image: radial-gradient(ellipse at 70% 40%, #000 0%, transparent 65%); }
  .hr-orb { position: absolute; border-radius: 50%; }
  .hr-orb-blue { width: 38vw; max-width: 520px; aspect-ratio: 1; left: -6%; bottom: -12%; background: radial-gradient(circle, rgba(0, 106, 255, 0.5), transparent 70%); animation: hr-float-a 10s ease-in-out infinite alternate; }
  .hr-orb-cyan { width: 26vw; max-width: 380px; aspect-ratio: 1; right: 6%; top: 10%; background: radial-gradient(circle, rgba(0, 229, 229, 0.3), transparent 70%); animation: hr-float-b 8s ease-in-out infinite alternate; }
  .hr-ring { position: absolute; right: 14%; bottom: 20%; width: 220px; height: 220px; border-radius: 50%; border: 1px solid; border-color: rgba(0, 229, 229, 0.25) rgba(0, 229, 229, 0.25) transparent transparent; animation: hr-float-c 10s ease-in-out infinite alternate; }
  .hr-line { position: absolute; right: 10%; top: 48%; width: 180px; height: 1px; background: linear-gradient(90deg, transparent, rgba(0, 229, 229, 0.4), transparent); transform: rotate(-25deg); animation: hr-float-b 6s ease-in-out infinite alternate; }
  .hr-node { position: absolute; width: 6px; height: 6px; border-radius: 50%; background: #00e5e5; box-shadow: 0 0 14px 2px rgba(0, 229, 229, 0.45); opacity: 0.7; }
  .hr-node-1 { top: 24%; right: 28%; animation: hr-float-b 6s ease-in-out infinite alternate; }
  .hr-node-2 { top: 62%; right: 18%; animation: hr-float-a 8s ease-in-out infinite alternate; }
  .hr-node-3 { top: 40%; right: 7%; animation: hr-float-c 10s ease-in-out infinite alternate; }

  @keyframes hr-float-a { from { transform: translate3d(0, 0, 0) scale(1); } to { transform: translate3d(14px, -22px, 0) scale(1.05); } }
  @keyframes hr-float-b { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(-12px, 16px, 0); } }
  @keyframes hr-float-c { from { transform: translate3d(0, 0, 0) rotate(-8deg); } to { transform: translate3d(8px, -14px, 0) rotate(10deg); } }
  .ss-hero.is-offscreen .hr-decor * { animation-play-state: paused; }

  @media (max-width: 767px) { .hr-grid, .hr-ring, .hr-line, .hr-node { display: none; } .hr-orb { animation-duration: 14s; } }

  .ss-dot { position: relative; width: 10px; height: 10px; border-radius: 9999px; background: rgba(255, 255, 255, 0.35); transition: width 0.4s var(--ease), background 0.3s ease; }
  .ss-dot::after { content: ""; position: absolute; inset: -12px -6px; }
  .ss-dot.is-active { width: 28px; background: var(--ss-cyan); }

  .ss-hero .btn-fx, .ss-hero .btn-fx:hover, .ss-hero .btn-fx:active { transform: none !important; translate: none !important; transition: none !important; }
  .ss-hero .btn-fx::before { display: none; }
  .ss-hero .btn-fx .btn-arrow, .ss-hero .btn-fx:hover .btn-arrow { transform: none !important; transition: none !important; }
  .ss-hero .btn-ghost { transition: none; }

  /* ===== MARQUEE LOGO ===== */
  @keyframes infinite-marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  /* logo lebih besar = track lebih panjang, jadi durasi dinaikkan agar kecepatan tetap nyaman */
  .animate-infinite-marquee { animation: infinite-marquee 60s linear infinite; width: max-content; }

  @media (max-width: 767px) {
    .animate-infinite-marquee { animation-duration: 50s; }
  }

  /* ===== SCROLL REVEAL ===== */
  .js .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1), transform 0.65s cubic-bezier(0.22, 1, 0.36, 1); transition-delay: var(--delay, 0ms); }
  .js .reveal.visible { opacity: 1; transform: none; }
  .js .reveal-stagger > * { opacity: 0; transform: translateY(20px); transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease; }
  .js .reveal-stagger.visible > * { opacity: 1; transform: none; transition-delay: calc(var(--i, 0) * 75ms), calc(var(--i, 0) * 75ms), 0ms; }

  /* ===== CARD HOVER ===== */
  .card-hover:hover { box-shadow: 0 12px 28px -10px rgba(0, 0, 0, 0.16); }

  /* ===== BUTTONS ===== */
  .btn-fx { position: relative; overflow: hidden; isolation: isolate; transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s ease, background-color 0.25s ease; }
  .btn-fx:hover { transform: translateY(-2px); }
  .btn-fx:active { transform: translateY(0) scale(0.98); }
  .btn-primary { background: linear-gradient(135deg, #006aff, #004ecc); box-shadow: 0 4px 16px rgba(0, 106, 255, 0.35); }
  .btn-primary:hover { background: linear-gradient(135deg, #005ce0, #003fb5); box-shadow: 0 8px 24px rgba(0, 106, 255, 0.5); }
  .btn-cyan { background: linear-gradient(135deg, #00e5e5, #00b8b8); box-shadow: 0 4px 16px rgba(0, 229, 229, 0.3); color: #001a40 !important; }
  .btn-cyan:hover { background: linear-gradient(135deg, #00c8c8, #009e9e); box-shadow: 0 8px 24px rgba(0, 229, 229, 0.45); }
  .btn-fx::before { content: ""; position: absolute; inset: 0; z-index: -1; background: radial-gradient(80px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 255, 255, 0.2), transparent 70%); opacity: 0; transition: opacity 0.25s ease; pointer-events: none; }
  .btn-fx:hover::before { opacity: 1; }
  .btn-primary .btn-arrow, .btn-cyan .btn-arrow { display: inline-flex; align-items: center; transform: rotate(-45deg); transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
  .btn-fx:hover .btn-arrow { transform: rotate(0deg) translateX(3px); }

  /* ===== CERT CARD ===== */
  .cert-card { min-height: 110px; cursor: default; }

  /* ===== FAQ icon toggle ===== */
  details[open] .fi-br-plus { display: none !important; }
  details[open] .fi-br-minus { display: flex !important; }
  details:not([open]) .fi-br-minus { display: none !important; }
  details:not([open]) .fi-br-plus { display: flex !important; }

  /* ===== TOUCH: no sticky hover ===== */
  @media (hover: none) {
    .btn-fx:hover { transform: none; box-shadow: none; }
    .btn-fx:hover::before { display: none; }
  }

  /* ===== REDUCE MOTION ===== */
  @media (prefers-reduced-motion: reduce) {
    .js .reveal, .js .reveal-stagger > * { opacity: 1 !important; transform: none !important; transition: none !important; }
    .animate-infinite-marquee { animation: none; }
    .btn-fx, .btn-fx:hover, .btn-fx:active { transform: none !important; transition: none !important; }
    .btn-primary .btn-arrow, .btn-cyan .btn-arrow { transition: none; }
    .js .ss-slide .hr-item, .js .ss-slide .hr-title { opacity: 1 !important; transform: none !important; clip-path: none !important; transition: none !important; }
    .ss-bg img, .ss-fg, .hr-layer { transform: none !important; }
    .ss-bg, .ss-slide { transform: none !important; transition: opacity 0.4s ease !important; }
    .hr-decor * { animation: none !important; }
    .ss-hero .btn-fx { translate: none !important; }
  }

  /* ================================================================ */
  /* 4 PILAR — TRUE STICKY STACKING CARDS                             */
  /* ================================================================ */

  .pillar-stack-section {
    --dwell: 100svh;               /* lama card 4 tetap menempel sebelum ditimpa section berikutnya */
    position: relative;
    z-index: 10;
    overflow: clip;
    padding-bottom: 0 !important;  /* ruang bawah dipindah ke spacer .pillar-stack::after */
  }

  .pillar-stack {
    position: relative;
  }

  /*
    Spacer di DALAM .pillar-stack.
    Padding tidak memperpanjang area sticky, tetapi elemen di dalam content box memperpanjangnya.
    Jadi card 4 tetap sticky selama tinggi spacer ini.
  */
  .pillar-stack::after {
    content: "";
    display: block;
    height: var(--dwell);
    pointer-events: none;
  }

  .pillar-stack-card {
    --stack-top: 104px;
    position: sticky;
    top: var(--stack-top);
    z-index: calc(10 + var(--stack-index));
    margin-bottom: 30vh;
    /* tinggi ikut layar: maksimal 580px, minimal 440px */
    height: max(440px, min(580px, calc(100svh - var(--stack-top) - 24px)));
    min-height: 0;
    background: #ffffff;
    transform: none !important;
    opacity: 1 !important;
    isolation: isolate;
    overflow: hidden;
    border-radius: 2rem;
    border: 0;
    box-shadow: 0 -12px 40px -20px rgba(0,26,64,0.25);
  }

  .pillar-stack-card:last-child { margin-bottom: 0; }

  .pillar-stack-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #ffffff;
    border-radius: inherit;
    pointer-events: none;
  }

  .pillar-stack-card::after { display: none; }

  /* card yang sudah tertutup penuh disembunyikan agar tidak ada tepi yang bocor */
  .pillar-stack-card.is-covered { visibility: hidden; }

  /* Section setelah 4 Pilar: naik dan menutupi card 4 */
  .pillar-next {
    position: relative;
    z-index: 20;                                /* di atas .pillar-stack-section (z-index 10) */
    margin-top: calc(-1 * 100svh);              /* harus sama dengan --dwell */
    margin-inline: clamp(0.75rem, 2vw, 2rem);   /* margin kiri dan kanan */
    margin-bottom: 2rem;
    border-radius: 2.5rem;                      /* atas dan bawah */
    box-shadow: 0 -24px 60px -20px rgba(0, 26, 64, 0.35);
  }

  .pillar-card-inner {
    display: grid;
    grid-template-columns: minmax(300px, 0.36fr) minmax(0, 0.64fr);
    height: 100%;
    min-height: 0;
    width: 100%;
  }

  .pillar-stack-content {
    position: relative;
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 2.5rem;
    overflow: hidden;
  }

  .pillar-content-inner {
    width: 100%;
    max-width: 420px;
    position: relative;
    z-index: 2;
  }

  .pillar-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .pillar-number {
    width: 42px;
    height: 42px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    box-shadow: 0 8px 20px rgba(0,106,255,0.2);
  }

  .pillar-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
