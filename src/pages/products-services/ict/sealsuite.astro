  }

  .pillar-stack-image {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #eef3f8 0%, #f8fafc 50%, #e9f0f7 100%);
  }

  .pillar-stack-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    padding: 1rem;
    background: transparent;
    transform: translate3d(0, var(--pillar-image-y, 0px), 0);
    transform-origin: center center;
    will-change: transform;
    transition: transform 0.15s linear;
