---
import MainLayout from '../../../layouts/MainLayout.astro';

const BASE_IMG_URL = "/images/reference/ICT/sealsuite";

const customers = [
  `${BASE_IMG_URL}/customer-1.png`,
  `${BASE_IMG_URL}/customer-2.png`,
  `${BASE_IMG_URL}/customer-3.png`,
  `${BASE_IMG_URL}/customer-4.png`,
  `${BASE_IMG_URL}/customer-5.png`,
  `${BASE_IMG_URL}/customer-6.png`,
  `${BASE_IMG_URL}/customer-7.png`,
];

const certifications = [
  { name: "SOC 2 Type I — AICPA", img: "soc2-aicpa.png" },
  { name: "ISO 9001:2015", img: "iso-27001.png" },
  { name: "ISO/IEC 27701:2019", img: "iso-27001.png" },
  { name: "ISO/IEC 27017:2015", img: "iso-27001.png" },
  { name: "ISO/IEC 20000-1:2018", img: "iso-27001.png" },
  { name: "ISO/IEC 27001:2022", img: "iso-27001.png" },
  { name: "ISO 22301:2019", img: "iso-27001.png" },
  { name: "Data Protection Assured", img: "data-protection-assured.png" },
  { name: "APEC Cross Border Privacy Rules System Singapore", img: "apec-cross-border-privacy.png" },
  { name: "APEC Privacy Recognition for Processors System Singapore", img: "apec-privacy-processors.png" },
];

const faqs = [
  {
    q: "Apa perbedaan SealSuite dengan solusi keamanan tradisional?",
    a: "SealSuite menerapkan arsitektur Zero Trust yang tidak hanya mengamankan batas jaringan, tetapi memverifikasi setiap identitas dan perangkat secara dinamis sebelum memberikan akses."
  },
  {
    q: "Apakah cocok untuk perusahaan multi-cabang?",
    a: "Sangat cocok. Dengan manajemen cloud terpusat, Anda dapat memantau dan menerapkan kebijakan keamanan yang sama ke seluruh cabang tanpa perangkat keras tambahan di setiap lokasi."
  },
  {
    q: "Bagaimana proses implementasi & estimasi waktunya?",
    a: "Implementasi dimulai dari fase konsultasi, diikuti konfigurasi dan pilot testing sebelum go-live. Waktu implementasi bervariasi bergantung pada skala dan kompleksitas lingkungan perusahaan Anda."
  },
  {
    q: "Apakah ada uji coba/demo?",
    a: "Ya, kami menyediakan sesi demo gratis dan konsultasi awal untuk memahami kecocokan SealSuite dengan kebutuhan bisnis Anda."
  },
  {
    q: "Bagaimana langkah awal untuk mulai?",
    a: "Silakan isi formulir di bagian bawah halaman ini, dan tim konsultan kami akan segera menghubungi Anda untuk menjadwalkan diskusi lebih lanjut."
  }
];

const pillars = [
  {
    title: "Identity & Access Management",
    desc: "Satu sistem untuk kelola identitas, Single Sign-On, dan hak akses yang lebih aman dan efisien.",
    features: [
      "Single sign-on & provisioning otomatis",
      "Role-based access & audit trail",
      "Integrasi ke berbagai aplikasi kerja modern"
    ],
    img: "iam-product.png",
    color: "from-[#006aff]/10 to-[#00e5e5]/10",
    iconColor: "text-[#006aff]",
    accentColor: "bg-[#006aff]",
  },
  {
    title: "Endpoint Management & Security",
    desc: "Amankan perangkat kerja dengan MDM, DLP, dan firewall untuk perlindungan menyeluruh.",
    features: [
      "Perangkat selalu terpantau agar mengikuti standar keamanan",
      "Proteksi ancaman & penegakan kebijakan",
      "Device control (USB, clipboard, dll.)"
    ],
    img: "endpoint-product.png",
    color: "from-[#00e5e5]/10 to-[#006aff]/10",
    iconColor: "text-[#00e5e5]",
    accentColor: "bg-[#00e5e5]",
  },
  {
    title: "Network Management & Security",
    desc: "Kontrol akses jaringan, VPN, dan SD-WAN untuk konektivitas aman dan efisien.",
    features: [
      "Koneksi aman antar lokasi",
      "Kontrol akses jaringan",
      "Manajemen Wi-Fi perusahaan"
    ],
    img: "network-product.png",
    color: "from-[#006aff]/10 to-[#00e5e5]/10",
    iconColor: "text-[#006aff]",
    accentColor: "bg-[#006aff]",
  },
  {
    title: "SaaS Protection",
    desc: "Amankan aplikasi cloud dan AI untuk melindungi data bisnis dari ancaman terkini.",
    features: [
      "Data Loss Prevention untuk browser",
      "Kontrol penggunaan AI generatif",
      "Monitor konfigurasi aplikasi SaaS"
    ],
    img: "saas-product.png",
    color: "from-[#00e5e5]/10 to-[#006aff]/10",
    iconColor: "text-[#00e5e5]",
    accentColor: "bg-[#00e5e5]",
  }
];
---

<MainLayout title="SealSuite | PT Prasetia Dwidharma" transparentNavbar={true}>

  <!-- Tandai JS aktif sedini mungkin -->
  <script is:inline>document.documentElement.classList.add('js');</script>

  <!-- Flaticon CSS: Bold Rounded Icons -->
  <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/2.6.0/uicons-bold-rounded/css/uicons-bold-rounded.css" />
  <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/2.6.0/uicons-solid-rounded/css/uicons-solid-rounded.css" />

  <div class="ss-page">

    <!-- ================================================================ -->
    <!-- 1. HERO — Premium Enterprise                                      -->
    <!-- ================================================================ -->
    <section class="ss-hero" aria-label="Hero" aria-roledescription="carousel" data-carousel>

      <!-- Layer 0: Background visual (parallax + crossfade) -->
      <div class="ss-bgs" aria-hidden="true">
        <div class="ss-bg is-active" data-bg>
          <img src={`${BASE_IMG_URL}/logo-sealsuite.jpg`} alt="" fetchpriority="high" decoding="async" />
          <div class="ss-overlay ss-overlay-1"></div>
        </div>
        <div class="ss-bg" data-bg>
          <img src={`${BASE_IMG_URL}/forrester-report.png`} alt="" loading="lazy" decoding="async" />
          <div class="ss-overlay ss-overlay-2"></div>
        </div>
      </div>

      <!-- Layer 1: Floating decorative elements -->
      <div class="hr-decor" aria-hidden="true">
        <div class="hr-layer" style="--k:0.6; --s:20;">
          <div class="hr-grid"></div>
          <span class="hr-orb hr-orb-blue"></span>
        </div>
        <div class="hr-layer" style="--k:1.2; --s:40;">
          <span class="hr-orb hr-orb-cyan"></span>
          <span class="hr-ring"></span>
        </div>
        <div class="hr-layer" style="--k:2; --s:70;">
          <span class="hr-line"></span>
          <span class="hr-node hr-node-1"></span>
          <span class="hr-node hr-node-2"></span>
          <span class="hr-node hr-node-3"></span>
        </div>
      </div>

      <!-- Layer 2: Slides (konten) -->
      <div class="ss-slides">

        <!-- Slide 1 -->
        <div class="ss-slide is-active" data-slide aria-roledescription="slide" aria-label="1 dari 2">
          <div class="ss-fg">
            <div class="mx-auto max-w-7xl px-6 lg:px-8 w-full py-16 lg:py-24">
              <div class="max-w-3xl">
                <h1 class="hr-item hr-title hr-h1 mb-5" style="--d:150ms;">
                  SealSuite: All-in-One IT Governance &amp; Security Platform
                </h1>
                <p class="hr-item hr-lead" style="--d:350ms;">
                  untuk Amankan Identitas, Perangkat, dan Jaringan Perusahaan
                </p>
                <div class="hr-item mt-8 flex flex-wrap items-center gap-4" style="--d:500ms;">
                  <a href="#zero-trust" data-magnetic
                    class="btn-fx btn-primary inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-semibold text-white shadow-lg">
                    Pelajari Lebih Lanjut
                    <span class="btn-arrow">
                      <i class="fi fi-br-arrow-right" style="font-size:0.85rem; line-height:1; display:flex; align-items:center;"></i>
                    </span>
                  </a>
                  <a href="#contact"
                    class="btn-ghost inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-semibold text-white border border-white/30 hover:border-[#00e5e5] hover:text-[#00e5e5] hover:bg-white/10 transition-colors duration-300">
                    <i class="fi fi-br-play" style="font-size:0.85rem; line-height:1; display:flex; align-items:center;"></i>
                    Minta Demo
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Slide 2 -->
        <div class="ss-slide" data-slide inert aria-roledescription="slide" aria-label="2 dari 2">
          <div class="ss-fg">
            <div class="mx-auto max-w-7xl px-6 lg:px-8 w-full py-16 lg:py-24">
              <div class="max-w-2xl">
                <h2 class="hr-item hr-title hr-h2 mb-4" style="--d:150ms;">
                  Forrester Thought Leadership Paper
                </h2>
                <p class="hr-item hr-lead mb-7" style="--d:350ms;">
                  SealSuite has commissioned Forrester Consulting to develop a thought leadership paper on how zero trust enables security platforms mitigate data breaches, build trust and drive growth.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Indikator slide (dots) -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex items-center gap-3" aria-label="Pilih slide">
        <button type="button" class="ss-dot is-active" data-dot="0" aria-label="Slide 1" aria-current="true"></button>
        <button type="button" class="ss-dot" data-dot="1" aria-label="Slide 2" aria-current="false"></button>
      </div>
    </section>

    <!-- ================================================================ -->
    <!-- 2. CERTIFICATION & CREDENTIALS                                    -->
    <!-- ================================================================ -->
    <section class="py-16 sm:py-20 border-b border-gray-100" style="background:#f4f9ff;" aria-label="Sertifikasi dan Kredensial">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6 reveal-stagger">
          {certifications.map((cert) => (
            <div class="cert-card flex flex-col items-center justify-center p-4 rounded-2xl bg-white border border-blue-100 hover:border-[#006aff]/30 hover:bg-blue-50/60 transition-all duration-300 group">
              <div class="w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center mb-3">
                <img
                  src={`${BASE_IMG_URL}/${cert.img}`}
                  alt={cert.name}
                  class="max-h-full max-w-full object-contain"
                  loading="lazy"
                />
              </div>
              <span class="text-center text-[10px] sm:text-xs font-medium text-gray-600 group-hover:text-[#006aff] transition-colors duration-300 leading-tight">{cert.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================================================================ -->
    <!-- 3. ZERO TRUST SOLUTION                                           -->
    <!-- ================================================================ -->
    <section id="zero-trust" class="py-20 sm:py-32 overflow-hidden relative" style="background:#f4f9ff;" aria-label="Zero Trust Solution">

      <!-- Wrapper Luar untuk Parallax & Drop Shadow -->
      <div id="zt-wrapper" class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 z-10" style="filter: drop-shadow(0 25px 50px rgba(0, 26, 64, 0.25));">

        <!-- Container Utama (Card yang akan terkena Mask Reveal) -->
        <div id="zt-container" class="relative rounded-[2rem] sm:rounded-[3rem] overflow-hidden border border-blue-900/20" style="background: linear-gradient(145deg, #001a40 0%, #002244 50%, #001a40 100%);">

          <!-- Decorative Glowing Orbs -->
          <div class="absolute top-0 right-0 w-[40vw] max-w-[500px] aspect-square bg-[#00e5e5] rounded-full mix-blend-screen filter blur-[100px] opacity-10 pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 w-[40vw] max-w-[500px] aspect-square bg-[#006aff] rounded-full mix-blend-screen filter blur-[100px] opacity-10 pointer-events-none"></div>

          <div class="relative z-10 flex flex-col pt-16 sm:pt-24 lg:pt-28">

            <!-- Text Content -->
            <div class="text-center max-w-4xl mx-auto px-6 sm:px-12 mb-12 sm:mb-16">
              <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-tight mb-6">
                SealSuite: <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00e5e5] to-[#006aff]">Solusi Keamanan Zero Trust Modern</span><br />untuk Bisnis Indonesia
              </h2>
              <p class="text-base sm:text-lg leading-relaxed text-blue-100/80 max-w-2xl mx-auto">
                SealSuite menghadirkan keamanan modern berbasis Zero Trust, menyatukan identitas, perangkat, dan jaringan untuk memberikan pengawasan lengkap, kontrol fleksibel, serta aturan konsisten di seluruh sistem.
              </p>
            </div>

            <!-- Image Area (Image Mask Reveal + Parallax) -->
            <div class="w-full relative h-[45vh] sm:h-[60vh] lg:h-[75vh] min-h-[350px]">
              <div id="zt-mask" class="absolute inset-0 w-full h-full overflow-hidden bg-[#000a1f]">
                <img
                  id="zt-image"
                  src={`${BASE_IMG_URL}/zero-trust-solution.png`}
                  alt="Zero Trust Solution"
                  class="w-full h-full object-cover"
                  loading="lazy"
                />

                <!-- Overlay gradient untuk blend dengan area bawah -->
                <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-[#001a40] via-[#001a40]/30 to-transparent pointer-events-none"></div>

                <!-- Badge overlay -->
                <div class="absolute bottom-8 sm:bottom-12 left-6 sm:left-12 z-20">
                  <span class="inline-flex items-center gap-2 px-4 py-2 sm:px-5 sm:py-2.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs sm:text-sm font-bold text-[#00e5e5] uppercase tracking-widest shadow-xl">
                    <i class="fi fi-br-shield-check" style="font-size:1rem;"></i>
                    Zero Trust Architecture
                  </span>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================ -->
    <!-- 4. 4 PILAR KEAMANAN — TRUE STICKY STACKING CARDS               -->
    <!-- ================================================================ -->
    <section
      class="pillar-stack-section py-24 sm:py-32"
      style="background:#f4f9ff;"
      aria-label="4 Pilar Keamanan"
    >
      <div class="mx-auto max-w-7xl px-6 lg:px-8">

        <div class="text-center max-w-3xl mx-auto mb-16 reveal">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900">
            4 Pilar Keamanan Utama SealSuite<br /><span class="gradient-text">untuk Perlindungan Zero Trust</span>
          </h2>
          <p class="mt-5 text-base sm:text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto">
            Empat lapisan keamanan yang bekerja bersama untuk melindungi identitas, perangkat, jaringan, dan aplikasi cloud perusahaan.
          </p>
        </div>

        <div class="pillar-stack" data-pillar-stack>
          {pillars.map((pillar, index) => (
            <article
              class="pillar-stack-card"
              data-pillar-card
              data-index={String(index)}
              style={`--stack-index:${index}; --stack-accent:${index % 2 === 0 ? '#006aff' : '#00b8b8'};`}
            >
              <div class="pillar-card-inner">

                <!-- Text: always LEFT -->
                <div class={`pillar-stack-content bg-gradient-to-br ${pillar.color}`}>
                  <div class="pillar-content-inner">
                    <div class="pillar-meta">
                      <span class={`pillar-number ${pillar.accentColor}`}>
                        {String(index + 1).padStart(2, '0')}
                      </span>
                    </div>

                    <h3 class="pillar-stack-title">{pillar.title}</h3>
                    <p class="pillar-stack-desc">{pillar.desc}</p>

                    <ul class="pillar-feature-list">
                      {pillar.features.map((feat, featureIndex) => (
                        <li class="pillar-stack-feature" style={`--feature-index:${featureIndex};`}>
                          <span class={`pillar-feature-icon ${pillar.accentColor}`}>
                            <i class="fi fi-br-check text-white" style="font-size:0.6rem;"></i>
                          </span>
                          <span>{feat}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <!-- Image: always RIGHT -->
                <div class="pillar-stack-image">
                  <img
                    src={`${BASE_IMG_URL}/${pillar.img}`}
                    alt={pillar.title}
                    class="pillar-stack-img"
                    loading="lazy"
                  />
                </div>

              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ================================================================ -->
    <!-- 5. PROSES IMPLEMENTASI & MENGAPA VIRTUENET                       -->
    <!--    (class pillar-next: naik dan menutupi card 4)                 -->
    <!-- ================================================================ -->
    <section class="pillar-next py-24 sm:py-32 overflow-hidden" data-pillar-next style="background: linear-gradient(135deg, #001a40 0%, #003380 40%, #005588 70%, #001a40 100%);" aria-label="Implementasi dan Virtuenet">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="text-center mb-16 reveal">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white">
            Proses Implementasi SealSuite<br />Bersama Virtuenet
          </h2>
          <p class="mt-4 text-blue-200/80 max-w-xl mx-auto">Assessment hingga Go Live — kami dampingi setiap tahap perjalanan digital Anda.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
          <!-- Left: Implementation steps (timeline) -->
          <div class="reveal">
            <div class="space-y-0">
              <!-- Step 1 -->
              <div class="relative flex gap-6 pb-10">
                <div class="flex flex-col items-center">
                  <div class="w-12 h-12 rounded-2xl flex items-center justify-center font-black text-[#001a40] text-lg z-10 flex-none" style="background: linear-gradient(135deg, #006aff, #00e5e5);">1</div>
                  <div class="flex-1 w-0.5 mt-3" style="background: linear-gradient(to bottom, rgba(0,229,229,0.5), rgba(0,229,229,0.1));"></div>
                </div>
                <div class="pt-2 pb-4">
                  <div class="flex items-center gap-2 mb-2">
                    <i class="fi fi-br-search text-[#00e5e5]" style="font-size:1rem;"></i>
                    <h3 class="text-xl font-bold text-white">Konsultasi &amp; Assessment</h3>
                  </div>
                  <p class="text-blue-200/80 leading-relaxed">Pemetaan risiko, identitas, perangkat, dan jaringan untuk menentukan strategi implementasi terbaik.</p>
                </div>
              </div>

              <!-- Step 2 -->
              <div class="relative flex gap-6 pb-10">
                <div class="flex flex-col items-center">
                  <div class="w-12 h-12 rounded-2xl flex items-center justify-center font-black text-[#001a40] text-lg z-10 flex-none" style="background: linear-gradient(135deg, #006aff, #00e5e5);">2</div>
                  <div class="flex-1 w-0.5 mt-3" style="background: linear-gradient(to bottom, rgba(0,229,229,0.5), rgba(0,229,229,0.1));"></div>
                </div>
                <div class="pt-2 pb-4">
                  <div class="flex items-center gap-2 mb-2">
                    <i class="fi fi-br-settings text-[#00e5e5]" style="font-size:1rem;"></i>
                    <h3 class="text-xl font-bold text-white">Konfigurasi &amp; Pilot</h3>
                  </div>
                  <p class="text-blue-200/80 leading-relaxed">Kebijakan akses, integrasi SSO, deployment agen endpoint untuk testing lingkungan terbatas.</p>
                </div>
              </div>

              <!-- Step 3 -->
              <div class="relative flex gap-6">
                <div class="flex flex-col items-center">
                  <div class="w-12 h-12 rounded-2xl flex items-center justify-center font-black text-[#001a40] text-lg z-10 flex-none" style="background: linear-gradient(135deg, #006aff, #00e5e5);">3</div>
                </div>
                <div class="pt-2">
                  <div class="flex items-center gap-2 mb-2">
                    <i class="fi fi-br-chart-line-up text-[#00e5e5]" style="font-size:1rem;"></i>
                    <h3 class="text-xl font-bold text-white">Go-live &amp; Optimasi</h3>
                  </div>
                  <p class="text-blue-200/80 leading-relaxed">Pelatihan, dashboard monitoring, review kebijakan berkala untuk optimasi berkelanjutan.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Why Virtuenet -->
          <div class="reveal" data-delay="100">
            <div class="rounded-3xl p-8 sm:p-10 border border-white/10" style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px);">
              <div class="flex items-center gap-4 mb-8 pb-8 border-b border-white/10">
                <div class="flex items-center gap-3">
                  <img src={`${BASE_IMG_URL}/logo.png`} alt="SealSuite Logo" class="h-8 w-auto object-contain" loading="lazy" />
                  <div class="w-px h-6 bg-white/20"></div>
                  <img src={`${BASE_IMG_URL}/virtuenet-logo-white.png`} alt="Virtuenet Logo" class="h-7 w-auto object-contain" loading="lazy" />
                </div>
              </div>

              <div class="mb-6">
                <h3 class="text-2xl font-extrabold text-white mb-2">Mengapa Virtuenet</h3>
                <p class="text-blue-200/70 text-sm">Mitra resmi SealSuite di Indonesia yang siap mendampingi Anda dari awal hingga akhir.</p>
              </div>

              <ul class="space-y-5">
                <li class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-none" style="background: linear-gradient(135deg, rgba(0,106,255,0.3), rgba(0,229,229,0.2));">
                    <i class="fi fi-br-users text-[#00e5e5]" style="font-size:1.1rem;"></i>
                  </div>
                  <div>
                    <div class="font-semibold text-white text-sm mb-0.5">Tim Lokal Berpengalaman &amp; Responsif</div>
                    <div class="text-xs text-blue-200/60">Dukungan dari tim yang memahami kebutuhan bisnis Indonesia</div>
                  </div>
                </li>
                <li class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-none" style="background: linear-gradient(135deg, rgba(0,106,255,0.3), rgba(0,229,229,0.2));">
                    <i class="fi fi-br-link" style="font-size:1.1rem; color:#00e5e5;"></i>
                  </div>
                  <div>
                    <div class="font-semibold text-white text-sm mb-0.5">Integrasi Lintas Solusi</div>
                    <div class="text-xs text-blue-200/60">Lark, NetSuite, dan ekosistem digital lainnya</div>
                  </div>
                </li>
                <li class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-none" style="background: linear-gradient(135deg, rgba(0,106,255,0.3), rgba(0,229,229,0.2));">
                    <i class="fi fi-br-handshake" style="font-size:1.1rem; color:#00e5e5;"></i>
                  </div>
                  <div>
                    <div class="font-semibold text-white text-sm mb-0.5">Pendampingan End-to-End</div>
                    <div class="text-xs text-blue-200/60">Dari pilot hingga scale-up, kami ada di setiap tahap</div>
                  </div>
                </li>
                <li class="flex items-start gap-4">
