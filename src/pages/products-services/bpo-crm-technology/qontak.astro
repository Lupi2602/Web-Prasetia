---
import MainLayout from '../../../layouts/MainLayout.astro';

const WEB_URL = 'https://qontak.com/';
const CATALOG_URL = 'https://prasetia.co.id/new/wp-content/uploads/2023/03/Whatsapp_Official_Ind_Omnichannel-deck.pdf';
const SOLUSI_URL = 'https://prasetia.co.id/new/wp-content/uploads/2023/03/Qontak-Solusi-Omnichannel-CRM-PBX-1.pdf';
const WA_URL = 'https://api.whatsapp.com/send?phone=+6281325222008';

const industries = [
  'Enterprise',
  'Manufacturing',
  'Distribution',
  'Technology Firms',
  'Finance dan Insurance',
  'Property dan Construction',
  'Agencies',
  'Transportation dan Logistics',
  'SMEs',
  'Retail',
  'E-Commerce',
];

const highlights = [
  {
    no: '01',
    title: 'Data masuk otomatis',
    desc: 'Data dari landing page dan sistem lain langsung tersimpan di sistem Anda, tanpa perlu input manual.',
  },
  {
    no: '02',
    title: 'Data keluar otomatis',
    desc: 'Data dari Qontak bisa dikirim langsung ke aplikasi atau sistem lain yang Anda gunakan.',
  },
  {
    no: '03',
    title: 'Terhubung dengan sistem apa pun',
    desc: 'Berbasis OpenAPI, sehingga mudah disambungkan dengan berbagai perangkat lunak bisnis.',
  },
];

const resources = [
  {
    href: WEB_URL,
    badge: 'WEB',
    title: 'Website resmi Qontak',
    desc: 'Kenali fitur, layanan, dan informasi terbaru di qontak.com.',
    action: 'Buka Website',
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M3.6 9h16.8M3.6 15h16.8M12 3a15.3 15.3 0 010 18M12 3a15.3 15.3 0 000 18"/></svg>`,
  },
  {
    href: CATALOG_URL,
    badge: 'PDF',
    title: 'WhatsApp Omnichannel Deck',
    desc: 'Katalog resmi yang menjelaskan layanan WhatsApp Omnichannel.',
    action: 'Unduh PDF',
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8M8 14h5m-9 6l2.5-3H18a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v14z"/></svg>`,
  },
  {
    href: SOLUSI_URL,
    badge: 'PDF',
    title: 'Solusi Omnichannel CRM dan PBX',
    desc: 'Dokumen teknis untuk integrasi CRM dan PBX perusahaan.',
    action: 'Unduh PDF',
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
  },
];
---

<MainLayout title="BPO CRM Technology | PT Prasetia Dwidharma" transparentNavbar={true}>
  <div class="font-sans text-slate-700 bg-white overflow-x-hidden">

    <section class="relative overflow-hidden">
      <div
        class="absolute inset-0 scale-105 bg-cover bg-center will-change-transform"
        style="background-image: url('/images/hero/hero2.jpg');"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-b from-blue-950/75 via-blue-900/45 to-blue-800/30"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_60%_40%,rgba(56,189,248,0.12),transparent_65%)]"></div>

      <div class="relative max-w-6xl mx-auto px-5 sm:px-8 pt-28 sm:pt-32 lg:pt-36 pb-24 sm:pb-28 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">

        <div class="lg:col-span-7 text-center lg:text-left">
          <span class="fade-up inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/15 text-white text-xs font-semibold tracking-wide mb-5 border border-white/25">
            <span class="pulse-dot w-2 h-2 rounded-full bg-white"></span>
            BPO CRM Technology
          </span>

          <h1 class="hero-title fade-up font-bold text-white mb-5 mx-auto lg:mx-0 max-w-2xl" style="animation-delay: .1s">
            Solusi Qontak CRM untuk mengelola penjualan dan layanan pelanggan
          </h1>

          <p class="fade-up text-sm sm:text-base text-blue-50 leading-relaxed max-w-xl mx-auto lg:mx-0 mb-3" style="animation-delay: .2s">
            Qontak is an OpenAPI platform allowing movement of data inbound and outbound automatically. Seamlessly connect landing pages and any other software system so that data immediately ports to your system or is pushed out.
          </p>

          <p class="fade-up text-sm text-blue-100/90 leading-relaxed max-w-xl mx-auto lg:mx-0 mb-8" style="animation-delay: .3s">
            Singkatnya, data pelanggan berpindah otomatis antar sistem sehingga tim Anda tidak perlu memindahkannya secara manual.
          </p>

          <div class="fade-up hero-cta flex flex-col sm:flex-row items-stretch sm:items-center gap-3 justify-center lg:justify-start" style="animation-delay: .4s">
            <a
              href={WA_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="hero-btn hero-btn-primary"
            >
              <svg class="shrink-0 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8M8 14h5m-9 6l2.5-3H18a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v14z" />
              </svg>
              <span>Konsultasi via WhatsApp</span>
            </a>
            <a
              href="#sumber"
              class="hero-btn hero-btn-ghost"
            >
              <span>Lihat Katalog dan Dokumen</span>
            </a>
          </div>
        </div>

        <div class="fade-up lg:col-span-5 flex justify-center" style="animation-delay: .3s">
          <div class="relative w-full max-w-xs sm:max-w-sm">
            <div class="floaty rounded-3xl bg-white p-2.5 shadow-2xl shadow-blue-950/25">
              <img
                src="/images/hero/heroqontak.png"
                alt="Ilustrasi Qontak Social CRM"
                class="w-full h-auto rounded-2xl object-contain"
              />
            </div>
          </div>
        </div>
      </div>

      <div class="absolute bottom-0 inset-x-0 leading-none pointer-events-none">
        <svg viewBox="0 0 1440 90" preserveAspectRatio="none" class="block w-full h-10 sm:h-16">
          <path class="wave-back" fill="#ffffff" fill-opacity="0.45" d="M-100 45 C 140 90 380 5 620 45 C 860 85 1100 15 1340 50 C 1420 62 1480 55 1540 45 L1540 90 L-100 90 Z" />
          <path fill="#ffffff" d="M0 62 C 260 25 520 90 800 58 C 1060 30 1260 72 1440 56 L1440 90 L0 90 Z" />
        </svg>
      </div>
    </section>

    <section class="bg-white pt-6 pb-12 sm:pb-16">
      <div class="reveal text-center px-5">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-600">Industri yang dilayani</span>
      </div>
      <div class="marquee-mask mt-6 overflow-hidden">
        <div class="marquee-track flex w-max gap-3 pr-3">
          {[...industries, ...industries].map((name) => (
            <span class="shrink-0 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-sky-50 border border-blue-100 text-blue-900 text-sm font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
              {name}
            </span>
          ))}
        </div>
      </div>
    </section>

    <section class="relative bg-gradient-to-b from-white via-sky-50/70 to-sky-50 py-14 sm:py-20">
      <div class="max-w-6xl mx-auto px-5 sm:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

        <div class="reveal lg:col-span-6 lg:sticky lg:top-28">
          <span class="text-xs font-bold uppercase tracking-widest text-blue-600">Keunggulan</span>
          <h2 class="mt-2 text-body-lead text-section-title font-extrabold text-blue-950 tracking-tight leading-snug">
            Data mengalir dua arah, tanpa input manual
          </h2>
          <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed max-w-md">
            Qontak berada di tengah dan mengatur perpindahan data antara sumber Anda dan sistem tujuan.
          </p>

          <div class="mt-8 rounded-3xl bg-white border border-blue-100 shadow-xl shadow-blue-900/5 p-4 sm:p-6">
            <svg viewBox="0 0 420 270" class="w-full h-auto" role="img" aria-label="Diagram data mengalir dari landing page, aplikasi, dan sistem lain melalui Qontak menuju sistem Anda">
              <g fill="none" stroke="#93c5fd" stroke-width="2" stroke-linecap="round">
                <path class="flow" d="M120 50 C 160 50, 150 135, 176 135" />
                <path class="flow" d="M120 135 L176 135" />
                <path class="flow" d="M120 220 C 160 220, 150 135, 176 135" />
                <path class="flow" d="M246 128 L298 128" />
                <path class="flow flow-rev" d="M246 144 L298 144" />
              </g>

              <g>
                <rect x="10" y="25" width="110" height="50" rx="12" fill="#eff6ff" stroke="#bfdbfe" />
                <rect x="10" y="110" width="110" height="50" rx="12" fill="#eff6ff" stroke="#bfdbfe" />
                <rect x="10" y="195" width="110" height="50" rx="12" fill="#eff6ff" stroke="#bfdbfe" />
              </g>
              <g font-size="12" font-weight="600" fill="#1e3a8a" text-anchor="middle">
                <text x="65" y="54">Landing Page</text>
                <text x="65" y="139">Aplikasi Lain</text>
                <text x="65" y="224">Sistem Lain</text>
              </g>

              <circle class="ring" cx="211" cy="135" r="34" fill="#3b82f6" fill-opacity="0.35" />
              <circle cx="211" cy="135" r="34" fill="#2563eb" />
              <text x="211" y="139" font-size="12" font-weight="700" fill="#ffffff" text-anchor="middle">Qontak</text>

              <rect x="298" y="103" width="112" height="64" rx="14" fill="#2563eb" />
              <g font-size="12" font-weight="700" fill="#ffffff" text-anchor="middle">
                <text x="354" y="131">Sistem</text>
                <text x="354" y="148">Anda</text>
              </g>
            </svg>
            <p class="mt-3 text-center text-xs text-slate-500">Titik bergerak menunjukkan arah aliran data masuk dan keluar</p>
          </div>
        </div>

        <div class="lg:col-span-6 relative pl-2 lg:pt-14">
          <div class="absolute left-[1.35rem] top-2 bottom-2 lg:top-16 w-px bg-gradient-to-b from-blue-300 via-blue-200 to-transparent"></div>

          <div class="space-y-10">
            {highlights.map((item, i) => (
              <div class="reveal relative flex gap-5" style={`transition-delay: ${i * 140}ms`}>
                <div class="relative z-10 shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-white border-2 border-blue-500 text-blue-700 text-xs font-bold shadow-sm">
                  {item.no}
                </div>
                <div class="pt-1.5">
                  <h3 class="text-base text-body-lead font-bold text-blue-950 mb-1.5">{item.title}</h3>
                  <p class="text-sm sm:text-base text-slate-600 leading-relaxed">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

    <section id="sumber" class="relative bg-sky-50 pt-4 pb-16 sm:pb-24 scroll-mt-20 overflow-hidden">
      <div class="blob absolute top-10 -right-24 w-72 h-72 rounded-full bg-blue-200/40 blur-3xl"></div>

      <div class="relative max-w-6xl mx-auto px-5 sm:px-8">

        <div class="reveal max-w-2xl mb-10 sm:mb-12">
          <div class="flex items-center gap-3 mb-3">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-blue-600 text-white shadow-md shadow-blue-600/30">
              <svg class="w-4.5 h-4.5 w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </span>
            <span class="text-xs font-bold uppercase tracking-widest text-blue-600">Akses dan sumber informasi</span>
          </div>
          <h2 class="text-body-lead text-section-title font-extrabold text-blue-950 tracking-tight leading-snug">
            Pelajari Qontak lebih dalam
          </h2>
          <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
            Mulai dari berkonsultasi langsung, atau baca katalog dan dokumen solusi resmi di bawah ini.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">

          <div class="reveal lg:col-span-5">
            <div class="relative h-full overflow-hidden rounded-3xl bg-gradient-to-br from-blue-600 to-sky-500 p-7 sm:p-9 text-white shadow-xl shadow-blue-600/20">
              <div class="blob absolute -top-12 -right-12 w-48 h-48 rounded-full bg-white/15"></div>
              <div class="blob blob-slow absolute -bottom-16 -left-10 w-52 h-52 rounded-full bg-white/10"></div>

              <div class="relative">
                <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-white/20 mb-5">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8M8 14h5m-9 6l2.5-3H18a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v14z" />
                  </svg>
                </span>
                <h3 class="text-body-lead font-bold mb-2">Ingin berdiskusi lebih dulu?</h3>
                <p class="text-sm sm:text-base text-blue-50 leading-relaxed mb-7">
                  Ceritakan kebutuhan bisnis Anda kepada spesialis kami. Kami bantu pilihkan solusi Qontak yang paling sesuai.
                </p>
                <a
                  href={WA_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex w-full sm:w-auto items-center justify-center gap-2.5 px-6 py-3 rounded-xl bg-white text-blue-700 text-sm sm:text-base font-bold shadow-lg shadow-blue-900/15 hover:bg-blue-50 hover:-translate-y-0.5 transition-all duration-300"
                >
                  <svg class="shrink-0 w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                    <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.118 1.528 5.849L.057 23.571a.75.75 0 00.921.921l5.722-1.471A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75a9.695 9.695 0 01-4.944-1.355l-.355-.212-3.697.95.968-3.594-.232-.368A9.696 9.696 0 012.25 12C2.25 6.615 6.615 2.25 12 2.25S21.75 6.615 21.75 12 17.385 21.75 12 21.75z"/>
                  </svg>
                  Konsultasi via WhatsApp
                </a>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7">
            <ul class="divide-y divide-blue-100 border-y border-blue-100">
              {resources.map((item, i) => (
                <li class="reveal" style={`transition-delay: ${i * 120}ms`}>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="row group relative flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-5 px-3 sm:px-5 py-5 sm:py-6 hover:bg-white transition-colors duration-300"
                  >
                    <span class="row-bar absolute left-0 top-0 h-full w-1 bg-blue-600"></span>
                    <span class="shrink-0 flex flex-col items-center justify-center gap-1 w-14 h-14 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600 transition-colors duration-300">
                      <Fragment set:html={item.icon} />
                      <span class="text-[9px] font-bold tracking-widest uppercase leading-none">{item.badge}</span>
                    </span>
                    <span class="flex-1 min-w-0">
                      <span class="block text-base text-body-lead font-bold text-blue-950 group-hover:text-blue-700 transition-colors duration-300">{item.title}</span>
                      <span class="block mt-1 text-sm text-slate-600 leading-relaxed">{item.desc}</span>
                    </span>
                    <span class="shrink-0 self-start sm:self-center inline-flex items-center gap-1.5 px-4 py-2 rounded-lg border border-blue-200 bg-white text-blue-700 text-sm font-semibold group-hover:bg-blue-600 group-hover:border-blue-600 group-hover:text-white transition-colors duration-300">
                      <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                      {item.action}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

        </div>
      </div>
    </section>

  </div>
</MainLayout>

<style>
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(22px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes floaty {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-9px); }
  }
  @keyframes blobMove {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(18px, 22px) scale(1.07); }
  }
  @keyframes pulseDot {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.55); }
    50% { box-shadow: 0 0 0 6px rgba(255, 255, 255, 0); }
  }
  @keyframes waveDrift {
    from { transform: translateX(-40px); }
    to { transform: translateX(40px); }
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes dash {
    to { stroke-dashoffset: -24; }
  }
  @keyframes ring {
    0% { transform: scale(1); opacity: 0.5; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  .fade-up {
    opacity: 0;
    animation: fadeUp 0.8s ease-out forwards;
  }
  .floaty { animation: floaty 5s ease-in-out infinite; }
  .floaty-delay { animation-delay: 1.2s; }
  .blob { animation: blobMove 12s ease-in-out infinite; }
  .blob-slow { animation-duration: 18s; }
  .pulse-dot { animation: pulseDot 2s ease-in-out infinite; }
  .wave-back { animation: waveDrift 8s ease-in-out infinite alternate; }

  .marquee-track { animation: marquee 38s linear infinite; }
  .marquee-track:hover { animation-play-state: paused; }
  .marquee-mask {
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .flow {
    stroke-dasharray: 5 7;
    animation: dash 1.2s linear infinite;
  }
  .flow-rev { animation-direction: reverse; }
  .ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: ring 2.4s ease-out infinite;
  }

  .row-bar {
    transform: scaleY(0);
    transform-origin: center;
    transition: transform 0.3s ease;
  }
  .row:hover .row-bar,
  .row:focus-visible .row-bar {
    transform: scaleY(1);
  }

  /* ===== Hero title: ukuran proporsional & responsif ===== */
  .hero-title {
    
    line-height: 1.25;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  /* ===== Hero buttons: sejajar, tinggi & lebar konsisten ===== */
  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 3.25rem;
    padding: 0 1.5rem;
    border-radius: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    text-align: center;
    box-sizing: border-box;
    transition: background-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }
  .hero-btn span {
    display: inline-block;
    line-height: 1;
  }
  .hero-btn-primary {
    background: #ffffff;
    color: #1d4ed8;
    border: 1px solid #ffffff;
    box-shadow: 0 10px 24px -8px rgba(23, 37, 84, 0.35);
  }
  .hero-btn-primary:hover {
    background: #eff6ff;
    transform: translateY(-2px);
  }
  .hero-btn-ghost {
    background: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.55);
  }
  .hero-btn-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    transform: translateY(-2px);
  }
  @media (min-width: 640px) {
    .hero-btn {
      min-width: 15.5rem;
      font-size: 1rem;
    }
  }

  :global(.js) .reveal {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }
  :global(.js) .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .fade-up, .floaty, .blob, .pulse-dot, .wave-back, .marquee-track, .flow, .ring {
      animation: none;
      opacity: 1;
    }
    .ring { opacity: 0; }
    :global(.js) .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  document.documentElement.classList.add('js');

  const items = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    items.forEach((el) => observer.observe(el));
  } else {
    items.forEach((el) => el.classList.add('is-visible'));
  }
</script>