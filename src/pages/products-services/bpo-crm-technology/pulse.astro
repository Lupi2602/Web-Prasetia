---
import MainLayout from '../../../layouts/MainLayout.astro';
---

<MainLayout title="Pulse | PT Prasetia Dwidharma">
  <!-- Hero Section -->
  <section class="bg-gray-900 text-white py-16 lg:py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-30">
      <img
        src="/images/hero/hero2.jpg"
        alt="Pulse Hero"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container mx-auto px-6 max-w-5xl relative z-10 text-center">
      <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur-sm border border-white/30 text-xs font-semibold uppercase tracking-wider rounded mb-4">
        Product
      </span>
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-4">
        Pulse
      </h1>
    </div>
  </section>

  <!-- Intro Heading -->
  <section class="py-16 bg-white border-b border-gray-100">
    <div class="container mx-auto px-6 max-w-4xl text-center">
      <h2 class="text-2xl md:text-4xl font-extrabold text-gray-900 mb-6 leading-tight">
        4 Robust Platforms That Are Designed To Digitalize Processes When It Comes To One-On-One Contacts
      </h2>
    </div>
  </section>

  <!-- Banner Feature -->
  <section class="py-12 bg-gray-50 border-b border-gray-200">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="bg-amber-500/10 border border-amber-500/30 rounded-xl p-8 lg:p-12 relative overflow-hidden">
        <h3 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-2">PULSE</h3>
        <p class="text-base md:text-lg font-semibold text-gray-800 mb-1">Programmatic | Direct | Engaging</p>
        <p class="text-sm md:text-base text-gray-600">Small screen one-on-one communication platform</p>
      </div>
    </div>
  </section>

  <!-- 4 Platforms Grid -->
  <section class="py-16 bg-white border-b border-gray-200">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- 1. Broadcast Platform -->
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" /></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Broadcast Platform</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              Text or Voice &ndash; Do it all from a single platform, seamlessly
            </p>
          </div>
        </div>

        <!-- 2. Chatbot Platform -->
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-lg bg-yellow-100 text-yellow-700 flex items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" /></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Chatbot Platform</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              Engage in to-time, all the time, with right empathy
            </p>
          </div>
        </div>

        <!-- 3. Visual IVR Platform -->
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-lg bg-red-100 text-red-700 flex items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Visual IVR Platform</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              A Visual self serve App-On-Demand, using intelligent process automation that guides inbound callers to a web based voice plus visual aided support experience
            </p>
          </div>
        </div>

        <!-- 4. Referral Platform -->
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Referral Platform</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              With automation referral engine, sales conversion is higher and faster close time
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom Details & Contact Bar -->
  <section class="py-12 bg-gray-50">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 border-t border-b border-gray-200 py-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-1">Website</span>
          <a
            href="https://www.pulse.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-blue-600 hover:underline"
          >
            https://www.pulse.com &nearr;
          </a>
        </div>

        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-1">Product Offering</span>
          <span class="text-sm font-medium text-gray-700">Pulse_PitchDeck.pdf</span>
        </div>

        <div>
          <a
            href="/about/contact/"
            class="inline-block bg-pink-600 hover:bg-pink-700 text-white font-semibold text-sm px-6 py-2.5 rounded transition-colors"
          >
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom Navigation: Previous / Next Post -->
  <section class="border-t border-gray-200 bg-gray-900 text-white">
    <div class="grid grid-cols-1 md:grid-cols-2">
      <a
        href="/products-services/ict/tattile/"
        class="p-8 md:p-12 border-b md:border-b-0 md:border-r border-gray-800 hover:bg-gray-800/60 transition-colors flex flex-col justify-center"
      >
        <span class="text-xs uppercase tracking-wider text-gray-400 mb-1">Previous Post</span>
        <span class="text-xl font-bold text-white">Tattile</span>
      </a>

      <a
        href="/products-services/bpo-crm-technology/qontak/"
        class="p-8 md:p-12 hover:bg-gray-800/60 transition-colors flex flex-col justify-center"
      >
        <span class="text-xs uppercase tracking-wider text-gray-400 mb-1">Next Post</span>
        <span class="text-xl font-bold text-white">Qontak CRM</span>
      </a>
    </div>
  </section>
</MainLayout>
