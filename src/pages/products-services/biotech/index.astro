---
import MainLayout from '../../../layouts/MainLayout.astro';
---

<MainLayout title="Biotech | PT Prasetia Dwidharma">
  <div class="container mx-auto px-6 max-w-5xl py-16">
    <div class="text-center mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-green-700 block mb-2">Division 04</span>
      <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 tracking-tight mb-4">
        Biotech
      </h1>
      <p class="text-gray-600 max-w-xl mx-auto text-base md:text-lg">
        Innovative biotechnology initiatives and partners under PT Prasetia Dwidharma.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      <!-- 1. ImagINa -->
      <div class="bg-white border border-gray-200 rounded-xl p-8 shadow-sm flex flex-col justify-between">
        <div>
          <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-2">External Destination</span>
          <h2 class="text-2xl font-bold text-gray-900 mb-3">ImagINa</h2>
          <p class="text-gray-600 text-sm leading-relaxed mb-6">
            Biotechnology solutions focusing on agricultural enhancement and wellness innovations.
          </p>
        </div>

        <div class="pt-4 border-t border-gray-100">
          <!-- External URL placeholder per Biotech special rule -->
          <a
            href="#"
            class="inline-flex items-center gap-2 text-sm font-semibold text-green-700 hover:text-green-800"
            title="[IMAGINA EXTERNAL URL NEEDED]"
          >
            Visit Website &rarr; <span class="text-xs text-gray-400 font-normal">[IMAGINA EXTERNAL URL NEEDED]</span>
          </a>
        </div>
      </div>

      <!-- 2. Protecrop -->
      <div class="bg-white border border-gray-200 rounded-xl p-8 shadow-sm flex flex-col justify-between">
        <div>
          <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-2">External Destination</span>
          <h2 class="text-2xl font-bold text-gray-900 mb-3">Protecrop</h2>
          <p class="text-gray-600 text-sm leading-relaxed mb-6">
            Advanced crop protection and biotechnology formulations for sustainable agriculture.
          </p>
        </div>

        <div class="pt-4 border-t border-gray-100">
          <!-- External URL placeholder per Biotech special rule -->
          <a
            href="#"
            class="inline-flex items-center gap-2 text-sm font-semibold text-green-700 hover:text-green-800"
            title="[PROTECROP EXTERNAL URL NEEDED]"
          >
            Visit Website &rarr; <span class="text-xs text-gray-400 font-normal">[PROTECROP EXTERNAL URL NEEDED]</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
