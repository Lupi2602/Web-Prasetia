---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Investment | PT Prasetia Dwidharma">
  <!-- Hero Section -->
  <div class="relative bg-gradient-to-r from-gray-900 via-gray-800 to-black text-white py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 opacity-25">
      <img src="/images/card-divisions/invesments.jpg" alt="Prasetia Investment" class="w-full h-full object-cover" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-gray-900/80 to-transparent"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-red-600/30 border border-red-500/40 text-red-200 text-xs font-semibold uppercase tracking-wider mb-6">
        Venture & Ecosystem
      </div>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-6">
        Investment
      </h1>
      <p class="text-lg md:text-2xl text-gray-200 max-w-3xl mx-auto leading-relaxed font-light">
        An early-stage investment company, has been a part of the initial growth stories of several startups in Southeast Asia.
      </p>
    </div>
  </div>

  <!-- Investment Overview & Thesis -->
  <div class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl p-8 md:p-12 border border-gray-200 shadow-sm space-y-8">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
            Empowering Next-Generation Innovators
          </h2>
          <p class="text-gray-700 leading-relaxed text-base md:text-lg">
            PT Prasetia Dwidharma actively participates in technology and startup ecosystems across Indonesia and Southeast Asia. We support passionate founders building high-impact technological solutions from early stage through rapid scaling.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
          <div class="p-6 rounded-xl bg-gray-50 border border-gray-100">
            <div class="text-2xl font-bold text-red-600 mb-2">Early-Stage</div>
            <div class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-2">Stage Focus</div>
            <p class="text-xs text-gray-600 leading-relaxed">
              Partnering with seed and pre-series A ventures displaying strong product-market fit and technological depth.
            </p>
          </div>

          <div class="p-6 rounded-xl bg-gray-50 border border-gray-100">
            <div class="text-2xl font-bold text-red-600 mb-2">Southeast Asia</div>
            <div class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-2">Geographic Scope</div>
            <p class="text-xs text-gray-600 leading-relaxed">
              Primarily centered in Indonesia and growing markets across the Southeast Asian regional startup corridor.
            </p>
          </div>

          <div class="p-6 rounded-xl bg-gray-50 border border-gray-100">
            <div class="text-2xl font-bold text-red-600 mb-2">Strategic</div>
            <div class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-2">Synergy & Value-Add</div>
            <p class="text-xs text-gray-600 leading-relaxed">
              Providing portfolio companies with enterprise networks, telecom infrastructure access, and market integration.
            </p>
          </div>
        </div>

        <!-- Placeholder note for specific portfolio list -->
        <div class="p-6 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-sm">
          <div class="font-bold mb-1 flex items-center gap-2">
            <svg class="w-5 h-5 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
            [MORE INVESTMENT CONTENT & PORTFOLIO LOGOS NEEDED]
          </div>
          <p class="text-xs text-amber-800 leading-relaxed">
            Detailed startup portfolio directory, investment thesis deck, and pitch submission forms can be updated here upon receipt of current portfolio assets.
          </p>
        </div>

        <div class="pt-6 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4">
          <span class="text-sm text-gray-600">Interested in pitching or exploring investment partnership?</span>
          <a
            href="mailto:contact@prasetia.co.id?subject=Investment%20Pitch%20Inquiry"
            class="px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg text-sm transition-colors shadow-sm"
          >
            Contact Investment Team
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
