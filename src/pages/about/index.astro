---
import MainLayout from '../../layouts/MainLayout.astro';

// =============================================
// DATA — CLIENT LOGOS (all merged into moving marquee rows)
// =============================================
// Row 1: tower / infra clients
const clientLogosRow1 = [
  { name: 'Tower Bersama Group', src: '/images/client/logo-tower-bersama-group.png' },
  { name: 'Mitratel', src: '/images/client/Logo_Mitratel.png' },
  { name: 'Telkom Infra', src: '/images/client/logo-telkom-infra.jpg' },
  { name: 'Protelindo', src: '/images/client/logo-protelindo.jpg' },
  { name: 'MSN', src: '/images/client/logo-msn.png' },
];

// Row 2: operator partners
const clientLogosRow2 = [
  { name: 'AXIS', src: '/images/client/axis.png' },
  { name: 'Bali Tower', src: '/images/client/balitower.png' },
  { name: 'Indosat', src: '/images/client/indosat.png' },
  { name: 'Telkomsel', src: '/images/client/telkomsel.png' },
  { name: 'XL Axiata', src: '/images/client/xl.png' },
];

// Row 3: ICT / BPO partners (previously static, now merged into marquee)
const clientLogosRow3 = [
  { name: 'Mayapada Hospital', src: '/images/client/logo-MayapadaHospital.png' },
  { name: 'Indosat M2', src: '/images/client/logo-IndosatM2.png' },
  { name: 'BNI Life', src: '/images/client/logo-BNI-Life.png' },
  { name: 'Qlue', src: '/images/client/logo-qlue.png' },
  { name: 'Sucofindo', src: '/images/client/logo-Sucofindo.png' },
];

// =============================================
// DATA — FOUR DIVISIONS (from index.astro)
// =============================================
const divisions = [
  {
    number: '01',
    title: 'Telecommunication & Infrastructure Contractor',
    description: 'We provide tower construction services, starting from planning up to construction.',
    image: '/images/card-divisions/tower.jpg',
    icon: '/images/icons/radio-tower.svg',
    href: '/products-services/telecommunication-infrastructure/',
  },
  {
    number: '02',
    title: 'Information & Communication Technology',
    description: 'We provide ICT products and services to corporates, governments and retails.',
    image: '/images/card-divisions/ict.jpg',
    icon: '/images/icons/monitor.svg',
    href: '/products-services/ict/lark/',
  },
  {
    number: '03',
    title: 'Business Process Outsourcing',
    description: 'We provide Outsourcing Services for different sectors like telco and CRM by providing contact center solutions.',
    image: '/images/card-divisions/bpo.jpg',
    icon: '/images/icons/headset.svg',
    href: '/products-services/bpo-crm-technology/call-center/',
  },
  {
    number: '04',
    title: 'Investments',
    description: 'An early-stage investment company, has been a part of the initial growth stories of several startups in Southeast Asia.',
    image: '/images/card-divisions/invesments.jpg',
    icon: '/images/icons/trending.svg',
    href: '/investment/',
  },
];
---

<MainLayout title="About Us | PT Prasetia Dwidharma" transparentNavbar={true}>

  <!-- ============================================================
       1. HERO SECTION
  ============================================================ -->
  <section class="about-hero relative min-h-[92vh] lg:min-h-screen flex items-end overflow-hidden bg-slate-950">
    <div class="absolute inset-0">
      <img
        src="/images/about/about1.jpg"
        alt="Prasetia team members"
        class="w-full h-full object-cover object-center"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-slate-950/25"></div>
    </div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-12 pb-20 lg:pb-28 pt-36">
      <div class="about-reveal flex items-center gap-3 mb-5">
        <span class="w-10 h-px bg-red-500"></span>
        <span class="text-xs font-bold uppercase tracking-[0.25em] text-red-400">PT Prasetia Dwidharma</span>
      </div>

      <!-- Minimalist headline, no oversized text -->
      <h1 class="about-reveal about-reveal-d1 text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-extrabold text-white leading-[1.15] tracking-tight mb-5 max-w-3xl">
        About <span class="text-red-500 italic">Us</span>
      </h1>

      <p class="about-reveal about-reveal-d2 text-base sm:text-lg text-slate-200/80 font-light leading-relaxed max-w-xl mb-9">
        Founded in 2008, PT Prasetia Dwidharma has grown into a trusted technology integrator and telecommunications infrastructure company serving Indonesia.
      </p>

      <div class="about-reveal about-reveal-d3 flex flex-wrap gap-x-10 gap-y-4">
        <div class="flex flex-col">
          <span class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">2008</span>
          <span class="text-xs uppercase tracking-widest text-slate-400 mt-1">Founded</span>
        </div>
        <div class="w-px h-12 bg-white/15 self-center hidden sm:block"></div>
        <div class="flex flex-col">
          <span class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">4</span>
          <span class="text-xs uppercase tracking-widest text-slate-400 mt-1">Business Divisions</span>
        </div>
        <div class="w-px h-12 bg-white/15 self-center hidden sm:block"></div>
        <div class="flex flex-col">
          <span class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">10<span class="text-red-500 text-lg">+</span></span>
          <span class="text-xs uppercase tracking-widest text-slate-400 mt-1">Major Clients</span>
        </div>
        <div class="w-px h-12 bg-white/15 self-center hidden sm:block"></div>
        <div class="flex flex-col">
          <span class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">ISO</span>
          <span class="text-xs uppercase tracking-widest text-slate-400 mt-1">9001 Certified</span>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 right-8 z-10 hidden lg:flex flex-col items-center gap-2 opacity-40">
      <span class="text-[9px] uppercase tracking-[0.25em] text-white font-medium" style="writing-mode:vertical-rl;">Scroll</span>
      <div class="w-px h-10 bg-white/60"></div>
    </div>
  </section>


  <!-- ============================================================
       2. COMPANY STORY SECTION
  ============================================================ -->
  <section class="py-24 lg:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 xl:gap-24 items-center">

        <div class="about-reveal">
          <div class="flex items-center gap-3 mb-5">
            <span class="w-8 h-px bg-red-600"></span>
            <span class="text-xs font-bold uppercase tracking-[0.22em] text-red-600">Our Story</span>
          </div>

          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-[1.2] mb-6">
            PT Prasetia<br>
            <em class="not-italic text-red-600">Dwidharma</em>
          </h2>

          <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-5">
            Was founded in 2008. Since then we have grown to become a major player in the industry, currently we have four divisions under our company: Telecommunication &amp; Infrastructure, ICT (Information &amp; Communication Technology), Call Center BPO (Business Process Outsourcing), and Investments.
          </p>

          <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-8">
            Prasetia is committed to delivering innovative technology and infrastructure solutions that empower enterprises, government institutions, and communities across Indonesia.
          </p>

          <div class="space-y-6 mb-8">
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-4 h-px bg-red-600"></span>
                <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-red-600">Vision</span>
              </div>
              <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-medium">
                To be the most innovative and customer centric ICT (Information and Communications Technology) solution provider in Indonesia.
              </p>
            </div>
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-4 h-px bg-red-600"></span>
                <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-red-600">Mission</span>
              </div>
              <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-medium">
                Partnering with customers in reaching their potential through better technology and communications infrastructure.
              </p>
            </div>
          </div>
          <div class="space-y-4 pt-6 border-t border-slate-100">
            <div class="flex items-start gap-4">
              <span class="w-1.5 h-1.5 rounded-full bg-red-600 mt-2 shrink-0"></span>
              <p class="text-sm text-slate-700 leading-relaxed">
                <strong class="text-slate-900">Quality First:</strong> We dedicate ourselves to deliver the highest standards in Quality, Cost, and Delivery across every project.
              </p>
            </div>
            <div class="flex items-start gap-4">
              <span class="w-1.5 h-1.5 rounded-full bg-red-600 mt-2 shrink-0"></span>
              <p class="text-sm text-slate-700 leading-relaxed">
                <strong class="text-slate-900">Connecting Indonesia:</strong> With uncompromised engineering quality, we contribute directly to expanding connectivity across the nation.
              </p>
            </div>
            <div class="flex items-start gap-4">
              <span class="w-1.5 h-1.5 rounded-full bg-red-600 mt-2 shrink-0"></span>
              <p class="text-sm text-slate-700 leading-relaxed">
                <strong class="text-slate-900">Technology Driven:</strong> Leveraging best-in-class technology, safety standards, and modern deployment methods.
              </p>
            </div>
          </div>
        </div>

        <div class="about-reveal about-reveal-d1 relative">
          <div class="relative aspect-[4/5] sm:aspect-[4/4] lg:aspect-[4/5] rounded-2xl overflow-hidden bg-slate-100">
            <img
              src="/images/about/about1.jpg"
              alt="Prasetia team"
              class="w-full h-full object-cover object-center"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/30 to-transparent"></div>
          </div>

          <div class="absolute -top-4 -right-4 w-20 h-20 border-t-2 border-r-2 border-red-600 rounded-tr-2xl pointer-events-none hidden lg:block"></div>
          <div class="absolute -bottom-4 -left-4 w-20 h-20 border-b-2 border-l-2 border-red-600 rounded-bl-2xl pointer-events-none hidden lg:block"></div>

          <div class="absolute bottom-6 right-6 bg-red-600 text-white px-5 py-4 rounded-xl text-center shadow-lg">
            <div class="text-xl font-extrabold leading-none">2008</div>
            <div class="text-[10px] uppercase tracking-widest opacity-85 mt-1">Est.</div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ============================================================
       3. FOUR DIVISIONS, ONE VISION
  ============================================================ -->
  <section class="py-24 lg:py-32 bg-gradient-to-b from-slate-50 to-white relative overflow-hidden">
    <div
      class="absolute inset-0 opacity-[0.025] pointer-events-none"
      style="background-image: radial-gradient(circle, #b91c1c 1px, transparent 1px); background-size: 40px 40px;"
    ></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">

      <div class="about-reveal max-w-2xl mb-16 lg:mb-20">
        <div class="flex items-center gap-3 mb-5">
          <span class="w-8 h-px bg-red-600"></span>
          <span class="text-xs font-bold uppercase tracking-[0.22em] text-red-600">What We Do</span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-[1.2] mb-4">
          Four Divisions,<br><span class="text-red-600">One Vision</span>
        </h2>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          Prasetia operates across four complementary business divisions, each designed to deliver specialized solutions that empower enterprises and communities.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8">
        {divisions.map((div, i) => (
          <a
            href={div.href}
            class={`about-reveal about-reveal-d${Math.min(i + 1, 4)} division-entry group relative rounded-2xl overflow-hidden bg-slate-900 block`}
            style="min-height: 320px;"
          >
            <img
              src={div.image}
              alt={div.title}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-slate-950/10 transition-all duration-500"></div>
            <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-red-600 scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left z-20"></div>

            <div class="absolute inset-0 flex flex-col justify-end p-7 sm:p-8 z-10">
              <span class="font-mono text-xs font-bold text-red-400 tracking-widest mb-3 block">{div.number}</span>
              <div class="w-10 h-10 rounded-lg bg-white/10 backdrop-blur-sm flex items-center justify-center mb-4 transition-all duration-300 group-hover:bg-red-600">
                <img src={div.icon} alt="" aria-hidden="true" class="w-5 h-5 object-contain brightness-0 invert" loading="lazy" />
              </div>
              <h3 class="text-base sm:text-lg font-bold text-white leading-snug mb-2">{div.title}</h3>
              <p class="text-sm text-white/70 leading-relaxed mb-4 group-hover:text-white/90 transition-colors">{div.description}</p>
              <div class="flex items-center gap-2 text-red-400 text-xs font-bold uppercase tracking-wider transition-all duration-300 translate-x-0 group-hover:translate-x-1">
                Learn More
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>


  <!-- ============================================================
       4. OUR CLIENTS & PARTNERS — all logos merged into moving marquee
  ============================================================ -->
  <section class="py-20 lg:py-28 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 mb-12">
      <div class="about-reveal flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="w-8 h-px bg-red-600"></span>
            <span class="text-xs font-bold uppercase tracking-[0.22em] text-red-600">Trusted By</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">Our Clients &amp; Partners</h2>
        </div>
        <p class="text-sm sm:text-base text-slate-500 max-w-xs sm:max-w-sm leading-relaxed text-left sm:text-right">
          Powering Indonesia's ecosystem alongside leading network operators, infrastructure providers, and strategic partners across industries.
        </p>
      </div>
    </div>

    <!-- Row 1 — tower / infra clients — scrolls left -->
    <div class="about-marquee-wrapper relative overflow-hidden py-4">
      <div class="about-marquee-track flex items-center">
        {clientLogosRow1.map((item) => (
          <div class="about-logo-item flex items-center justify-center px-10 sm:px-14 shrink-0">
            <img src={item.src} alt={item.name} class="h-12 sm:h-14 lg:h-16 max-w-[160px] object-contain opacity-80 hover:opacity-100 transition-all duration-300 hover:scale-105" loading="lazy" />
          </div>
        ))}
        {clientLogosRow1.map((item) => (
          <div class="about-logo-item flex items-center justify-center px-10 sm:px-14 shrink-0" aria-hidden="true">
            <img src={item.src} alt={item.name} class="h-12 sm:h-14 lg:h-16 max-w-[160px] object-contain opacity-80 hover:opacity-100 transition-all duration-300 hover:scale-105" loading="lazy" />
          </div>
        ))}
      </div>
    </div>

    <!-- Row 2 — operator partners — scrolls right -->
    <div class="about-marquee-wrapper relative overflow-hidden py-4 mt-2">
      <div class="about-marquee-track about-marquee-reverse flex items-center">
        {clientLogosRow2.map((item) => (
          <div class="about-logo-item flex items-center justify-center px-10 sm:px-14 shrink-0">
            <img src={item.src} alt={item.name} class="h-12 sm:h-14 lg:h-16 max-w-[160px] object-contain opacity-80 hover:opacity-100 transition-all duration-300 hover:scale-105" loading="lazy" />
          </div>
        ))}
        {clientLogosRow2.map((item) => (
          <div class="about-logo-item flex items-center justify-center px-10 sm:px-14 shrink-0" aria-hidden="true">
            <img src={item.src} alt={item.name} class="h-12 sm:h-14 lg:h-16 max-w-[160px] object-contain opacity-80 hover:opacity-100 transition-all duration-300 hover:scale-105" loading="lazy" />
          </div>
        ))}
      </div>
    </div>

    <!-- Row 3 — ICT / BPO partners — scrolls left (previously static, now merged into marquee) -->
    <div class="about-marquee-wrapper relative overflow-hidden py-4 mt-2">
      <div class="about-marquee-track about-marquee-row3 flex items-center">
        {clientLogosRow3.map((item) => (
          <div class="about-logo-item flex items-center justify-center px-10 sm:px-14 shrink-0">
            <img src={item.src} alt={item.name} class="h-10 sm:h-12 lg:h-14 max-w-[140px] object-contain opacity-80 hover:opacity-100 transition-all duration-300 hover:scale-105" loading="lazy" />
          </div>
        ))}
        {clientLogosRow3.map((item) => (
          <div class="about-logo-item flex items-center justify-center px-10 sm:px-14 shrink-0" aria-hidden="true">
            <img src={item.src} alt={item.name} class="h-10 sm:h-12 lg:h-14 max-w-[140px] object-contain opacity-80 hover:opacity-100 transition-all duration-300 hover:scale-105" loading="lazy" />
          </div>
        ))}
      </div>
    </div>

  </section>


  <!-- ============================================================
       5. CERTIFICATIONS
       Content matches the actual certification artwork:
       Lloyd's Register Quality Assurance (ISO 9001) + UKAS Management Systems accreditation (No. 001)
  ============================================================ -->
  <section class="py-24 lg:py-32 relative overflow-hidden" style="background: linear-gradient(to bottom, #ffffff 0%, #ffffff 30%, #fff1f2 65%, #ffe4e6 100%);">
    <div class="absolute inset-0 bg-gradient-to-br from-transparent via-red-50/20 to-red-100/40 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 xl:gap-24 items-center">

        <!-- Left: certification artwork -->
        <div class="about-reveal flex flex-col items-start">
          <div class="relative w-full max-w-sm">
            <div class="aspect-square rounded-3xl bg-gradient-to-br from-slate-50 to-slate-100 border border-slate-200/80 flex flex-col items-center justify-center p-10 shadow-sm">
              <img
                src="/images/herotelcom/iso.png"
                alt="Lloyd's Register Quality Assurance ISO 9001, accredited by UKAS Management Systems No. 001"
                class="w-full max-w-[260px] object-contain"
                loading="lazy"
              />
            </div>
            <div class="absolute -top-3 -right-3 w-16 h-16 border-t-2 border-r-2 border-red-600 rounded-tr-2xl pointer-events-none hidden sm:block"></div>
            <div class="absolute -bottom-3 -left-3 w-16 h-16 border-b-2 border-l-2 border-red-600 rounded-bl-2xl pointer-events-none hidden sm:block"></div>
          </div>
        </div>

        <!-- Right: certification text — factual, matches the artwork only -->
        <div class="about-reveal about-reveal-d1">
          <div class="flex items-center gap-3 mb-5">
            <span class="w-8 h-px bg-red-600"></span>
            <span class="text-xs font-bold uppercase tracking-[0.22em] text-red-600">Quality Assurance</span>
          </div>

          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-[1.2] mb-6">
            Certified<br>by Excellence
          </h2>

          <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-8">
            PT Prasetia Dwidharma is ISO 9001 Quality Management certified by Lloyd's Register Quality Assurance, and this certification is accredited under the UKAS Management Systems scheme.
          </p>

          <div class="space-y-4 pt-6 border-t border-slate-100">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-red-50 flex items-center justify-center shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#b91c1c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-900">ISO 9001 Quality Management System</p>
                <p class="text-xs text-slate-500 mt-0.5">Certified by Lloyd's Register Quality Assurance</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-red-50 flex items-center justify-center shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#b91c1c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-900">UKAS Accredited</p>
                <p class="text-xs text-slate-500 mt-0.5">UKAS Management Systems accreditation No. 001</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ============================================================
       6. CLOSING CTA
       Seamless transition from the Certifications section: starts at the
       same rose tone (#ffe4e6) the previous section ends on, blends into
       the reused about1.jpg photo through a semi-transparent red gradient,
       then settles into a solid red at the bottom for text legibility.
  ============================================================ -->
  <section class="py-24 lg:py-32 relative overflow-hidden">
    <!-- Background photo (reused from Hero/Story sections) -->
    <div class="absolute inset-0">
      <img
        src="/images/about/about1.jpg"
        alt=""
        aria-hidden="true"
        class="w-full h-full object-cover object-center"
        loading="lazy"
      />
      <!-- Gradient overlay: starts exactly at the previous section's end color for a seamless join -->
      <div
        class="absolute inset-0"
        style="background: linear-gradient(to bottom,
          #ffe4e6 0%,
          rgba(253,164,175,0.90) 10%,
          rgba(244,63,94,0.85) 26%,
          rgba(220,38,38,0.90) 48%,
          rgba(185,28,28,0.95) 70%,
          #991b1b 100%);"
      ></div>
    </div>

    <!-- Decorative blurs -->
    <div class="absolute -top-24 -right-16 w-80 h-80 bg-rose-300/25 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -left-16 w-80 h-80 bg-red-900/30 rounded-full blur-3xl pointer-events-none"></div>
    <div
      class="absolute inset-0 opacity-[0.05] pointer-events-none"
      style="background-image: radial-gradient(circle, #ffffff 1px, transparent 1px); background-size: 32px 32px;"
    ></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <div class="about-reveal flex items-center justify-center gap-3 mb-6">
          <span class="w-8 h-px bg-white/60"></span>
