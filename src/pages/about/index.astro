---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="About Us | PT Prasetia Dwidharma">
  <!-- Hero Section -->
  <div class="relative bg-gradient-to-br from-red-900 via-red-800 to-black text-white py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-red-200 text-xs font-medium uppercase tracking-wider mb-6">
            Company Profile
          </div>
          <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-6">
            PT Prasetia Dwidharma
          </h1>
          <p class="text-xl md:text-2xl text-gray-200 font-light leading-relaxed max-w-3xl">
            Was founded in 2008. Since then we have grown to become a major player in the industry, currently we have four divisions under our company.
          </p>
        </div>

        <div class="lg:col-span-4 flex justify-start lg:justify-end">
          <!-- ISO Certificate Badge Mockup/Container -->
          <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-6 text-center max-w-xs">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full border-2 border-white/40 flex items-center justify-center font-serif text-2xl font-bold">
              R
            </div>
            <div class="text-xs uppercase tracking-widest text-red-200 font-semibold mb-1">Lloyd's Register</div>
            <div class="text-sm font-bold tracking-tight text-white mb-2">ISO 9001 CERTIFIED</div>
            <div class="text-[11px] text-gray-300 leading-tight">
              UKAS Management Systems 001 Quality Assurance
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Vision & Mission Section -->
  <div class="py-16 md:py-24 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16">
        <!-- Vision -->
        <div class="bg-gray-50 rounded-2xl p-8 md:p-12 border border-gray-200/80 hover:border-red-200 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-red-100 text-red-600 flex items-center justify-center mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">Vision</h2>
          <p class="text-lg text-gray-700 leading-relaxed">
            To be the most innovative and customer centric ICT (Information and Communications Technology) solution provider in Indonesia.
          </p>
        </div>

        <!-- Mission -->
        <div class="bg-gray-50 rounded-2xl p-8 md:p-12 border border-gray-200/80 hover:border-red-200 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-red-100 text-red-600 flex items-center justify-center mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">Mission</h2>
          <p class="text-lg text-gray-700 leading-relaxed">
            Partnering with customers in reaching their potential through better technology and communications infrastructure.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Four Divisions Overview Section -->
  <div class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs font-bold text-red-600 tracking-wider uppercase mb-2">Our Businesses</h2>
        <h3 class="text-3xl md:text-4xl font-bold text-gray-900">
          Four Core Divisions
        </h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Division 1 -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg hover:border-red-200 transition-all flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-red-50 text-red-600 flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.14 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />
              </svg>
            </div>
            <h4 class="text-lg font-bold text-gray-900 mb-3">
              Telecommunication & Infrastructure Contractor
            </h4>
            <p class="text-sm text-gray-600 leading-relaxed">
              We provide tower construction services, starting from planning up to construction.
            </p>
          </div>
          <div class="mt-6 pt-6 border-t border-gray-100">
            <a href="/products-services/telecommunication-infrastructure" class="text-sm font-semibold text-red-600 hover:text-red-700 inline-flex items-center gap-1">
              Explore Division &rarr;
            </a>
          </div>
        </div>

        <!-- Division 2 -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg hover:border-red-200 transition-all flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-red-50 text-red-600 flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <h4 class="text-lg font-bold text-gray-900 mb-3">
              Information & Communication Technology
            </h4>
            <p class="text-sm text-gray-600 leading-relaxed">
              We provide ICT products and services to corporates, governments and retails.
            </p>
          </div>
          <div class="mt-6 pt-6 border-t border-gray-100">
            <a href="/products-services" class="text-sm font-semibold text-red-600 hover:text-red-700 inline-flex items-center gap-1">
              Explore Division &rarr;
            </a>
          </div>
        </div>

        <!-- Division 3 -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg hover:border-red-200 transition-all flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-red-50 text-red-600 flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <h4 class="text-lg font-bold text-gray-900 mb-3">
              Business Process Outsourcing
            </h4>
            <p class="text-sm text-gray-600 leading-relaxed">
              We provide Outsourcing Services for different sectors like telco and CRM by providing contact center solutions.
            </p>
          </div>
          <div class="mt-6 pt-6 border-t border-gray-100">
            <a href="/products-services/bpo-crm-technology/call-center" class="text-sm font-semibold text-red-600 hover:text-red-700 inline-flex items-center gap-1">
              Explore Division &rarr;
            </a>
          </div>
        </div>

        <!-- Division 4 -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg hover:border-red-200 transition-all flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-red-50 text-red-600 flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h4 class="text-lg font-bold text-gray-900 mb-3">
              Investment
            </h4>
            <p class="text-sm text-gray-600 leading-relaxed">
              An early-stage investment company, has been a part of the initial growth stories of several startups in Southeast Asia.
            </p>
          </div>
          <div class="mt-6 pt-6 border-t border-gray-100">
            <a href="/investment" class="text-sm font-semibold text-red-600 hover:text-red-700 inline-flex items-center gap-1">
              Explore Division &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
