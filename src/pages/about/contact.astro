---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Contact | PT Prasetia Dwidharma" transparentNavbar={true}>

  <style>
    /* ─── Design tokens — putih bersih + merah cerah sebagai aksen ─── */
    :root {
      --pd-red: #d81f2a;
      --pd-red-light: #ef3b40;
      --pd-red-dark: #a3121a;
      --pd-ink: #1a1414;
      --pd-white: #ffffff;
      --pd-offwhite: #f7f7f7;
    }

    /* ─── Reveal animation ─── */
    .contact-reveal {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .contact-reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    .contact-reveal-d1 { transition-delay: 0.08s; }
    .contact-reveal-d2 { transition-delay: 0.16s; }
    .contact-reveal-d3 { transition-delay: 0.24s; }
    .contact-reveal-d4 { transition-delay: 0.32s; }

    @media (prefers-reduced-motion: reduce) {
      .contact-reveal, .contact-title-line::after {
        transition: none !important;
      }
      .contact-reveal { opacity: 1 !important; transform: none !important; }
    }

    /* ─── Hero — besar lagi, merah cerah sebagai overlay tipis ─── */
    .contact-hero {
      position: relative;
      min-height: 82vh;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      background: var(--pd-ink);
    }
    .contact-hero-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 30%;
    }
    .contact-hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        160deg,
        rgba(216, 31, 42, 0.38) 0%,
        rgba(26, 20, 20, 0.55) 55%,
        rgba(15, 12, 12, 0.82) 100%
      );
    }
    .contact-hero::after {
      content: '';
      position: absolute;
      left: 0; right: 0; bottom: 0;
      height: 130px;
      background: linear-gradient(to bottom, rgba(0,0,0,0), var(--pd-white));
      pointer-events: none;
    }

    .contact-title-line {
      display: inline-block;
      position: relative;
    }
    .contact-title-line::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -2px;
      width: 0;
      height: 2px;
      background: #fff;
      transition: width 1s cubic-bezier(0.16, 1, 0.3, 1) 0.4s;
    }
    .contact-title-line.is-visible::after {
      width: 100%;
    }

    /* ─── Intro / info section ─── */
    .contact-info-section {
      background: var(--pd-white);
    }
    .contact-label {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--pd-red);
    }
    .contact-divider {
      height: 2px;
      background: linear-gradient(to right, var(--pd-red), rgba(216,31,42,0));
    }

    /* ─── WhatsApp CTA — merah cerah, gradient halus tanpa efek aneh ─── */
    .contact-wa-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.85rem 1.7rem;
      background: linear-gradient(135deg, var(--pd-red) 0%, var(--pd-red-light) 100%);
      color: #fff;
      font-weight: 600;
      font-size: 0.9rem;
      letter-spacing: 0.01em;
      border-radius: 4px;
      text-decoration: none;
      transition: transform 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
    }
    .contact-wa-btn:hover {
      filter: brightness(1.06);
      box-shadow: 0 8px 20px -8px rgba(216, 31, 42, 0.55);
      transform: translateY(-1px);
    }

    .contact-phone-link {
      text-decoration: none;
      color: inherit;
      transition: color 0.25s ease;
    }
    .contact-phone-link:hover {
      color: var(--pd-red);
    }

    /* ─── Split layout ─── */
    .contact-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 380px;
    }
    @media (max-width: 768px) {
      .contact-split { grid-template-columns: 1fr; }
    }

    .contact-red-panel {
      background: linear-gradient(135deg, var(--pd-red-dark) 0%, var(--pd-red) 100%);
      color: #fff;
      padding: 4rem 2.75rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .contact-white-panel {
      background: var(--pd-white);
      padding: 4rem 2.75rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    @media (max-width: 1024px) {
      .contact-red-panel, .contact-white-panel { padding: 3rem 1.75rem; }
    }

    /* ─── Address block ─── */
    .contact-address-section {
      background: var(--pd-offwhite);
    }

    /* ─── Closing CTA — merah cerah lagi, senada hero ─── */
    .contact-closing {
      background: linear-gradient(135deg, var(--pd-ink) 0%, var(--pd-red-dark) 130%);
      color: #fff;
      position: relative;
      overflow: hidden;
    }
    .contact-closing::before {
      content: '';
      position: absolute;
      right: -10%;
      bottom: -35%;
      width: 42%;
      padding-bottom: 42%;
      background: radial-gradient(circle, rgba(216,31,42,0.3) 0%, rgba(216,31,42,0) 70%);
      pointer-events: none;
    }

    /* ─── Tipografi — hero besar lagi, sisanya tetap rapi ─── */
    .pd-h1 { font-size: clamp(2.2rem, 5.5vw, 4rem); letter-spacing: -0.02em; line-height: 1.05; font-weight: 700; }
    .pd-h2 { font-size: clamp(1.35rem, 2.2vw, 1.85rem); letter-spacing: -0.01em; line-height: 1.15; font-weight: 600; }
    .pd-h2-lg { font-size: clamp(1.5rem, 2.6vw, 2.15rem); letter-spacing: -0.01em; line-height: 1.15; font-weight: 600; }
    .pd-statement { font-size: clamp(1.2rem, 2.1vw, 1.7rem); letter-spacing: -0.005em; line-height: 1.4; font-weight: 500; }
    .pd-phone { font-size: clamp(1.2rem, 1.8vw, 1.55rem); letter-spacing: -0.005em; font-weight: 600; }
  </style>

  <section class="contact-hero" aria-label="Contact Hero">
    <img src="/images/governance/gcg2.jpg" alt="Prasetia professional team" class="contact-hero-img" />
    <div class="contact-hero-overlay" aria-hidden="true"></div>

    <div class="relative z-10 w-full px-6 sm:px-10 lg:px-20 pb-14 md:pb-20">
      <div class="max-w-2xl">
        <p class="contact-reveal contact-label mb-4" style="color: rgba(255,210,210,0.95);">Get in Touch</p>
        <h1 class="contact-reveal contact-reveal-d1 pd-h1 text-white mb-4">
          <span class="contact-title-line block">Let's start</span>
          <span class="contact-title-line block" style="transition-delay:0.1s;">a conversation.</span>
        </h1>
        <p class="contact-reveal contact-reveal-d2 text-white/75 text-base md:text-lg font-light max-w-md leading-relaxed">
          Kami siap mendengarkan kebutuhan Anda dan memberikan solusi terbaik untuk bisnis Anda.
        </p>
      </div>
    </div>
  </section>

  <section class="contact-info-section py-14 md:py-20 px-6 sm:px-10 lg:px-20">
    <div class="max-w-7xl mx-auto">
      <div class="contact-divider mb-8" style="max-width: 56px;"></div>
      <p class="contact-reveal pd-statement text-gray-900" style="max-width: 600px;">
        Satu pesan bisa menjadi awal dari kemitraan yang luar biasa.
      </p>
      <p class="contact-reveal contact-reveal-d1 text-gray-500 mt-4 text-sm md:text-base font-light max-w-md leading-relaxed">
        Hubungi tim kami melalui WhatsApp atau telepon — kami akan merespons dengan cepat dan profesional.
      </p>
    </div>
  </section>

  <div class="contact-split">
    <div class="contact-red-panel">
      <div class="contact-reveal">
        <p class="contact-label mb-2" style="color: rgba(255,215,215,0.9);">Direct Chat</p>
        <h2 class="pd-h2-lg text-white mb-3">WhatsApp</h2>
        <p class="text-white/75 text-sm md:text-base font-light mb-6 max-w-xs leading-relaxed">
          Chat langsung dengan tim sales kami. Respons cepat, profesional, dan siap membantu kapan pun Anda butuhkan.
        </p>
        <a href="https://api.whatsapp.com/send?phone=6281390090338" target="_blank" rel="noopener noreferrer" class="contact-wa-btn" aria-label="Chat with Prasetia on WhatsApp"><svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg><span>Chat on WhatsApp</span></a>
      </div>
    </div>

    <div class="contact-white-panel">
      <div class="contact-reveal contact-reveal-d1">
        <p class="contact-label mb-2">Phone</p>
        <h2 class="pd-h2-lg text-gray-900 mb-3">Call Us</h2>
        <p class="text-gray-500 text-sm md:text-base font-light mb-5 max-w-xs leading-relaxed">
          Bicara langsung dengan tim kami melalui telepon untuk konsultasi lebih lanjut.
        </p>
        <a href="tel:+622131141177" class="contact-phone-link" aria-label="Call Prasetia at +62 21 31141177"><span class="pd-phone text-gray-900">+62 21 31141177</span></a>
      </div>
    </div>
  </div>

  <section class="contact-address-section py-14 md:py-20 px-6 sm:px-10 lg:px-20">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start">
        <div class="contact-reveal">
          <p class="contact-label mb-2">Our Location</p>
          <h2 class="pd-h2 text-gray-900">Jakarta<br/><span class="text-gray-400">Office</span></h2>
          <div class="contact-divider mt-5" style="max-width: 40px;"></div>
        </div>

        <div class="contact-reveal contact-reveal-d1">
          <address class="not-italic">
            <p class="text-gray-800 font-medium leading-relaxed mb-1 text-sm md:text-base">Graha Aruna,</p>
            <p class="text-gray-800 font-medium leading-relaxed mb-4 text-sm md:text-base">Jalan Antara No. 47 / Kel. Pasar Baru,<br/>Sawah Besar, Jakarta Pusat 10710</p>
            <div class="contact-divider mb-4" style="max-width: 32px;"></div>
            <p class="text-gray-500 text-xs md:text-sm">Building Management</p>
            <a href="tel:+622135244999" class="contact-phone-link text-gray-700 font-medium text-sm md:text-base mt-1 inline-block">Telp. (021) 352 4999</a>
          </address>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-closing py-16 px-6 sm:px-10 lg:px-20">
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="contact-reveal flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <p class="contact-label mb-2" style="color: rgba(255,180,180,0.9);">Ready to talk?</p>
          <h2 class="pd-h2 text-white" style="max-width: 400px;">Mulai percakapan Anda hari ini.</h2>
        </div>
        <a href="https://api.whatsapp.com/send?phone=6281390090338" target="_blank" rel="noopener noreferrer" class="contact-wa-btn flex-shrink-0" aria-label="Start a WhatsApp conversation with Prasetia"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg><span>Chat on WhatsApp</span></a>
      </div>
    </div>
  </section>

</MainLayout>

<script>
  const observer = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -48px 0px' }
  );
  document.querySelectorAll('.contact-reveal, .contact-title-line').forEach(el => observer.observe(el));
</script>