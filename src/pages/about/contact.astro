---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Contact Us | PT Prasetia Dwidharma">
  <!-- Hero Section -->
  <div class="relative bg-gradient-to-r from-gray-900 via-gray-800 to-black text-white py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 opacity-30">
      <img src="/images/hero/hero2.jpg" alt="Prasetia Office" class="w-full h-full object-cover" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-gray-900/80 to-transparent"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-red-600/30 border border-red-500/40 text-red-200 text-xs font-semibold uppercase tracking-wider mb-6">
        Get In Touch
      </div>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-6">
        Contact Us
      </h1>
      <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed font-light">
        Reach out to our team for partnerships, enterprise solutions, or business inquiries.
      </p>
    </div>
  </div>

  <!-- Contact Content Section -->
  <div class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left: Speak With Our Sales & Office Info -->
        <div class="lg:col-span-6 space-y-8">
          <div class="bg-white rounded-2xl p-8 md:p-10 border border-gray-200 shadow-sm">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">
              Speak With Our Sales:
            </h2>

            <div class="space-y-6">
              <!-- Chat Only -->
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-green-50 text-green-600 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.592 2.654-.697c1.002.598 1.956.884 2.806.884 3.181 0 5.767-2.586 5.767-5.766.001-3.18-2.585-5.766-5.767-5.766zm4.186 8.217c-.172.484-.997.925-1.393.963-.38.037-.872.181-2.906-.662-1.727-.716-2.836-2.476-2.922-2.59-.086-.115-.698-.928-.698-1.77 0-.842.441-1.256.598-1.428.157-.172.344-.215.459-.215.115 0 .23 0 .33.007.107.008.25.04.387.369.144.344.488 1.19.53 1.277.043.086.072.187.014.301-.057.115-.086.187-.172.287-.086.1-.181.223-.258.3-.086.086-.176.18-.076.352.1.172.443.731.951 1.184.654.582 1.205.763 1.377.849.172.086.273.072.373-.043.1-.115.43-.502.545-.674.115-.172.23-.143.387-.086.158.057.99.467 1.161.553.172.086.287.129.33.201.043.072.043.416-.129.9z" />
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">
                    WhatsApp (Chat Only)
                  </div>
                  <a
                    href="http://wa.link/v837x2"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-lg font-bold text-gray-900 hover:text-green-600 transition-colors inline-flex items-center gap-1.5"
                  >
                    <span>http://wa.link/v837x2</span>
                    <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                </div>
              </div>

              <!-- Phone -->
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-red-50 text-red-600 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">
                    Phone
                  </div>
                  <a href="tel:+622131141177" class="text-lg font-bold text-gray-900 hover:text-red-600 transition-colors">
                    +62 21 31141177
                  </a>
                </div>
              </div>
            </div>

            <!-- Address -->
            <div class="mt-8 pt-8 border-t border-gray-100">
              <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">
                Jakarta Head Office
              </h3>
              <p class="text-gray-700 leading-relaxed font-medium">
                Graha Aruna, Jalan Antara No. 47<br />
                Kel. Pasar Baru, Sawah Besar<br />
                Jakarta Pusat 10710
              </p>
              
              <div class="mt-4 pt-4 border-t border-gray-100 text-sm text-gray-600">
                <span class="font-medium text-gray-900">Telp. (021) 352 4999</span> (Building Management)
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Message Form -->
        <div class="lg:col-span-6">
          <div class="bg-white rounded-2xl p-8 md:p-10 border border-gray-200 shadow-sm">
            <h2 class="text-2xl font-bold text-gray-900 mb-2">
              Send Us a Message
            </h2>
            <p class="text-sm text-gray-600 mb-8">
              Fill out the form below and our team will get back to you shortly.
            </p>

            <form class="space-y-5">
              <div>
                <label for="name" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">
                  Full Name *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Your full name"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="email" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">
                    Email Address *
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="name@company.com"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500"
                  />
                </div>
                <div>
                  <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">
                    Phone Number
                  </label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    placeholder="+62 812..."
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500"
                  />
                </div>
              </div>

              <div>
                <label for="division" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">
                  Business Division / Subject
                </label>
                <select
                  id="division"
                  name="division"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 bg-white"
                >
                  <option value="telco">Telecommunication & Infrastructure Contractor</option>
                  <option value="ict">Information & Communication Technology (ICT)</option>
                  <option value="bpo">Business Process Outsourcing (BPO / CRM)</option>
                  <option value="biotech">Agriculture & Biotech</option>
                  <option value="investment">Investment & Startup Acceleration</option>
                  <option value="general">General Inquiries</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">
                  Your Message *
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  required
                  placeholder="How can we help your business?"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500"
                ></textarea>
              </div>

              <div>
                <button
                  type="submit"
                  class="w-full px-6 py-3.5 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg text-sm transition-colors shadow-sm"
                >
                  Submit Inquiry
                </button>
              </div>
            </form>
          </div>
        </div>

      </div>
    </div>
  </div>
</MainLayout>
