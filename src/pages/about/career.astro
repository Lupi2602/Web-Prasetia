    ]
  }

  // 👆 Tambahkan/hapus blok lowongan di atas sesuai kebutuhan
];
---

<MainLayout title="Careers | PT Prasetia Dwidharma" transparentNavbar={true}>

  <style>
    /* ─── Reveal animation (dipakai di semua section) ─── */
    .career-reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .career-reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    .career-reveal-d1 { transition-delay: 0.08s; }
    .career-reveal-d2 { transition-delay: 0.16s; }
    .career-reveal-d3 { transition-delay: 0.24s; }

    @media (prefers-reduced-motion: reduce) {
      .career-reveal {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }

    /* ─── Cegah scroll horizontal di seluruh halaman career ─── */
    .career-page-wrap {
      overflow-x: hidden;
      width: 100%;
    }

    /* ─── HERO ─── */
    .career-hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      background: #111;
    }
    @media (max-width: 640px) {
      .career-hero { min-height: 86vh; }
    }
    .career-hero-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 30%;
      transform: scale(1.03);
    }
    .career-hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        rgba(20, 20, 20, 0.12) 0%,
        rgba(20, 20, 20, 0.35) 55%,
        rgba(12, 12, 12, 0.72) 100%
      );
    }
    .career-hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.75);
    }
    .career-hero-eyebrow::before {
      content: "";
      width: 24px;
      height: 1px;
      background: rgba(255,255,255,0.5);
    }

    /* ─── DIVIDER ─── */
    .career-divider {
      height: 2px;
      width: 40px;
      background: #dc2626;
      border-radius: 2px;
    }

    /* ─── Section label kecil di atas judul (netral, tidak neon) ─── */
    .career-eyebrow-red {
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #b91c1c;
    }

    /* ─── POSITIONS: list minimalis ─── */
    .career-positions {
      background: #fff;
      overflow-x: hidden;
    }
    .career-position-row {
      border-top: 1px solid #ececec;
      cursor: pointer;
      transition: background 0.25s ease;
    }
    .career-position-row:last-child {
      border-bottom: 1px solid #ececec;
    }
    .career-position-row:hover {
      background: #fafafa;
    }
    .career-position-header {
      display: grid;
      grid-template-columns: 1.75rem minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.85rem;
      padding: 1.3rem 0;
    }
    @media (max-width: 640px) {
      .career-position-header {
        grid-template-columns: 1.5rem minmax(0, 1fr) auto;
        gap: 0.6rem;
        padding: 1rem 0;
      }
    }
    .career-position-num {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: #dc2626;
      font-variant-numeric: tabular-nums;
    }
    .career-position-title-wrap {
      min-width: 0; /* penting: supaya title bisa wrap/truncate, tidak dorong layout */
    }
    .career-position-title {
      font-weight: 700;
      letter-spacing: -0.01em;
      color: #1a1a1a;
      font-size: 0.98rem;
      line-height: 1.3;
      transition: color 0.2s;
      overflow-wrap: break-word;
    }
    @media (max-width: 640px) {
      .career-position-title { font-size: 0.88rem; }
    }
    .career-position-row:hover .career-position-title {
      color: #b91c1c;
    }
    .career-position-company {
      font-size: 0.74rem;
      color: #9ca3af;
      font-weight: 500;
      margin-top: 0.15rem;
      overflow-wrap: break-word;
    }
    .career-position-meta {
      font-size: 0.72rem;
      color: #a9a9a9;
      font-weight: 500;
      text-align: right;
      max-width: 9rem;
      line-height: 1.4;
    }
    @media (min-width: 768px) {
      .career-position-meta { max-width: 13rem; }
    }
    .career-position-arrow {
      width: 16px;
      height: 16px;
      color: #cfcfcf;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s;
      flex-shrink: 0;
    }
    .career-position-row.is-open .career-position-arrow {
      transform: rotate(90deg);
      color: #dc2626;
    }

    /* ─── Accordion detail panel ─── */
    .career-detail-panel {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .career-detail-panel.is-open {
      max-height: 1400px;
    }
    .career-detail-inner {
      padding-bottom: 1.75rem;
      padding-left: calc(1.75rem + 0.85rem);
      padding-right: 0.5rem;
    }
    @media (max-width: 640px) {
      .career-detail-inner {
        padding-left: calc(1.5rem + 0.6rem);
      }
    }

    .career-qual-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .career-qual-list li {
      display: flex;
      align-items: flex-start;
      gap: 0.65rem;
      padding: 0.45rem 0;
      font-size: 0.84rem;
      color: #555;
      line-height: 1.55;
      border-bottom: 1px solid #f5f5f5;
    }
    .career-qual-list li:last-child { border-bottom: none; }
    .career-qual-dot {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: #dc2626;
      flex-shrink: 0;
      margin-top: 0.5rem;
    }
    .career-section-label {
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #b91c1c;
    }

    /* ─── CTA / Apply section — center, tanpa container, tanpa efek neon ─── */
    .career-apply-section {
      position: relative;
      overflow: hidden;
      isolation: isolate;
    }
    .career-apply-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 35%;
      z-index: -2;
    }
    .career-apply-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        rgba(15, 15, 15, 0.6) 0%,
        rgba(15, 15, 15, 0.5) 50%,
        rgba(15, 15, 15, 0.68) 100%
      );
      z-index: -1;
    }
    .career-apply-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.78rem 1.5rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.82rem;
      letter-spacing: 0.01em;
      transition: transform 0.2s ease, background 0.25s, border-color 0.25s;
      white-space: nowrap;
    }
    .career-apply-btn:hover { transform: translateY(-2px); }
    .career-apply-btn-ghost {
      border: 1.5px solid rgba(255,255,255,0.4);
      color: #fff;
      background: rgba(0,0,0,0.2);
    }
    .career-apply-btn-ghost:hover {
      background: rgba(255,255,255,0.1);
      border-color: rgba(255,255,255,0.65);
    }
    .career-apply-btn-solid {
      background: #dc2626;
      color: #fff;
      border: 1.5px solid #dc2626;
    }
    .career-apply-btn-solid:hover { background: #b91c1c; border-color: #b91c1c; }

    .career-antifraud {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: rgba(255,255,255,0.92);
      border: 1px solid rgba(255,255,255,0.28);
      border-radius: 8px;
      padding: 0.6rem 1.05rem;
      background: rgba(0, 0, 0, 0.35);
    }
  </style>

  <div class="career-page-wrap">

  <!-- ════════════════════════════════════
       HERO
  ════════════════════════════════════ -->
  <section class="career-hero" aria-label="Career Hero">
    <!-- 🖼️ Ganti gambar hero di sini kalau perlu -->
    <img
      src="/images/hero/hero1.jpg"
      alt="Prasetia team working together"
      class="career-hero-img"
    />
    <div class="career-hero-overlay" aria-hidden="true"></div>

    <div class="relative z-10 w-full px-6 sm:px-10 lg:px-20 pb-14 md:pb-20">
      <div class="max-w-3xl">
        <p class="career-reveal career-hero-eyebrow mb-5">Open Positions</p>
        <h1
          class="career-reveal career-reveal-d1 text-white font-bold leading-tight mb-4"
          style="font-size: clamp(1.6rem, 3.4vw, 2.6rem); letter-spacing: -0.02em; text-shadow: 0 2px 16px rgba(0,0,0,0.4);"
        >
          Bangun Babak<br/>Karir Berikutnya <span class="text-white/50">Bersama Kami.</span>
        </h1>
        <p class="career-reveal career-reveal-d2 text-white/80 text-sm md:text-base font-light max-w-lg leading-relaxed" style="text-shadow: 0 1px 8px rgba(0,0,0,0.35);">
          Kami mencari individu yang tepat dan sesuai harapan — yang ingin tumbuh, belajar, dan memberi dampak nyata.
        </p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════
       PHILOSOPHY / INTRO
  ════════════════════════════════════ -->
  <section class="bg-white py-16 md:py-20 px-6 sm:px-10 lg:px-20">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-start">
        <div class="career-reveal">
          <div class="career-divider mb-5"></div>
          <h2
            class="text-gray-900 font-bold leading-snug"
            style="font-size: clamp(1.25rem, 2.1vw, 1.65rem); letter-spacing: -0.01em;"
          >
            Lebih dari sekadar pekerjaan — ini adalah perjalanan karir Anda.
          </h2>
        </div>
        <div class="career-reveal career-reveal-d1 flex flex-col justify-center">
          <p class="text-gray-500 text-sm md:text-base font-light leading-relaxed mb-4">
            Di Prasetia, kami percaya bahwa setiap individu membawa potensi unik. Kami memberikan ruang untuk berkembang, lingkungan yang suportif, dan tantangan nyata yang akan membentuk Anda menjadi profesional terbaik.
          </p>
          <p class="text-gray-500 text-sm md:text-base font-light leading-relaxed">
            Bergabunglah dengan tim kami dan jadilah bagian dari cerita besar Prasetia Group.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════
       OPEN POSITIONS — LIST
  ════════════════════════════════════ -->
  <section class="career-positions py-14 md:py-20 px-6 sm:px-10 lg:px-20" id="vacancies">
    <div class="max-w-6xl mx-auto">

      <div class="career-reveal flex items-end justify-between mb-8 gap-4 flex-wrap">
        <div>
          <p class="career-eyebrow-red mb-2">Open Vacancies</p>
          <h2
            class="text-gray-900 font-bold leading-tight"
            style="font-size: clamp(1.3rem, 2.3vw, 1.8rem); letter-spacing: -0.015em;"
          >
            Posisi Tersedia
          </h2>
        </div>
        <p class="text-gray-400 text-xs md:text-sm">Klik posisi untuk melihat kualifikasi</p>
      </div>

      <div class="career-accordion">
        {vacancies.map((job, idx) => (
          <div
            class="career-position-row career-reveal"
            style={`transition-delay: ${0.06 * idx}s;`}
            data-row
          >
            <div class="career-position-header" data-header>
              <span class="career-position-num">
                {String(idx + 1).padStart(2, '0')}
              </span>

              <div class="career-position-title-wrap">
                <div class="career-position-title">{job.title}</div>
                <div class="career-position-company">{job.company}</div>
              </div>

              <div class="flex items-center gap-2.5">
                <span class="career-position-meta hidden sm:block">{job.location}</span>
                <svg class="career-position-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>

            <div class="career-detail-panel" data-panel>
              <div class="career-detail-inner">
                <p class="text-xs text-gray-400 font-medium mb-3 sm:hidden flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {job.location}
                </p>

                <p class="career-section-label mb-3">Kualifikasi</p>
                <ul class="career-qual-list max-w-2xl">
                  {job.qualifications.map(q => (
                    <li>
                      <span class="career-qual-dot" aria-hidden="true"></span>
                      <span>{q}</span>
                    </li>
                  ))}
                </ul>

                {job.additionalSections && job.additionalSections.map(sec => (
                  <div class="mt-5">
                    <p class="career-section-label mb-2.5">{sec.heading}</p>
                    <ul class="career-qual-list max-w-2xl">
                      {sec.items.map(it => (
                        <li>
                          <span class="career-qual-dot" aria-hidden="true"></span>
                          <span>{it}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════
       APPLICATION CTA (center, langsung di atas foto)
  ════════════════════════════════════ -->
  <section class="career-apply-section py-24 md:py-32 px-6 sm:px-10 lg:px-20">
    <!-- 🖼️ Sengaja pakai gambar yang sama dengan hero agar halaman terasa menyatu -->
    <img src="/images/hero/hero1.jpg" alt="" class="career-apply-img" aria-hidden="true" />
    <div class="career-apply-overlay" aria-hidden="true"></div>

    <div class="max-w-2xl mx-auto text-center flex flex-col items-center">
      <div class="career-reveal flex flex-col items-center">

        <p class="career-eyebrow-red mb-4" style="color: rgba(255,255,255,0.7);">Bergabung Dengan Kami</p>
        <h2
          class="text-white font-bold leading-snug mb-3"
