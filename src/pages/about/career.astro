      "Memiliki karya akademik menjadi nilai tambah",
      "Bersedia melakukan perjalanan dinas",
      "Penempatan: Jakarta"
    ],
    additionalSections: [
      {
        heading: "Kemampuan Kerja Tambahan",
        items: [
          "Table manner dan sikap profesional yang baik",
          "Kemampuan presentasi yang baik",
          "Mahir dalam analisis data"
        ]
      },
      {
        heading: "Ciri Kepribadian",
        items: [
          "Ekstrovert, senang berinteraksi dengan orang lain",
          "Cerdas dan cepat belajar",
          "Komunikatif dan mudah bergaul",
          "Mampu membangun kepercayaan dan hubungan baik",
          "Persuasif dalam berkomunikasi"
        ]
      }
    ]
  },
  {
    title: "MARKETING SUPERVISOR",
    company: "PT PRASETIA DWIDHARMA",
    location: "Jakarta",
    qualifications: [
      "Minimal S1 di bidang Marketing, Komunikasi, Manajemen Bisnis, atau bidang terkait",
      "Minimal 2 tahun pengalaman kerja di bidang terkait, seperti perusahaan SaaS, teknologi, atau digital, lebih disukai pada posisi supervisor atau setara",
      "Kemampuan analisis kuat untuk membaca data pasar, mengidentifikasi peluang, dan mengukur performa marketing",
      "Menguasai perencanaan dan strategi marketing, branding, pengembangan produk, promosi, penjualan, dan brand management",
      "Berpengalaman dalam Event Management"
    ]
  },
  {
    title: "SALES SUPERVISOR",
    company: "PT PRASETIA DWIDHARMA TEKNOLOGI (PDT)",
    location: "Bali",
    qualifications: [
      "Minimal pendidikan S1",
      "Minimal 3-4 tahun pengalaman di bidang yang sama",
      "Usia maksimal 40 tahun",
      "Menguasai Microsoft Office, terutama Excel",
      "Memiliki minat di bidang sales",
      "Berorientasi pada target",
      "Mampu membangun hubungan baik dengan pelanggan",
      "Memiliki kemampuan leadership yang baik",
      "Penempatan di Bali"
    ]
  },
  {
    title: "BUSINESS DEVELOPMENT",
    company: "PT PRASETIA DWIDHARMA",
