---
import MainLayout from '../../layouts/MainLayout.astro';

/* ════════════════════════════════════════════════════════════════
   🔧 PENGATURAN UMUM — edit bagian ini kalau ada perubahan info
   lamaran (email, link, batas waktu, dll)
════════════════════════════════════════════════════════════════ */
const applyEmail = "hrd@prasetia.co.id";
const applyLink = "https://prasetia.sg.larksuite.com/share/base/form/shrusRG899ountEjCaWNi29Z5lg"; // link form lamaran — kosongkan "" untuk sembunyikan tombol
const closingDate = "Rolling Recruitment — lowongan dibuka sampai posisi terisi";

/* ════════════════════════════════════════════════════════════════
   📋 DAFTAR LOWONGAN — TEMPLATE MUDAH DIEDIT
   ════════════════════════════════════════════════════════════════
   CARA TAMBAH LOWONGAN BARU:
   1. Copy 1 blok "{ ... }," di bawah (dari tanda kurung kurawal
      pembuka sampai penutup + koma).
   2. Paste di posisi paling atas/bawah array (di antara tanda [ ]).
   3. Ganti isi title, company, location, dan qualifications sesuai
      kebutuhan. Setiap baris qualifications = 1 poin kualifikasi.

   CARA HAPUS LOWONGAN (posisi sudah ditutup):
   - Hapus 1 blok "{ ... }," secara utuh.

   CATATAN:
   - "additionalSections" itu OPSIONAL. Kalau lowongan tidak perlu
     bagian tambahan (misal "Personality Traits"), cukup hapus
     seluruh baris additionalSections: [ ... ] pada blok itu.
   - "location" usahakan singkat (1 baris) karena tampil di kanan
     daftar — detail lokasi lengkap bisa taruh di kualifikasi.
   - Jangan hapus tanda kutip " " dan koma , supaya kode tidak error.
════════════════════════════════════════════════════════════════ */
