---
import MainLayout from '../../layouts/MainLayout.astro';

const awards = [
  {
    issuer: "Mitratel",
    title: "The Charter of Appreciation",
    category: "Subcontractor Project Completion",
    year: "Mitratel Award",
    description: "Awarded to PT Prasetia Dwidharma in order of milestone project completion during the years operation."
  },
  {
    issuer: "Mitratel",
    title: "Piagam Penghargaan Kontribusi Terbaik",
    category: "Regional Office Sumbagsel Merah",
    year: "Palembang, 2014",
    description: "Atas kontribusi terhadap keberhasilan Regional Office Sumbagsel Merah (Best Regional Office Award)."
  },
  {
    issuer: "Mitratel",
    title: "Mitra Project CORE Area 2",
    category: "Performansi Terbaik",
    year: "2015",
    description: "Penghargaan sebagai Mitra Project CORE Area 2 dengan performansi terbaik tahun 2015."
  },
  {
    issuer: "Mitratel",
    title: "Mitra Project FLM Area 4",
    category: "Performansi Terbaik",
    year: "2015",
    description: "Penghargaan sebagai Mitra Project FLM Area 4 dengan performansi terbaik tahun 2015."
  },
  {
    issuer: "Tower Bersama Group",
    title: "Best Project Subcontractor",
    category: "New Build Capacity",
    year: "TBG Award",
    description: "Manajemen PT Tower Bersama Infrastructure, Tbk. memberikan penghargaan sebagai Best Project Subcontractor."
  },
  {
    issuer: "Tower Bersama Group",
    title: "Best Maintenance Subcontractor",
    category: "Maintenance Vendor",
    year: "TBG Award",
    description: "Penghargaan atas kinerja pemeliharaan infrastruktur menara telekomunikasi terbaik secara berkelanjutan."
  },
  {
    issuer: "Yayasan Konservasi",
    title: "Sertifikat Wali Pohon",
    category: "Environmental Sustainability",
    year: "CSR Program",
    description: "Penghargaan setinggi-tingginya atas partisipasi dan adopsi pohon konservasi hutan."
  },
  {
    issuer: "Telkomsel",
    title: "Certificate of Appreciation",
    category: "Best Support NBE Mataram",
    year: "2015 / 2019",
    description: "Certificate of appreciation proudly presented to the most 'Made For Mataram' Best Support NBE NS Mataram."
  },
  {
    issuer: "Tower Bersama Group",
    title: "Most Progressive New Build MSS Application",
    category: "TBG Yearly Award",
    year: "Yogyakarta, 2018",
    description: "Awarded as Most Progressive New Build MSS Application by PT Tower Bersama Infrastructure, Tbk."
  },
  {
    issuer: "Tower Bersama Group",
    title: "Best Project New Build Area 4",
    category: "TBG Yearly Award",
    year: "Yogyakarta, 2018",
    description: "Awarded as Best Project New Build Area 4 by PT Tower Bersama Infrastructure, Tbk."
  },
  {
    issuer: "Tower Bersama Group",
    title: "Best Project New Build Area 1",
    category: "TBG Yearly Award",
    year: "Yogyakarta, 2018",
    description: "Awarded as Best Project New Build Area 1 by PT Tower Bersama Infrastructure, Tbk."
  },
  {
    issuer: "Tower Bersama Group",
    title: "Best Project Microcellpole Area 1",
    category: "TBG Yearly Award",
    year: "Yogyakarta, 2018",
    description: "Awarded as Best Project Microcellpole Area 1 by PT Tower Bersama Infrastructure, Tbk."
  },
  {
    issuer: "Tower Bersama Group",
    title: "Best Project Collocation Area 4",
    category: "TBG Yearly Award",
    year: "Yogyakarta, 2018",
    description: "Awarded as Best Project Collocation Area 4 by PT Tower Bersama Infrastructure, Tbk."
  },
  {
    issuer: "Tower Bersama Group",
    title: "Vendor Maintenance Achievement Award",
    category: "Maintenance Support",
    year: "2015",
    description: "Certificate of Appreciation for Medium Capacity Maintenance Subcontractor performance."
  },
  {
    issuer: "Mitratel",
    title: "Mitra Terbaik V FLM",
    category: "First Line Maintenance",
    year: "2016 / 2017",
    description: "Diberikan kepada PT Prasetia Dwidharma sebagai Mitra Terbaik V FLM oleh Mitratel."
  }
];
---

<MainLayout title="Awards & Recognitions | PT Prasetia Dwidharma">
  <!-- Hero Section -->
  <div class="relative bg-gradient-to-r from-gray-900 via-gray-800 to-black text-white py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <img src="/images/hero/hero3.jpg" alt="Awards Hero" class="w-full h-full object-cover" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/80 to-transparent"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-red-600/30 border border-red-500/40 text-red-200 text-xs font-semibold uppercase tracking-wider mb-6">
        Excellence & Achievements
      </div>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-6">
        Awards & Recognitions
      </h1>
      <p class="text-lg md:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
        Recognition from our esteemed partners and telecommunications industry leaders for our continuous dedication to high quality engineering, safety, and service excellence.
      </p>
    </div>
  </div>

  <!-- Awards Grid Section -->
  <div class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {awards.map((award) => (
          <div class="bg-white rounded-2xl p-7 border border-gray-200 shadow-sm hover:shadow-md hover:border-red-200 transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-50 text-red-700 border border-red-100">
                  {award.issuer}
                </span>
                <span class="text-xs font-medium text-gray-500">
                  {award.year}
                </span>
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2 leading-snug">
                {award.title}
              </h3>
              <div class="text-xs font-semibold text-red-600 mb-3 uppercase tracking-wide">
                {award.category}
              </div>
              <p class="text-sm text-gray-600 leading-relaxed">
                {award.description}
              </p>
            </div>
            
            <div class="mt-6 pt-4 border-t border-gray-100 flex items-center gap-2 text-xs text-gray-500">
              <svg class="w-4 h-4 text-red-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 1.738 5.42a1 1 0 01-.285 1.05A3.989 3.989 0 0115 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.715-5.349L11 6.477V16h2a1 1 0 110 2H7a1 1 0 110-2h2V6.477L6.237 7.582l1.715 5.349a1 1 0 01-.285 1.05A3.989 3.989 0 015 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.738-5.42-1.233-.617a1 1 0 01.894-1.788l1.599.799L9 4.323V3a1 1 0 011-1z" clip-rule="evenodd" />
              </svg>
              <span>Verified Certificate of Merit</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Upload notice info banner -->
      <div class="mt-12 bg-white rounded-xl p-6 border border-gray-200 text-center text-sm text-gray-600 max-w-2xl mx-auto">
        <p>Original high-resolution certificate archive is maintained at PT Prasetia Dwidharma Head Office.</p>
      </div>
    </div>
  </div>
</MainLayout>
