const divisions = [
  {
    num: '01',
    title: 'Telekomunikasi & Infrastruktur',
    desc: 'Pembangunan tower, co-location, site acquisition, maintenance, dan fiber optic.',
    href: '/products-services/telecommunication-infrastructure/',
