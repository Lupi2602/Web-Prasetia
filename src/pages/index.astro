                </div>
                {i < clientLogos.length - 1 && <div class="logo-divider"></div>}
              </>
            ))}
            <!-- Duplicate for seamless loop -->
            {clientLogos.map((logo, i) => (
              <>
                <div class="logo-item">
                  <img src={logo.src} alt={logo.alt} loading="lazy" />
                </div>
