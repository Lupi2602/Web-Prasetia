  {
    src: '/images/awards/aw5.jpeg',
    issuer: 'Mitratel',
    title: 'Charter of Appreciation',
    note: 'Penyelesaian proyek Mitratel 2010–2011',
    year: '2011',
    alt: 'Sertifikat Charter of Appreciation dari Mitratel, September 2011',
  },
  {
