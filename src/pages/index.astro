    issuer: 'Tower Bersama Group',
    title: 'Best Project Subcontractor',
    note: "Kategori 'BIG' Capacity New Build",
    year: '2013',
    alt: 'Sertifikat Best Project Subcontractor dari Tower Bersama Group, 2013',
  },
  {
    src: '/images/awards/aw6.jpeg',
    issuer: 'Mitratel',
    title: 'Best Regional Office Awards 2013',
    note: 'Regional Sumbagsel Merah',
    year: '2014',
    alt: 'Piagam Best Regional Office Awards 2013 dari Mitratel',
  },
  {
    src: '/images/awards/aw14.jpg',
    issuer: 'Tower Bersama Group',
    title: 'Best Maintenance Vendor 2015',
