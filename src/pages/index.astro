    <Footer />

    <script>
      // Navbar dipaksa solid dan dijaga agar tidak kembali transparan saat scroll
      (function () {
        const navbar = document.getElementById('site-navbar');
        if (!navbar) return;
        const solid = () => {
          if (navbar.classList.contains('nav-transparent') || !navbar.classList.contains('nav-solid')) {
            navbar.classList.remove('nav-transparent');
            navbar.classList.add('nav-solid');
          }
        };
        solid();
        new MutationObserver(solid).observe(navbar, { attributes: true, attributeFilter: ['class'] });
      })();

      // Animasi muncul saat scroll
      (function () {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const items = document.querySelectorAll<HTMLElement>('.reveal');
        if (reduce || !('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        items.forEach((el) => io.observe(el));
      })();

      // Penanda aktif di daftar unggulan
      (function () {
        const links = document.querySelectorAll<HTMLAnchorElement>('.feat-nav a');
        const sections = document.querySelectorAll<HTMLElement>('.feat');
        if (!links.length || !sections.length) return;
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                links.forEach((l) =>
                  l.classList.toggle('active', l.dataset.target === e.target.id)
                );
              }
            });
          },
          { rootMargin: '-40% 0px -50% 0px' }
        );
        sections.forEach((s) => io.observe(s));
      })();

      // Penghargaan: preview berganti otomatis, bisa di-hover / di-tap / difokus
      (function () {
        const rows = document.querySelectorAll<HTMLElement>('.award-row');
        const slides = document.querySelectorAll<HTMLElement>('.award-slide');
        const caps = document.querySelectorAll<HTMLElement>('.award-cap');
        const card = document.querySelector<HTMLElement>('.award-card');
        if (!rows.length || !slides.length) return;

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let current = 0;
        let timer: number | undefined;

        const setActive = (i: number) => {
          current = i;
          rows.forEach((r, n) => {
            const on = n === i;
            r.classList.toggle('active', on);
            r.setAttribute('aria-current', on ? 'true' : 'false');
          });
          slides.forEach((s, n) => s.classList.toggle('active', n === i));
          caps.forEach((c, n) => c.classList.toggle('active', n === i));
        };
        const stop = () => {
          if (timer !== undefined) {
            window.clearInterval(timer);
            timer = undefined;
          }
        };
        const start = () => {
          if (reduce) return;
          stop();
          timer = window.setInterval(() => setActive((current + 1) % rows.length), 4500);
        };

        rows.forEach((r, i) => {
          r.addEventListener('mouseenter', () => { setActive(i); stop(); });
          r.addEventListener('mouseleave', start);
          r.addEventListener('focus', () => { setActive(i); stop(); });
          r.addEventListener('blur', start);
          r.addEventListener('click', () => { setActive(i); start(); });
        });
        card?.addEventListener('mouseenter', stop);
        card?.addEventListener('mouseleave', start);

        // Hanya berjalan saat section terlihat
        const section = document.getElementById('penghargaan');
        if (section && 'IntersectionObserver' in window) {
          new IntersectionObserver(
            (entries) => entries.forEach((e) => (e.isIntersecting ? start() : stop())),
            { threshold: 0.2 }
          ).observe(section);
        } else {
          start();
        }
      })();
    </script>

  </body>
</html>