  {
    num: '02',
    title: 'Teknologi Informasi & Komunikasi',
    desc: 'Solusi teknologi untuk perusahaan, seperti Lark, Oracle NetSuite, dan platform smart city.',
    href: '/products-services/ict/lark/',
  },
  {
    num: '03',
    title: 'Business Process Outsourcing',
    desc: 'Layanan contact center dan teknologi CRM untuk operator telekomunikasi dan perusahaan.',
    href: '/products-services/bpo-crm-technology/call-center/',
