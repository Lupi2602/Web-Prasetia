---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const clientLogos = [
  { src: '/images/client/logo-tower-bersama-group.png', alt: 'Tower Bersama Group' },
  { src: '/images/client/Logo_Mitratel.png', alt: 'Mitratel' },
  { src: '/images/client/logo-telkom-infra.jpg', alt: 'Telkom Infra' },
  { src: '/images/client/logo-protelindo.jpg', alt: 'Protelindo' },
  { src: '/images/client/logo-msn.png', alt: 'MSN' },
  { src: '/images/client/logo-MayapadaHospital.png', alt: 'Mayapada Hospital' },
