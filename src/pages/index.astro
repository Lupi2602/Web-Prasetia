---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="PT Prasetia Dwidharma menyediakan infrastruktur telekomunikasi dan solusi teknologi untuk perusahaan di Indonesia sejak 2008." />
    <title>PT Prasetia Dwidharma | Infrastruktur Telekomunikasi & Solusi Teknologi</title>
    <link rel="icon" type="image/png" href="/images/hero/logoweb.png" />

    <!-- ============ GLOBAL: variabel warna + perbaikan NAVBAR ============ -->
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }

      :root {
        /* Merah terang, bersih, tidak gelap */
        --red: #E11D27;
        --red-2: #EF3B3F;
        --red-dark: #C8151E;
        --red-tint: #FDE8E8;
        --ink: #1F2430;
        --text: #3D4452;
        --muted: #6B7280;
        --line: #F0E4E3;
        --max: 1200px;
        --edge: max(24px, calc((100vw - 1200px) / 2));
        --sec-y: clamp(56px, 8vw, 96px);

        /* Merah flat (tanpa gradient, tanpa bercak) */
        --grad: #E11D27;
      }

      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      img { max-width: 100%; }

      /* NAVBAR: dibuat solid putih supaya menu selalu terbaca */
      #site-navbar,
      #site-navbar.nav-transparent,
      #site-navbar.nav-solid {
        background: #fff !important;
        background-image: none !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        box-shadow: 0 1px 0 var(--line), 0 8px 24px rgba(31, 36, 48, 0.05) !important;
      }
      #site-navbar a,
      #site-navbar button,
      #site-navbar svg {
        color: var(--ink) !important;
        text-shadow: none !important;
      }
      #site-navbar a:hover,
      #site-navbar button:hover { color: var(--red) !important; }
    </style>

    <!-- ============ STYLE HALAMAN ============ -->
    <style>
      main { overflow-x: clip; }

      .wrap {
        max-width: var(--max);
        margin: 0 auto;
        padding: 0 24px;
      }

      /* Tipografi dasar */
      .label {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--red);
        margin-bottom: 14px;
      }
      .label::before {
        content: '';
        width: 22px;
        height: 2px;
        background: var(--red);
      }
      .h2 {
        font-size: clamp(1.4rem, 2.2vw, 1.85rem);
        font-weight: 800;
        line-height: 1.3;
        letter-spacing: -0.01em;
        color: var(--ink);
        margin: 0 0 14px;
      }
      .h2 em { font-style: normal; color: var(--red); }
      .lead {
        font-size: 15.5px;
        line-height: 1.8;
        color: var(--text);
        margin: 0;
      }

      /* ===== Section merah: flat, bersih, tanpa glow ===== */
      .sec-red {
        position: relative;
        overflow: hidden;
        background: var(--red);
        color: #fff;
      }
      .sec-red .label { color: #fff; }
      .sec-red .label::before { background: #fff; }
      .sec-red .h2 { color: #fff; }
      .sec-red .h2 em { color: #fff; text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; text-decoration-color: rgba(255,255,255,0.55); }
      .sec-red .lead { color: rgba(255, 255, 255, 0.96); }

      /* Tombol dan link teks */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        min-height: 48px;
        padding: 13px 28px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 700;
        text-align: center;
        text-decoration: none;
        border: 1.5px solid var(--red);
        background: var(--red);
        color: #fff;
        z-index: 0;
        transition: transform 0.3s ease, box-shadow 0.3s ease, color 0.3s ease;
      }
      .btn::before {
        content: '';
        position: absolute;
        inset: 0;
        background: var(--red-dark);
        transform: translateY(101%);
        transition: transform 0.35s ease;
        z-index: -1;
      }
      .btn:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(225, 29, 39, 0.28); }
      .btn:hover::before { transform: translateY(0); }

      .btn-line { background: transparent; color: var(--red); }
      .btn-line::before { background: var(--red); }
      .btn-line:hover { color: #fff; }

      .btn-white { background: #fff; border-color: #fff; color: var(--red); }
      .btn-white::before { background: var(--red-tint); }
      .btn-white:hover { color: var(--red-dark); box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16); }

      .btn-outline-white {
        background: transparent;
        border-color: rgba(255, 255, 255, 0.95);
        color: #fff;
      }
      .btn-outline-white::before { background: rgba(255, 255, 255, 0.2); }

      .btn:focus-visible, .tlink:focus-visible, .award-row:focus-visible, .award-card:focus-visible {
        outline: 3px solid rgba(225, 29, 39, 0.4);
        outline-offset: 3px;
      }
      .sec-red .btn:focus-visible, .sec-red .award-row:focus-visible, .sec-red .award-card:focus-visible { outline-color: rgba(255, 255, 255, 0.85); }

      .tlink {
        display: inline-block;
        font-size: 14px;
        font-weight: 700;
        color: var(--red);
        text-decoration: none;
        padding-bottom: 3px;
        background: linear-gradient(var(--red), var(--red)) left bottom / 100% 1.5px no-repeat;
        transition: background-size 0.35s ease, letter-spacing 0.35s ease;
      }
      .tlink:hover { background-size: 40% 1.5px; letter-spacing: 0.02em; }

      /* Animasi muncul saat scroll */
      .reveal {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.7s ease, transform 0.7s ease;
      }
      .reveal.visible { opacity: 1; transform: none; }
      .d1 { transition-delay: 0.08s; }
      .d2 { transition-delay: 0.16s; }
      .d3 { transition-delay: 0.24s; }
      .d4 { transition-delay: 0.32s; }

      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; transition: none; }
        .rise, .hero-photo, .hero-photo img, .marquee-track, .hero-dots i { animation: none !important; }
        .award-slide, .award-cap { transition: none !important; }
        html { scroll-behavior: auto; }
      }


      /* 1. HERO (putih) */
      .hero {
        padding: 132px 0 var(--sec-y);
        background: #fff;
        overflow: hidden;
      }
      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
        gap: 56px;
        align-items: center;
        padding-left: var(--edge);
        padding-right: 0;
      }
      .hero-text { max-width: 520px; padding-left: 24px; }
      .hero-dots { display: flex; gap: 7px; margin-bottom: 22px; }
      .hero-dots i {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--red);
        display: block;
        animation: dotPulse 2.4s ease-in-out infinite;
      }
      .hero-dots i:nth-child(2) { animation-delay: 0.25s; opacity: 0.7; }
      .hero-dots i:nth-child(3) { animation-delay: 0.5s; opacity: 0.4; }
      @keyframes dotPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.35); }
      }

      /* Tulisan selamat datang: tegas, tanpa italic/serif */
      .hero-welcome {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin: 0 0 22px;
      }
      .hw-small {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .hw-small::before {
        content: '';
        width: 36px;
        height: 2px;
        background: var(--red);
      }
      .hw-name {
        font-family: inherit;
        font-style: normal;
        font-weight: 800;
        font-size: clamp(1.15rem, 2.2vw, 1.55rem);
        line-height: 1.2;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--red);
      }

      .hero h1 {
        font-size: clamp(1.75rem, 3.2vw, 2.6rem);
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.02em;
        color: var(--ink);
        margin: 0 0 18px;
      }
      .hero h1 em { font-style: normal; color: var(--red); }
      .hero p {
        font-size: 16px;
        line-height: 1.8;
        color: var(--text);
        margin: 0 0 32px;
      }
      .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

      .hero-photo {
        width: 100%;
        aspect-ratio: 5 / 4;
        border-radius: 140px 0 0 140px;
        overflow: hidden;
        animation: photoReveal 1.3s cubic-bezier(0.22, 1, 0.36, 1) both 0.15s;
      }
      .hero-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        animation: photoZoom 2.4s ease-out both;
      }
      @keyframes photoReveal {
        from { clip-path: inset(0 0 0 100%); }
        to   { clip-path: inset(0 0 0 0); }
      }
      @keyframes photoZoom {
        from { transform: scale(1.12); }
        to   { transform: scale(1); }
      }
      .rise { animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both; }
      .rise.r1 { animation-delay: 0.05s; }
      .rise.r2 { animation-delay: 0.18s; }
      .rise.r3 { animation-delay: 0.3s; }
      .rise.r4 { animation-delay: 0.42s; }
      .rise.r5 { animation-delay: 0.54s; }
      @keyframes rise {
        from { opacity: 0; transform: translateY(22px); }
        to   { opacity: 1; transform: none; }
      }


      /* 2. PROFIL SINGKAT (merah) */
      .about-intro { padding: var(--sec-y) 0; }
      .about-intro-grid {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 72px;
        align-items: center;
      }
      .about-intro .h2 {
        font-size: clamp(1.7rem, 3vw, 2.4rem);
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 18px;
      }
      .about-intro .lead { max-width: 540px; margin-bottom: 28px; }
      .about-intro-img {
        border-radius: 20px 20px 100px 20px;
        overflow: hidden;
        aspect-ratio: 4 / 3;
        box-shadow: 0 24px 50px rgba(0, 0, 0, 0.18);
      }
      .about-intro-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.9s ease;
      }
      .about-intro-img:hover img { transform: scale(1.04); }

      /* Statistik */
      .stats {
        display: flex;
        gap: 44px;
        padding: 24px 0 0;
        border-top: 1px solid rgba(255, 255, 255, 0.4);
      }
      .stat-num {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1;
        color: #fff;
        display: block;
        margin-bottom: 6px;
      }
      .stat-num i { font-style: normal; color: #fff; opacity: 0.8; }
      .stat-label {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.92);
      }


      /* 3. KLIEN (putih, 2 baris) */
      .clients {
        padding: clamp(48px, 6vw, 72px) 0 clamp(52px, 7vw, 80px);
        background: #fff;
        overflow: hidden;
      }
      .clients-title {
        text-align: center;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 36px;
        padding: 0 24px;
      }
      .marquee-rows { display: flex; flex-direction: column; gap: 14px; }
      .marquee { position: relative; overflow: hidden; }
      .marquee::before, .marquee::after {
        content: '';
        position: absolute;
        top: 0; bottom: 0;
        width: 130px;
        z-index: 2;
        pointer-events: none;
      }
      .marquee::before { left: 0; background: linear-gradient(to right, #fff, transparent); }
      .marquee::after { right: 0; background: linear-gradient(to left, #fff, transparent); }
      .marquee-track {
        display: flex;
        align-items: center;
        width: max-content;
        animation: marquee 42s linear infinite;
      }
      .marquee-track.reverse { animation-direction: reverse; animation-duration: 48s; }
      .marquee-track:hover { animation-play-state: paused; }
      @keyframes marquee {
        from { transform: translateX(0); }
        to   { transform: translateX(-50%); }
      }
      .logo-item {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 54px;
        height: 88px;
        flex-shrink: 0;
      }
      .logo-item img {
        max-height: 46px;
        max-width: 150px;
        width: auto;
        object-fit: contain;
        opacity: 0.85;
        transition: opacity 0.3s ease, transform 0.3s ease;
      }
      .logo-item img:hover { opacity: 1; transform: scale(1.08); }


      /* 4. SEKILAS PRASETIA (merah) */
      .intro { padding: clamp(52px, 7vw, 68px) 0; }
      .intro-grid {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 56px;
        align-items: center;
      }
      .intro-img {
        border-radius: 80px 20px 20px 20px;
        overflow: hidden;
        aspect-ratio: 4 / 4.2;
        max-height: 400px;
        width: 100%;
        box-shadow: 0 20px 44px rgba(0, 0, 0, 0.18);
      }
      .intro-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.9s ease;
      }
      .intro-img:hover img { transform: scale(1.04); }
      .intro .h2 { font-size: clamp(1.3rem, 2vw, 1.65rem); margin-bottom: 10px; }
      .intro .lead { max-width: 480px; margin-bottom: 20px; font-size: 14.5px; line-height: 1.7; }

      .div-list { border-top: 1px solid rgba(255, 255, 255, 0.4); }
      .div-row {
        display: grid;
        grid-template-columns: 34px 1fr auto;
        gap: 14px;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.4);
        text-decoration: none;
        position: relative;
        transition: padding-left 0.35s ease;
      }
      .div-row::after {
        content: '';
        position: absolute;
        left: 0; bottom: -1px;
        height: 2px;
        width: 0;
        background: #fff;
        transition: width 0.45s ease;
      }
      .div-row:hover { padding-left: 10px; }
      .div-row:hover::after { width: 100%; }
      .div-num { font-size: 12.5px; font-weight: 800; color: #fff; opacity: 0.85; }
      .div-title {
        font-size: 15px;
        font-weight: 700;
        color: #fff;
        margin: 0 0 2px;
      }
      .div-desc { font-size: 13px; line-height: 1.55; color: rgba(255, 255, 255, 0.94); margin: 0; }
      .div-go {
        font-size: 12.5px;
        font-weight: 700;
        color: #fff;
        opacity: 0;
        transform: translateX(-8px);
        transition: opacity 0.3s ease, transform 0.3s ease;
        white-space: nowrap;
      }
      .div-row:hover .div-go { opacity: 1; transform: none; }


      /* 5. UNGGULAN (putih) */
      .featured { padding: var(--sec-y) 0 56px; background: #fff; }
      .featured-grid {
        display: grid;
        grid-template-columns: 280px minmax(0, 1fr);
        gap: 80px;
        align-items: start;
      }
      .featured-side { position: sticky; top: 120px; }
      .featured-side .lead { font-size: 14.5px; margin-bottom: 26px; }
      .feat-nav { list-style: none; margin: 0; padding: 0; }
      .feat-nav li { margin: 0; }
      .feat-nav a {
        display: flex;
        gap: 14px;
        align-items: center;
        padding: 10px 0 10px 16px;
        font-size: 14px;
        font-weight: 700;
        color: var(--muted);
        text-decoration: none;
        border-left: 2px solid var(--line);
        transition: color 0.3s ease, border-color 0.3s ease, padding-left 0.3s ease;
      }
      .feat-nav a span { font-size: 11.5px; letter-spacing: 0.08em; }
      .feat-nav a.active {
        color: var(--red);
        border-left-color: var(--red);
        padding-left: 22px;
      }

      .feat {
        padding-bottom: 72px;
        margin-bottom: 72px;
        border-bottom: 1px solid var(--line);
        scroll-margin-top: 110px;
      }
      .feat:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
      .feat-img {
        overflow: hidden;
        aspect-ratio: 16 / 9;
        border-radius: 20px;
        margin-bottom: 28px;
      }
      .feat-img.shape-a { border-radius: 20px 20px 90px 20px; }
      .feat-img.shape-b { border-radius: 90px 20px 20px 20px; }
      .feat-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 1s ease;
      }
      .feat:hover .feat-img img { transform: scale(1.04); }

      /* Gambar NetSuite: tetap beranimasi, tampil utuh, tidak terpotong */
      .feat-img.contain {
        aspect-ratio: 16 / 10;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(31, 36, 48, 0.05);
        transition: opacity 0.7s ease, transform 0.7s ease, box-shadow 0.5s ease;
      }
      .feat-img.contain img {
        object-fit: contain;
        padding: 12px;
        transition: transform 0.8s ease;
      }
      .feat:hover .feat-img.contain { box-shadow: 0 18px 40px rgba(225, 29, 39, 0.14); }
      .feat:hover .feat-img.contain img { transform: scale(1.025); }

      .feat-cat {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--red);
        margin: 0 0 8px;
      }
      .feat h3 {
        font-size: clamp(1.25rem, 1.9vw, 1.55rem);
        font-weight: 800;
        line-height: 1.3;
        color: var(--ink);
        margin: 0 0 6px;
      }
      .feat-sub { font-size: 15px; font-weight: 600; color: var(--muted); margin: 0 0 14px; }
      .feat-desc {
        font-size: 15px;
        line-height: 1.8;
        color: var(--text);
        max-width: 560px;
        margin: 0 0 16px;
      }
      .feat-tags { font-size: 13.5px; color: var(--muted); margin: 0 0 22px; line-height: 1.7; }
      .feat-tags b { color: var(--red); font-weight: 800; padding: 0 6px; }
      .feat-cta { font-size: 14px; color: var(--text); margin: 0; }
      .feat-cta .tlink { margin-left: 4px; }


      /* 6. PENGHARGAAN (merah): statistik + daftar + preview sertifikat utuh */
      .awards { padding: var(--sec-y) 0; }
      .awards-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
        gap: 64px;
        align-items: center;
      }
      .awards .h2 {
        font-size: clamp(1.5rem, 2.8vw, 2.1rem);
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 12px;
      }
      .awards .lead { font-size: 15px; line-height: 1.7; max-width: 480px; margin-bottom: 26px; }

      .award-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 14px 36px;
        padding: 18px 0;
        margin-bottom: 8px;
        border-top: 1px solid rgba(255, 255, 255, 0.4);
      }
      .award-stat b {
        display: block;
        font-size: 1.7rem;
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.02em;
        color: #fff;
        margin-bottom: 6px;
      }
      .award-stat b.small { font-size: 1.15rem; padding-top: 0.35rem; }
      .award-stat span {
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.92);
      }

      .award-list { border-top: 1px solid rgba(255, 255, 255, 0.4); margin-bottom: 28px; }
      .award-row {
        display: grid;
        grid-template-columns: 54px minmax(0, 1fr) 20px;
        gap: 14px;
        align-items: center;
        width: 100%;
        padding: 13px 0;
        border: 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.4);
        background: none;
        font: inherit;
        text-align: left;
        color: #fff;
        cursor: pointer;
        position: relative;
        opacity: 0.78;
        transition: opacity 0.35s ease, padding-left 0.35s ease;
      }
      .award-row::after {
        content: '';
        position: absolute;
        left: 0; bottom: -1px;
        height: 2px;
        width: 0;
        background: #fff;
        transition: width 0.5s ease;
      }
      .award-row.active,
      .award-row:hover { opacity: 1; padding-left: 10px; }
      .award-row.active::after,
      .award-row:hover::after { width: 100%; }
      .award-year { font-size: 15px; font-weight: 800; letter-spacing: 0.02em; color: #fff; }
      .award-issuer {
        display: block;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 2px;
      }
      .award-title { font-size: 15px; font-weight: 700; line-height: 1.35; color: #fff; margin: 0; }
      .award-arrow {
        font-size: 16px;
        color: #fff;
        opacity: 0;
        transform: translateX(-8px);
        transition: opacity 0.3s ease, transform 0.3s ease;
      }
      .award-row.active .award-arrow,
      .award-row:hover .award-arrow { opacity: 1; transform: none; }

      /* Kartu preview sertifikat */
      .award-card {
        display: block;
        background: #fff;
        border-radius: 24px;
        overflow: hidden;
        text-decoration: none;
        box-shadow: 0 24px 50px rgba(0, 0, 0, 0.2);
        transition: transform 0.4s ease, box-shadow 0.4s ease;
      }
      .award-card:hover { transform: translateY(-4px); box-shadow: 0 30px 60px rgba(0, 0, 0, 0.26); }
      .award-frame {
        position: relative;
        aspect-ratio: 4 / 3;
        background: #FBF6F5;
      }
      .award-slide {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 18px;
        opacity: 0;
        transform: scale(1.04);
        transition: opacity 0.6s ease, transform 0.9s ease;
      }
      .award-slide.active { opacity: 1; transform: scale(1); }

      .award-caps {
        position: relative;
        min-height: 92px;
        border-top: 3px solid var(--red);
      }
      .award-cap {
        position: absolute;
        inset: 0;
        padding: 16px 22px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 3px;
        opacity: 0;
        transform: translateY(8px);
        transition: opacity 0.5s ease, transform 0.5s ease;
      }
      .award-cap.active { opacity: 1; transform: none; }
      .award-cap small {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--red);
      }
      .award-cap strong { font-size: 16px; font-weight: 800; line-height: 1.3; color: var(--ink); }
      .award-cap span { font-size: 13px; color: var(--muted); line-height: 1.4; }


      /* 7. KENAPA PRASETIA (putih) */
      .why { padding: var(--sec-y) 0; background: #fff; }
      .why-head {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 72px;
        align-items: end;
        margin-bottom: 52px;
      }
      .why-head .h2 { margin: 0; }
      .why-list {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 36px;
      }
      .why-item {
        position: relative;
        padding-top: 26px;
        border-top: 1px solid rgba(225, 29, 39, 0.25);
      }
      .why-item::before {
        content: '';
        position: absolute;
        top: -1px; left: 0;
        height: 2px;
        width: 0;
        background: var(--red);
        transition: width 1s ease 0.2s;
      }
      .why-item.visible::before { width: 44px; }
      .why-num {
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.1em;
        color: var(--red);
        display: block;
        margin-bottom: 10px;
      }
      .why-item h3 { font-size: 16px; font-weight: 700; line-height: 1.4; color: var(--ink); margin: 0 0 8px; }
      .why-item p { font-size: 14px; line-height: 1.75; color: var(--text); margin: 0; }


      /* 8. TENTANG KAMI (merah) */
      .about { padding: var(--sec-y) 0; }
      .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 72px;
        align-items: center;
      }
      .about-img {
        aspect-ratio: 3 / 2;
        overflow: hidden;
        border-radius: 20px 100px 20px 20px;
        box-shadow: 0 24px 50px rgba(0, 0, 0, 0.18);
      }
      .about-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.9s ease;
      }
      .about-img:hover img { transform: scale(1.04); }
      .about .lead { margin-bottom: 30px; max-width: 500px; }


      /* 9. CTA: panel merah di kiri, gambar bersih di kanan */
      .cta { padding: var(--sec-y) 0; background: #fff; }
      .cta-card {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
        align-items: stretch;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 30px 60px rgba(31, 36, 48, 0.14);
      }
      .cta-body {
        padding: 64px 56px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        background: var(--red);
      }
      .cta-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #fff;
        margin: 0 0 18px;
      }
      .cta-eyebrow::before {
        content: '';
        width: 22px;
        height: 2px;
        background: #fff;
      }
      .cta h2 {
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        font-weight: 800;
        line-height: 1.25;
        letter-spacing: -0.01em;
        color: #fff;
        margin: 0 0 16px;
      }
      .cta p {
        font-size: 15.5px;
        line-height: 1.8;
        color: #fff;
        max-width: 460px;
        margin: 0 0 32px;
      }
      .cta-btns { display: flex; gap: 12px; flex-wrap: wrap; }
      .cta-media {
        position: relative;
        min-height: 340px;
        overflow: hidden;
        background: #eee;
      }
      .cta-media img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 1s ease;
      }
      .cta-card:hover .cta-media img { transform: scale(1.04); }


      /* ================= RESPONSIF ================= */
      @media (max-width: 1100px) {
        .featured-grid { gap: 56px; grid-template-columns: 240px minmax(0, 1fr); }
        .about-intro-grid, .intro-grid, .about-grid { gap: 48px; }
        .awards-grid { gap: 44px; }
      }

      @media (max-width: 1000px) {
        .featured-grid { grid-template-columns: 1fr; gap: 40px; }
        .featured-side { position: static; }
        .feat-nav { display: none; }
        .why-list { grid-template-columns: repeat(2, 1fr); gap: 32px 28px; }
      }

      @media (max-width: 900px) {
        .hero { padding: 104px 0 var(--sec-y); }
        .hero-grid { grid-template-columns: 1fr; gap: 36px; padding-left: 0; }
        .hero-text { padding: 0 24px; max-width: none; }
        .hero-photo {
          border-radius: 28px;
          margin: 0 24px;
          width: auto;
          aspect-ratio: 16 / 10;
        }
        .about-intro-grid, .intro-grid, .about-grid, .why-head { grid-template-columns: 1fr; gap: 36px; }
        .about-intro-img { border-radius: 16px 16px 64px 16px; aspect-ratio: 16 / 10; }
        .intro-img { aspect-ratio: 16 / 9; max-height: none; border-radius: 56px 16px 16px 16px; }
        .about-img { border-radius: 16px 64px 16px 16px; }
        .feat { padding-bottom: 56px; margin-bottom: 56px; }

        .logo-item { padding: 0 38px; height: 76px; }
        .logo-item img { max-height: 40px; max-width: 130px; }

        /* Awards: preview di atas, daftar di bawah */
        .awards-grid { grid-template-columns: 1fr; gap: 32px; }
        .award-card { order: -1; }
        .awards .lead { max-width: none; }

        .cta-card { grid-template-columns: 1fr; }
        .cta-media { order: 1; min-height: 240px; }
        .cta-body { order: 2; padding: 48px 32px; }
      }

      @media (max-width: 600px) {
        .wrap { padding: 0 20px; }
        .hero { padding-top: 96px; }
        .hero-text { padding: 0 20px; }
        .hero-photo { margin: 0 20px; border-radius: 22px; aspect-ratio: 4 / 3; }
        .hero p, .lead { font-size: 15px; }
        .hw-small { font-size: 11px; letter-spacing: 0.22em; }
        .hw-small::before { width: 26px; }
        .hw-name { letter-spacing: 0.04em; }
        .hero-actions { flex-direction: column; }
        .hero-actions .btn { width: 100%; }
        .stats { gap: 22px; flex-wrap: wrap; }
        .stat-num { font-size: 1.6rem; }
        .stat-label { font-size: 11px; }
        .logo-item { padding: 0 28px; height: 68px; }
        .logo-item img { max-height: 34px; max-width: 110px; }
        .marquee::before, .marquee::after { width: 50px; }
        .marquee-rows { gap: 8px; }
        .div-row { grid-template-columns: 30px 1fr; gap: 12px; }
        .div-go { display: none; }
        .div-row:hover { padding-left: 0; }
        .feat-img.shape-a { border-radius: 16px 16px 56px 16px; }
        .feat-img.shape-b { border-radius: 56px 16px 16px 16px; }
        .feat-img { margin-bottom: 22px; }
        .feat-cta .tlink { display: block; margin: 6px 0 0; }
        .why-list { grid-template-columns: 1fr; gap: 28px; }

        .award-card { border-radius: 18px; }
        .award-slide { padding: 10px; }
        .award-caps { min-height: 88px; }
        .award-cap { padding: 14px 18px; }
        .award-cap strong { font-size: 15px; }
        .award-stats { gap: 12px 26px; }
        .award-stat b { font-size: 1.45rem; }
        .award-stat b.small { font-size: 1.05rem; padding-top: 0.3rem; }
        .award-row { grid-template-columns: 46px minmax(0, 1fr); gap: 12px; padding: 13px 0; }
        .award-row:hover { padding-left: 0; }
        .award-row.active { padding-left: 8px; }
        .award-arrow { display: none; }
        .award-title { font-size: 14px; }
        .awards .btn { width: 100%; }

        .cta-card { border-radius: 20px; }
        .cta-media { min-height: 200px; }
        .cta-body { padding: 40px 24px; }
        .cta-btns { flex-direction: column; width: 100%; }
        .cta-btns .btn { width: 100%; }
      }

      @media (max-width: 380px) {
        .hero h1 { font-size: 1.6rem; }
        .btn { padding: 12px 20px; font-size: 13.5px; }
        .stats { gap: 16px; }
        .stat-num { font-size: 1.4rem; }
        .award-row { grid-template-columns: 40px minmax(0, 1fr); }
        .award-year { font-size: 13.5px; }
      }
    </style>
  </head>

  <body class="flex flex-col min-h-screen text-gray-800 antialiased">

    <Navbar />

    <main class="flex-grow">

      <!-- 1. HERO -->
      <section class="hero" aria-label="Beranda">
        <div class="hero-grid">
          <div class="hero-text">
            <div class="hero-dots rise r1" aria-hidden="true"><i></i><i></i><i></i></div>

            <div class="hero-welcome rise r2">
              <span class="hw-small">Selamat datang di</span>
              <span class="hw-name">PT. Prasetia Dwidharma</span>
            </div>

            <h1 class="rise r3">
              Membangun <em>infrastruktur</em>,<br />
              mendukung bisnis digital.
            </h1>
            <p class="rise r4">
              Sejak 2008, Prasetia membantu perusahaan di Indonesia membangun jaringan telekomunikasi, memakai teknologi yang tepat, dan berkembang lewat transformasi digital.
            </p>
            <div class="hero-actions rise r5">
              <a href="#unggulan" class="btn">Lihat Solusi Kami</a>
              <a href="/about/contact/" class="btn btn-line">Hubungi Kami</a>
            </div>
          </div>

          <div class="hero-photo">
            <img src="/images/hero/hero4.jpg" alt="Tim Prasetia Dwidharma" />
          </div>
        </div>
      </section>


      <!-- 2. PROFIL SINGKAT PERUSAHAAN (merah) -->
      <section class="about-intro sec-red" aria-label="Tentang PT Prasetia Dwidharma">
        <div class="wrap about-intro-grid">

          <div>
            <div class="label reveal">Tentang Kami</div>
            <h2 class="h2 reveal d1">
              PT Prasetia <em>Dwidharma</em>
            </h2>
            <p class="lead reveal d2">
              Didirikan pada tahun 2008. Sejak saat itu kami berkembang menjadi salah satu pemain penting di industri ini. Saat ini perusahaan kami memiliki empat divisi: 
              Telekomunikasi &amp; Infrastruktur, ICT (Information &amp; Communication Technology), Call Center BPO (Business Process Outsourcing), dan Biotech.
            </p>

            <div class="stats reveal d3">
              <div>
                <span class="stat-num">2008<i>+</i></span>
                <span class="stat-label">Berdiri</span>
              </div>
              <div>
                <span class="stat-num">4</span>
                <span class="stat-label">Divisi usaha</span>
              </div>
              <div>
                <span class="stat-num">10<i>+</i></span>
                <span class="stat-label">Klien besar</span>
              </div>
            </div>
          </div>

          <div class="about-intro-img reveal d2">
            <img src="/images/hero/hero1.jpg" alt="Tim Prasetia dalam pertemuan profesional" loading="lazy" />
          </div>

        </div>
      </section>


      <!-- 3. KLIEN (2 baris, arah berlawanan) -->
      <section class="clients" aria-label="Klien kami">
        <h2 class="clients-title reveal">Dipercaya oleh perusahaan besar</h2>
        <div class="marquee-rows">
          <div class="marquee">
            <div class="marquee-track" aria-hidden="true">
              {clientRow1.map((logo) => (
                <div class="logo-item"><img src={logo.src} alt={logo.alt} loading="lazy" /></div>
              ))}
            </div>
          </div>
          <div class="marquee">
            <div class="marquee-track reverse" aria-hidden="true">
              {clientRow2.map((logo) => (
                <div class="logo-item"><img src={logo.src} alt={logo.alt} loading="lazy" /></div>
              ))}
            </div>
          </div>
        </div>
        <ul class="sr-only">
          {clientLogos.map((logo) => <li>{logo.alt}</li>)}
        </ul>
      </section>


      <!-- 4. SEKILAS PRASETIA (merah) -->
      <section class="intro sec-red" aria-label="Sekilas Prasetia">
        <div class="wrap intro-grid">
          <div class="intro-img reveal">
            <img src="/images/hero/hero2.jpg" alt="Tim Prasetia sedang bekerja di lapangan" loading="lazy" />
          </div>

          <div>
            <div class="label reveal">Apa yang Kami Kerjakan</div>
            <h2 class="h2 reveal d1">Satu perusahaan, empat bidang usaha.</h2>
            <p class="lead reveal d2">
              Prasetia bergerak di infrastruktur telekomunikasi, teknologi untuk perusahaan, layanan business process, dan biotech. Semuanya kami jalankan supaya bisnis Anda punya fondasi yang kuat untuk tumbuh.
            </p>

            <div class="div-list reveal d3">
              {divisions.map((d) => (
                <a
                  href={d.href}
                  class="div-row"
                  {...(d.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <span class="div-num">{d.num}</span>
                  <div>
                    <h3 class="div-title">{d.title}</h3>
                    <p class="div-desc">{d.desc}</p>
                  </div>
                  <span class="div-go">Lihat detail</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>


      <!-- 5. SOLUSI UNGGULAN (putih) -->
      <section class="featured" id="unggulan" aria-label="Solusi unggulan">
        <div class="wrap featured-grid">

          <aside class="featured-side">
            <div class="label reveal">Solusi Unggulan</div>
            <h2 class="h2 reveal d1">Yang paling sering dipercaya klien kami.</h2>
            <p class="lead reveal d2">
              Tiga solusi yang jadi kekuatan utama Prasetia. Kalau ada yang menarik, langsung buka halamannya untuk lihat selengkapnya.
            </p>
            <ul class="feat-nav reveal d3">
              <li><a href="#feat-1" class="active" data-target="feat-1"><span>01</span>Telekomunikasi</a></li>
              <li><a href="#feat-2" data-target="feat-2"><span>02</span>Lark</a></li>
              <li><a href="#feat-3" data-target="feat-3"><span>03</span>Oracle NetSuite</a></li>
            </ul>
          </aside>

          <div class="featured-list">

            <!-- Telekomunikasi -->
            <article class="feat" id="feat-1">
              <div class="feat-img reveal">
                <img src="/images/herotelcom/herotelcom1.jpg" alt="Pembangunan tower telekomunikasi" loading="lazy" />
              </div>
              <p class="feat-cat reveal">Telekomunikasi</p>
              <h3 class="reveal d1">Infrastruktur yang menghubungkan Indonesia.</h3>
              <p class="feat-sub reveal d1">Dari tower sampai fiber optic.</p>
              <p class="feat-desc reveal d2">
                Kami menangani pembangunan infrastruktur telekomunikasi dari awal sampai akhir, mulai dari site acquisition, konstruksi tower, sampai maintenance rutin.
              </p>
              <p class="feat-tags reveal d2">
                Tower Construction<b>·</b>Co-location<b>·</b>Site Acquisition<b>·</b>Maintenance<b>·</b>Fiber Optic
              </p>
              <p class="feat-cta reveal d3">
                Tertarik dengan layanan ini?
                <a href="/products-services/telecommunication-infrastructure/" class="tlink">Lihat halaman Telekomunikasi</a>
              </p>
            </article>

            <!-- Lark -->
            <article class="feat" id="feat-2">
              <div class="feat-img shape-a reveal">
                <img src="/images/herolark/lark1.png" alt="Platform kolaborasi Lark" loading="lazy" />
              </div>
              <p class="feat-cat reveal">Enterprise Technology</p>
              <h3 class="reveal d1">Lark</h3>
              <p class="feat-sub reveal d1">Kerja tim jadi lebih terhubung.</p>
              <p class="feat-desc reveal d2">
                Chat, meeting, dokumen, dan workflow ada di satu tempat. Prasetia membantu perusahaan Anda mulai memakai Lark dan menyesuaikannya dengan cara kerja tim.
              </p>
              <p class="feat-tags reveal d2">
                Collaboration<b>·</b>Komunikasi<b>·</b>Workflow<b>·</b>Operasional Bisnis
              </p>
              <p class="feat-cta reveal d3">
                Ingin tahu lebih banyak?
                <a href="/products-services/ict/lark/" class="tlink">Kenali Lark bersama Prasetia</a>
              </p>
            </article>

            <!-- NetSuite -->
            <article class="feat" id="feat-3">
              <div class="feat-img contain reveal">
                <img src="/images/heronetsuite/nethero1.jpg" alt="Oracle NetSuite cloud ERP" loading="lazy" />
              </div>
              <p class="feat-cat reveal">Enterprise Technology</p>
              <h3 class="reveal d1">Oracle NetSuite</h3>
              <p class="feat-sub reveal d1">Semua urusan bisnis dalam satu sistem.</p>
              <p class="feat-desc reveal d2">
                Platform ERP berbasis cloud yang menyatukan keuangan, operasional, dan proses bisnis, sehingga data lebih rapi dan keputusan lebih cepat diambil.
              </p>
              <p class="feat-tags reveal d2">
