---
import MainLayout from '../../layouts/MainLayout.astro';

const DOCUMENT_URL = "https://prasetia.sg.larksuite.com/file/ZhBQb4sAXo5uZ6xA3ewutgvVsTd";

// Dipecah per KATA dulu, baru per huruf di dalam tiap kata,
// supaya wrapping baris terjadi di antara kata (bukan di tengah kata).
const heroWords = "Code of Conduct".split(" ").map((w) => w.split(""));
let heroLetterIndex = 0;
---

<MainLayout title="Code of Conduct | Good Corporate Governance | PT Prasetia Dwidharma" transparentNavbar={true}>

  <!-- Scroll progress -->
  <div id="scroll-progress" class="fixed top-0 left-0 h-[3px] bg-red-600 z-50 origin-left scale-x-0"></div>

  <!-- ===================== HERO ===================== -->
  <section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        id="hero-img"
        src="/images/governance/gcg2.jpg"
        alt="PT Prasetia Dwidharma"
        class="w-full h-[120%] object-cover will-change-transform scale-105"
      />
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-red-950/70 via-red-900/30 to-red-900/0"></div>

    <div class="relative w-full max-w-3xl mx-auto px-5 sm:px-8 md:px-10 text-center">
      <div class="reveal" data-reveal>
        <span class="reveal-line inline-block w-8 h-[2px] bg-white/70 mb-5 mx-auto origin-center scale-x-0" data-reveal></span>

        <h1
          id="hero-wordmark"
          class="mx-auto flex max-w-xs flex-wrap items-baseline justify-center gap-x-3 gap-y-1 font-serif text-4xl font-black leading-[1.1] tracking-tight text-white sm:max-w-xl sm:gap-x-4 sm:text-5xl md:max-w-2xl md:text-6xl lg:max-w-none lg:text-7xl"
        >
          {heroWords.map((word) => (
            <span class="hero-word inline-flex whitespace-nowrap">
              {word.map((char) => {
                const i = heroLetterIndex++;
                return (
                  <span
                    class="hero-letter inline-block translate-y-12 opacity-0 transition-all duration-700 ease-out"
                    style={`transition-delay:${i * 40}ms`}
                  >{char}</span>
                );
              })}
            </span>
          ))}
        </h1>

        <p class="text-white/90 text-base sm:text-lg mt-6 max-w-md mx-auto leading-relaxed font-light">
          Pedoman etika dan tata kelola PT Prasetia Dwidharma dalam menjalankan usaha secara transparan, akuntabel, dan bertanggung jawab kepada seluruh pemangku kepentingan.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ TRANSISI HERO -> KONTEN ============ -->
  <section class="relative bg-white pt-14 pb-14 sm:pt-16 sm:pb-16 md:pt-20 md:pb-20">
    <div class="max-w-3xl mx-auto px-5 sm:px-8 md:px-10 text-center reveal" data-reveal>
      <p class="text-base sm:text-lg leading-relaxed font-light text-gray-700">
        Perusahaan menyusun Pedoman Etika dan Perilaku Perusahaan, terutama dalam interaksi dengan seluruh pemangku kepentingan, yang senantiasa didasarkan pada prinsip-prinsip Tata Kelola Perusahaan yang Baik
        <span class="font-medium text-gray-900">(Good Corporate Governance)</span>
        guna mewujudkan Visi dan Misi Perusahaan.
      </p>
    </div>
  </section>

  <!-- ===================== PRINSIP GCG (1–5) ===================== -->
  <section class="relative bg-white pb-16 sm:pb-20 md:pb-24">
    <div class="max-w-3xl mx-auto px-5 sm:px-8 md:px-10">

      <div class="mb-4 sm:mb-6 reveal" data-reveal>
        <h2 class="font-serif text-xl sm:text-2xl md:text-3xl text-red-700 mb-2">
          Prinsip Good Corporate Governance
        </h2>
        <p class="text-gray-500 text-sm sm:text-base leading-relaxed">
          Lima prinsip yang menjadi dasar setiap kebijakan dan tindakan Perusahaan.
        </p>
      </div>

      {[
        { title: 'Transparansi', text: 'Perusahaan menjamin pengungkapan informasi materiil dan relevan mengenai kinerja, kondisi keuangan, dan informasi relevan lainnya secara jelas, memadai, akurat, sesuai peraturan perundang-undangan yang berlaku, tepat waktu, serta mudah diakses oleh stakeholders sesuai haknya. Prinsip keterbukaan ini tidak mengurangi kewajiban untuk melindungi informasi rahasia Perusahaan, pelanggan, dan mitra kerja.' },
        { title: 'Akuntabilitas', text: 'Perusahaan merumuskan dengan jelas fungsi, hak, kewajiban, wewenang, dan tanggung jawab seluruh jajaran di dalam Perusahaan agar pengelolaan Perusahaan terlaksana secara efektif, merujuk pada kewajiban setiap orang dalam Perusahaan atas tugas, wewenang, dan tanggung jawab yang dibebankan kepadanya.' },
        { title: 'Bertanggung Jawab', text: 'Perusahaan menjamin seluruh aktivitas bisnisnya didasari oleh prinsip korporasi yang sehat, dijalankan sesuai peraturan perundang-undangan yang berlaku (comply), dan berusaha memberikan kontribusi nyata kepada masyarakat.' },
        { title: 'Kemandirian', text: 'Perusahaan menjamin pengelolaan dilakukan secara profesional, menghindari benturan kepentingan serta pengaruh atau tekanan dari pihak manapun yang tidak sesuai dengan peraturan perundang-undangan dan prinsip korporasi yang sehat.' },
        { title: 'Kewajaran', text: 'Perusahaan menjamin perlakuan yang adil dan tidak diskriminatif dalam memenuhi hak-hak stakeholders, berdasarkan ketentuan dan peraturan perundang-undangan yang berlaku.' },
      ].map((item, i) => (
        <div class:list={["relative border-t border-red-100/70 py-8 sm:py-10 md:py-12 group", i === 4 && "border-b border-red-100/70"]}>
          <div class="grid grid-cols-[2.5rem_1fr] sm:grid-cols-[3.5rem_1fr] md:grid-cols-[4.5rem_1fr] gap-x-4 sm:gap-x-6 md:gap-x-8 reveal" data-reveal>
            <span class="pointer-events-none select-none font-serif text-3xl sm:text-4xl md:text-5xl leading-none text-red-100 transition-all duration-500 ease-out group-hover:text-red-200">
              {i + 1}
            </span>
            <div>
              <h3 class="font-serif text-lg sm:text-xl md:text-2xl text-gray-900 mb-2 transition-colors duration-300 group-hover:text-red-700">
                {item.title}
              </h3>
              <p class="text-gray-600 text-sm sm:text-base leading-relaxed">
                {item.text}
              </p>
            </div>
          </div>
          <span class="absolute left-0 bottom-0 h-[2px] w-0 bg-red-600 transition-all duration-500 ease-out group-hover:w-16"></span>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ CTA — DOKUMEN LENGKAP ============ -->
  <section id="cta" class="relative overflow-hidden py-20 sm:py-24 md:py-28">
    <div class="absolute inset-0">
      <img
        src="/images/governance/gcg2.jpg"
        alt=""
        class="w-full h-full object-cover"
      />
    </div>
    <div class="absolute inset-0 bg-red-900/50"></div>

    <div class="relative max-w-3xl mx-auto px-5 sm:px-8 md:px-10 text-center reveal" data-reveal>
      <h2 class="font-serif text-xl sm:text-2xl md:text-3xl leading-snug mb-4 text-white">
        Baca Pedoman Selengkapnya
      </h2>
      <p class="text-sm sm:text-base leading-relaxed mb-8 max-w-md mx-auto text-white/90">
        Pelajari ketentuan lengkap dalam Pedoman &amp; KD: Standar Perilaku &amp; Etika Perusahaan (Code of Conduct) Tahun 2024–2026, yang mengatur secara rinci penerapan Good Corporate Governance di PT Prasetia Dwidharma.
      </p>

      <a href={DOCUMENT_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-full max-w-xs sm:w-auto sm:max-w-none mx-auto px-6 sm:px-8 py-3.5 sm:py-3 rounded-2xl bg-white text-red-700 text-sm sm:text-base font-semibold leading-snug shadow-lg shadow-red-900/25 transition-all duration-300 hover:scale-[1.03] hover:bg-red-50 hover:shadow-xl hover:shadow-red-900/30 cursor-pointer">
        Buka Dokumen Code of Conduct 2024–2026
      </a>
    </div>
  </section>

</MainLayout>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }

  .reveal-line { transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s; }
  .reveal-line.is-visible { transform: scaleX(1); }
</style>

<script>
  // ---------- Hero title: per-letter entrance (gaya Core Values) ----------
  window.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('#hero-wordmark .hero-letter').forEach((el) => {
      requestAnimationFrame(() => {
        el.classList.remove('opacity-0', 'translate-y-12');
      });
    });
  });

  // ---------- Generic reveal ----------
  const revealEls = document.querySelectorAll('[data-reveal]');
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
  );
  revealEls.forEach((el) => io.observe(el));

  const heroImg = document.getElementById('hero-img');
  const hero = document.getElementById('hero');
  function onScrollParallax() {
    if (!heroImg || !hero) return;
    const rect = hero.getBoundingClientRect();
    if (rect.bottom < 0 || rect.top > window.innerHeight) return;
    heroImg.style.transform = `translateY(${window.scrollY * 0.25}px)`;
  }

  const progress = document.getElementById('scroll-progress');
  function onScrollProgress() {
    if (!progress) return;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    progress.style.transform = `scaleX(${docHeight > 0 ? window.scrollY / docHeight : 0})`;
  }

  function onScroll() {
    onScrollParallax();
    onScrollProgress();
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  window.addEventListener('load', onScroll);
  onScroll();
</script>