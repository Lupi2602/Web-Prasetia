---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Code of Conduct | Good Corporate Governance | PT Prasetia Dwidharma" transparentNavbar={true}>

  <!-- Scroll progress -->
  <div id="scroll-progress" class="fixed top-0 left-0 h-[3px] bg-red-600 z-50 origin-left scale-x-0"></div>

  <!-- Layer background tunggal yang warnanya di-blend sesuai scroll -->
  <div id="bg-blend" class="fixed inset-0 -z-10 bg-red-900"></div>

  <!-- ===================== HERO ===================== -->
  <section id="hero" class="relative min-h-screen flex items-end overflow-hidden">
    <div class="absolute inset-0">
      <img
        id="hero-img"
        src="/images/governance/gcg2.jpg"
        alt="PT Prasetia Dwidharma"
        class="w-full h-[120%] object-cover will-change-transform scale-105"
      />
    </div>
    <!-- overlay dikurangi sedikit opacity-nya -->
    <div class="absolute inset-0 bg-gradient-to-t from-red-950/85 via-red-800/45 to-red-500/10"></div>
    <!-- seam bawah hero, menyatu ke bg-blend -->
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-red-900 to-transparent"></div>

    <div class="relative w-full max-w-7xl mx-auto px-6 sm:px-10 pb-28 md:pb-36">
      <div class="reveal" data-reveal>
        <span class="reveal-line inline-block w-10 h-[2px] bg-white/70 mb-6 origin-left scale-x-0" data-reveal></span>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl text-white leading-[0.95] tracking-tight max-w-3xl">
          Code of Conduct
        </h1>
        <p class="text-white/90 text-base md:text-lg mt-6 max-w-lg leading-loose font-light">
          Pedoman etika dan tata kelola PT Prasetia Dwidharma dalam menjalankan usaha secara transparan, akuntabel, dan bertanggung jawab kepada seluruh pemangku kepentingan.
        </p>
      </div>
    </div>

  
  </section>

  <!-- ============ TRANSISI HERO -> KONTEN (transparan, warnanya dari bg-blend) ============ -->
  <section class="relative pt-24 pb-28 md:pt-32 md:pb-36">
    <div class="max-w-2xl mx-auto px-6 sm:px-10 text-center reveal" data-reveal>
      <p id="transition-text" class="text-xl md:text-2xl leading-loose font-light text-white transition-colors duration-500">
        Perusahaan menyusun Pedoman Etika dan Perilaku Perusahaan, terutama dalam interaksi dengan seluruh pemangku kepentingan, yang senantiasa didasarkan pada prinsip-prinsip Tata Kelola Perusahaan yang Baik
        <span class="font-medium">(Good Corporate Governance)</span>
        guna mewujudkan Visi dan Misi Perusahaan.
      </p>
    </div>
  </section>

  <!-- ===================== PRINSIP GCG (1–5) ===================== -->
  <section class="relative">
    <div class="max-w-4xl mx-auto px-6 sm:px-10 py-4 reveal" data-reveal>
      <h2 class="font-serif text-3xl md:text-4xl text-red-700 mb-2">
        Prinsip Good Corporate Governance
      </h2>
      <p class="text-gray-500 max-w-xl leading-relaxed">
        Lima prinsip yang menjadi dasar setiap kebijakan dan tindakan Perusahaan.
      </p>
    </div>

    <div class="max-w-4xl mx-auto px-6 sm:px-10">
      {[
        { title: 'Transparansi', text: 'Perusahaan menjamin pengungkapan informasi materiil dan relevan mengenai kinerja, kondisi keuangan, dan informasi relevan lainnya secara jelas, memadai, akurat, sesuai peraturan perundang-undangan yang berlaku, tepat waktu, serta mudah diakses oleh stakeholders sesuai haknya. Prinsip keterbukaan ini tidak mengurangi kewajiban untuk melindungi informasi rahasia Perusahaan, pelanggan, dan mitra kerja.' },
        { title: 'Akuntabilitas', text: 'Perusahaan merumuskan dengan jelas fungsi, hak, kewajiban, wewenang, dan tanggung jawab seluruh jajaran di dalam Perusahaan agar pengelolaan Perusahaan terlaksana secara efektif — merujuk pada kewajiban setiap orang dalam Perusahaan atas tugas, wewenang, dan tanggung jawab yang dibebankan kepadanya.' },
        { title: 'Bertanggung Jawab', text: 'Perusahaan menjamin seluruh aktivitas bisnisnya didasari oleh prinsip korporasi yang sehat, dijalankan sesuai peraturan perundang-undangan yang berlaku (comply), dan berusaha memberikan kontribusi nyata kepada masyarakat.' },
        { title: 'Kemandirian', text: 'Perusahaan menjamin pengelolaan dilakukan secara profesional, menghindari benturan kepentingan serta pengaruh atau tekanan dari pihak manapun yang tidak sesuai dengan peraturan perundang-undangan dan prinsip korporasi yang sehat.' },
        { title: 'Kewajaran', text: 'Perusahaan menjamin perlakuan yang adil dan tidak diskriminatif dalam memenuhi hak-hak stakeholders, berdasarkan ketentuan dan peraturan perundang-undangan yang berlaku.' },
      ].map((item, i) => (
        <div class:list={["relative border-t border-red-100/70 py-12 md:py-16 overflow-hidden group", i === 4 && "border-b border-red-100/70"]}>
          <span class="pointer-events-none select-none absolute -left-4 -top-8 font-serif text-[10rem] md:text-[13rem] leading-none text-red-50 transition-all duration-700 ease-out group-hover:text-red-100 group-hover:-translate-y-2 group-hover:scale-105">
            {i + 1}
          </span>
          <div class="relative pl-14 md:pl-24 reveal" data-reveal>
            <h3 class="font-serif text-2xl md:text-3xl text-gray-900 mb-3 transition-colors duration-300 group-hover:text-red-700">
              {item.title}
            </h3>
            <p class="text-gray-600 leading-loose max-w-xl">
              {item.text}
            </p>
          </div>
          <span class="absolute left-0 bottom-0 h-[2px] w-0 bg-red-600 transition-all duration-500 ease-out group-hover:w-16"></span>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ CTA — DOKUMEN LENGKAP (transparan, warnanya dari bg-blend) ============ -->
  <section class="relative pt-24 pb-28 md:pt-32 md:pb-36">
    <div class="max-w-2xl mx-auto px-6 sm:px-10 text-center reveal" data-reveal>
      <h2 id="cta-title" class="font-serif text-3xl md:text-5xl leading-tight mb-6 text-white transition-colors duration-500">
        Baca Pedoman Selengkapnya
      </h2>
      <p id="cta-text" class="text-base md:text-lg leading-loose mb-10 max-w-lg mx-auto text-white/90 transition-colors duration-500">
        Pelajari ketentuan lengkap dalam Pedoman &amp; KD – Standar Perilaku &amp; Etika Perusahaan (Code of Conduct) Tahun 2024–2026, yang mengatur secara rinci penerapan Good Corporate Governance di PT Prasetia Dwidharma.
      </p>

      <a href="https://prasetia.sg.larksuite.com/file/ZhBQb4sAXo5uZ6xA3ewutgvVsTd" target="_blank" rel="noopener noreferrer" class="relative inline-flex items-center justify-center gap-2 px-10 py-4 rounded-full bg-white text-red-700 font-medium overflow-hidden group isolate shadow-lg shadow-red-900/25 transition-all duration-300 hover:scale-[1.04] hover:shadow-xl hover:shadow-red-900/30">
        <span class="absolute inset-0 bg-red-50 scale-x-0 origin-left transition-transform duration-500 ease-out group-hover:scale-x-100 -z-10"></span>
        <span>Buka Dokumen Code of Conduct 2024–2026</span>
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-6-6l6 6-6 6"/></svg>
      </a>
    </div>
  </section>

</MainLayout>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }

  .reveal-line { transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s; }
  .reveal-line.is-visible { transform: scaleX(1); }

  @keyframes bounce-slow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }
  .animate-bounce-slow { animation: bounce-slow 2.4s ease-in-out infinite; }
</style>

<script>
  // ---------- Scroll reveal ----------
  const revealEls = document.querySelectorAll('[data-reveal]');
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
  );
  revealEls.forEach((el) => io.observe(el));

  // ---------- Hero parallax ----------
  const heroImg = document.getElementById('hero-img');
  const hero = document.getElementById('hero');
  function onScrollParallax() {
    if (!heroImg || !hero) return;
    const rect = hero.getBoundingClientRect();
    if (rect.bottom < 0 || rect.top > window.innerHeight) return;
    heroImg.style.transform = `translateY(${window.scrollY * 0.25}px)`;
  }

  // ---------- Scroll progress bar ----------
  const progress = document.getElementById('scroll-progress');
  function onScrollProgress() {
    if (!progress) return;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    progress.style.transform = `scaleX(${docHeight > 0 ? window.scrollY / docHeight : 0})`;
  }

  // ---------- Seamless background color blend ----------
  const bgBlend = document.getElementById('bg-blend');
  const sections = document.querySelectorAll('section');
  const transitionText = document.getElementById('transition-text');
  const ctaTitle = document.getElementById('cta-title');
  const ctaText = document.getElementById('cta-text');

  const RED_DARK = [127, 29, 29];  // red-900
  const RED_MID  = [185, 28, 28];  // red-700
  const WHITE    = [255, 255, 255];

  let stops = [];

  function buildStops() {
    const [heroEl, transEl, prinsipEl, ctaEl] = sections;
    if (!heroEl || !transEl || !prinsipEl || !ctaEl) return;

    stops = [
      { y: heroEl.offsetTop + heroEl.offsetHeight - 120, color: RED_DARK },
      { y: transEl.offsetTop + transEl.offsetHeight * 0.65, color: WHITE },
      { y: prinsipEl.offsetTop + prinsipEl.offsetHeight, color: WHITE },
      { y: ctaEl.offsetTop + ctaEl.offsetHeight * 0.45, color: RED_MID },
      { y: ctaEl.offsetTop + ctaEl.offsetHeight, color: RED_MID },
    ];
  }

  const lerp = (a, b, t) => a + (b - a) * t;

  function colorAt(y) {
    if (!stops.length) return RED_DARK;
    if (y <= stops[0].y) return stops[0].color;
    for (let i = 0; i < stops.length - 1; i++) {
      const a = stops[i], b = stops[i + 1];
      if (y >= a.y && y <= b.y) {
        const t = (y - a.y) / Math.max(1, b.y - a.y);
        return [
          lerp(a.color[0], b.color[0], t),
          lerp(a.color[1], b.color[1], t),
          lerp(a.color[2], b.color[2], t),
        ];
      }
    }
    return stops[stops.length - 1].color;
  }

  const luminance = ([r, g, b]) => (0.299 * r + 0.587 * g + 0.114 * b) / 255;

  function onScrollBlend() {
    if (!bgBlend) return;
    const refY = window.scrollY + window.innerHeight * 0.45;
    const [r, g, b] = colorAt(refY).map(Math.round);
    bgBlend.style.backgroundColor = `rgb(${r}, ${g}, ${b})`;

    const isDark = luminance([r, g, b]) < 0.55;
    if (transitionText) transitionText.classList.toggle('text-white', isDark) || transitionText.classList.toggle('text-gray-700', !isDark);
    if (ctaTitle) ctaTitle.classList.toggle('text-white', isDark) || ctaTitle.classList.toggle('text-gray-900', !isDark);
    if (ctaText) ctaText.classList.toggle('text-white/90', isDark) || ctaText.classList.toggle('text-gray-600', !isDark);
  }

  function onScroll() {
    onScrollParallax();
    onScrollProgress();
    onScrollBlend();
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', () => { buildStops(); onScroll(); });
  window.addEventListener('load', () => { buildStops(); onScroll(); });
  buildStops();
  onScroll();
</script>