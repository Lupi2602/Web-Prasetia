---
import MainLayout from '../../layouts/MainLayout.astro';

const values = [
  { letter: "C", title: "Customer-centric", description: "Berfokus pada penyediaan solusi sesuai dengan kebutuhan pelanggan.", id: "01" },
  { letter: "O", title: "Optimistic", description: "Senantiasa berpikiran positif.", id: "02" },
  { letter: "N", title: "Noble", description: "Menjaga kehormatan diri sendiri dan Perusahaan.", id: "03" },
  { letter: "F", title: "Focus", description: "Konsisten bekerja dengan tujuan yang jelas.", id: "04" },
  { letter: "I", title: "Integrity", description: "Sejalan antara kata dan perbuatan.", id: "05" },
  { letter: "D", title: "Dedication", description: "Kesetiaan pada Perusahaan dengan bekerja secara profesional.", id: "06" },
  { letter: "E", title: "Efficient", description: "Menyelesaikan pekerjaan dengan cepat dan tepat.", id: "07" },
  { letter: "N", title: "Nimble", description: "Inovatif & mampu menyesuaikan diri pada perubahan yang cepat.", id: "08" },
  { letter: "T", title: "Teamwork", description: "Saling menghormati, bekerja sama untuk mencapai tujuan bersama yaitu Visi & Misi Perusahaan.", id: "09" }
];

const word = "CONFIDENT".split("");
---

<MainLayout
  title="Core Values - CONFIDENT | Good Corporate Governance | PT Prasetia Dwidharma"
  transparentNavbar={true}
>

  <!-- ============ HERO ============ -->
  <section class="hero-section relative flex h-screen min-h-[640px] w-full items-center justify-center overflow-hidden">
    <div
      id="hero-bg"
      class="absolute inset-0 scale-110 bg-cover bg-center will-change-transform"
      style="background-image: url('/images/governance/gcg3.jpg');"
    ></div>
    <div class="absolute inset-0 bg-gradient-to-b from-red-950/80 via-red-900/40 to-white"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_15%,rgba(220,38,38,0.25),transparent_60%)]"></div>

    <div class="relative z-10 flex flex-col items-center px-6 text-center">

      <h1 class="flex flex-wrap justify-center gap-x-1 font-serif text-[15vw] font-black leading-none tracking-tight text-white sm:text-[10vw] md:text-[7.5rem]">
        {word.map((char, i) => (
          <span
            class="hero-letter inline-block translate-y-12 opacity-0 transition-all duration-700 ease-out"
            style={`transition-delay:${i * 70}ms`}
          >{char}</span>
        ))}
      </h1>

      <p class="mt-8 max-w-2xl text-base font-light leading-relaxed text-white/90 opacity-0 md:text-lg" id="hero-sub">
        Senantiasa <strong class="font-semibold text-white">Percaya Diri</strong> dalam menjalankan pekerjaan,
        penuh integritas, dan memberikan pelayanan terbaik bagi pelanggan serta mitra bisnis Perusahaan.
      </p>


    </div>
  </section>

  <!-- ============ INTRO STRIP ============ -->
  <section class="bg-white px-6 pb-24 pt-16 md:pb-32">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="reveal translate-y-8 opacity-0 text-xs font-bold uppercase tracking-[0.3em] text-red-600">
        Nilai-Nilai Luhur
      </h2>
      <p class="reveal mt-6 translate-y-8 opacity-0 font-serif text-2xl font-medium leading-snug text-gray-900 md:text-4xl">
        Sembilan pilar yang membentuk identitas kerja kami 
        <span class="text-red-600">satu budaya, satu tujuan.</span>
      </p>
      <div class="reveal mx-auto mt-8 h-px w-16 translate-y-4 bg-red-600 opacity-0"></div>
    </div>
  </section>

  <!-- ============ CORE VALUES : LETTER-RAIL EDITORIAL LIST ============ -->
  <section id="values-section" class="relative bg-white px-6 pb-32 pt-8 md:px-12">
    <div class="mx-auto max-w-6xl">

      <div class="grid grid-cols-1 gap-4 md:grid-cols-[160px_1fr] md:gap-16">

        <!-- ===== Sticky letter rail (desktop) ===== -->
        <aside class="hidden md:block">
          <div class="sticky top-32 flex flex-col gap-4">
            <span class="mb-4 text-[10px] font-semibold uppercase tracking-[0.3em] text-gray-400">
              Progres
            </span>
            {word.map((char, i) => (
              <div
                class="rail-letter flex items-center gap-3 transition-all duration-500"
                data-index={i}
              >
                <span class="rail-dash h-px w-4 bg-gray-300 transition-all duration-500"></span>
                <span class="rail-char font-serif text-2xl font-black leading-none text-gray-300 transition-all duration-500">
                  {char}
                </span>
              </div>
            ))}
          </div>
        </aside>

        <!-- ===== Mobile progress bar ===== -->
        <div class="md:hidden">
          <div class="mb-8 flex items-center gap-1.5">
            {word.map((_, i) => (
              <span class="rail-dot-mobile h-1 flex-1 rounded-full bg-gray-200 transition-all duration-500" data-index={i}></span>
            ))}
          </div>
        </div>

        <!-- ===== Values list ===== -->
        <div>
          {values.map((v, i) => (
            <div
              id={`value-${i}`}
              data-index={i}
              class="value-row group relative border-b border-gray-100 py-10 first:pt-0 md:py-14"
            >
              <!-- ghost huruf raksasa di belakang -->
              <span
                aria-hidden="true"
                class="pointer-events-none absolute -left-2 top-1/2 -translate-y-1/2 select-none font-serif text-[7rem] font-black leading-none text-gray-50 transition-colors duration-500 group-hover:text-red-50 sm:text-[9rem] md:text-[11rem]"
              >{v.letter}</span>

              <div class="relative flex items-start gap-6 pl-16 md:pl-24">
                <span class="value-num mt-1 shrink-0 font-serif text-xs font-bold tracking-widest text-gray-300 transition-colors duration-500">
                  {v.id}
                </span>

                <div class="flex-1">
                  <h3 class="value-title font-serif text-3xl font-bold leading-tight text-gray-900 transition-colors duration-500 sm:text-4xl md:text-5xl">
                    {v.title}
                  </h3>

                  <span class="value-underline mt-4 block h-px w-0 bg-red-600 transition-all duration-700 ease-out"></span>

                  <p class="mt-5 max-w-lg text-sm leading-relaxed text-gray-500 sm:text-base md:text-lg">
                    {v.description}
                  </p>
                </div>

                <span class="hidden shrink-0 self-center font-serif text-5xl font-black text-gray-100 transition-all duration-500 group-hover:translate-x-1 group-hover:text-red-100 md:block md:text-6xl">
                  {v.letter}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CLOSING ============ -->
  <section class="relative flex min-h-[60vh] items-center justify-center overflow-hidden bg-gradient-to-b from-white via-red-500 to-red-700 px-6 py-28 md:py-36">
    <div
      class="absolute inset-0 bg-cover bg-center opacity-15 mix-blend-overlay"
      style="background-image: url('/images/governance/gcg3.jpg');"
    ></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_100%,rgba(0,0,0,0.15),transparent_70%)]"></div>

    <div class="reveal relative z-10 mx-auto max-w-3xl translate-y-8 text-center opacity-0">
      <p class="font-serif text-2xl font-medium italic leading-relaxed text-white md:text-4xl">
        "Budaya <span class="font-bold not-italic">CONFIDENT</span> adalah fondasi
        setiap langkah kami dalam bekerja, melayani, dan bertumbuh bersama."
      </p>
      <div class="mx-auto mt-10 h-px w-24 bg-white/60"></div>
      <p class="mt-6 text-xs font-semibold uppercase tracking-[0.3em] text-white/90">
        PT Prasetia Dwidharma
      </p>
    </div>
  </section>

  <!-- Footer diasumsikan menyambung langsung setelah ini di MainLayout. -->

</MainLayout>

<style>
  html {
    scroll-behavior: smooth;
  }

  /* Values row entrance */
  .value-row {
    opacity: 0;
    transform: translateY(36px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .value-row.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Active row accents */
  .value-row.is-active .value-title {
    color: #dc2626;
  }
  .value-row.is-active .value-num {
    color: #dc2626;
  }
  .value-row.is-active .value-underline {
    width: 3rem;
  }

  /* Rail letter active state */
  .rail-letter.is-active .rail-char {
    color: #dc2626;
    transform: scale(1.15);
  }
  .rail-letter.is-active .rail-dash {
    width: 1.75rem;
    background-color: #dc2626;
  }
  .rail-letter.is-passed .rail-char {
    color: #111827;
  }

  .rail-dot-mobile.is-active,
  .rail-dot-mobile.is-passed {
    background-color: #dc2626;
  }
</style>

<script>
  // ---------- Hero entrance ----------
  window.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.hero-letter').forEach((el) => {
      requestAnimationFrame(() => {
        el.classList.remove('opacity-0', 'translate-y-12');
      });
    });
    setTimeout(() => {
      const sub = document.getElementById('hero-sub');
      const cue = document.getElementById('hero-scroll-cue');
      sub?.classList.add('transition-all', 'duration-700');
      sub?.classList.remove('opacity-0');
      cue?.classList.add('transition-opacity', 'duration-700');
      cue?.classList.remove('opacity-0');
    }, 850);
  });

  // ---------- Hero parallax ----------
  const heroBg = document.getElementById('hero-bg');
  window.addEventListener('scroll', () => {
    if (!heroBg) return;
    const y = window.scrollY;
    heroBg.style.transform = `translateY(${y * 0.35}px) scale(1.1)`;
  }, { passive: true });

  // ---------- Generic reveal (intro strip & closing) ----------
  const revealEls = document.querySelectorAll('.reveal');
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.remove('opacity-0', 'translate-y-8', 'translate-y-4');
        entry.target.classList.add('transition-all', 'duration-1000');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });
  revealEls.forEach((el) => revealObserver.observe(el));

  // ---------- Values: entrance reveal per row ----------
  const valueRows = document.querySelectorAll('.value-row');
  const entranceObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        entranceObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  valueRows.forEach((row) => entranceObserver.observe(row));

  // ---------- Values: scrollspy → aktifkan huruf di rail sesuai baris aktif ----------
  const railLetters = document.querySelectorAll('.rail-letter');
  const railDotsMobile = document.querySelectorAll('.rail-dot-mobile');

  function setActiveIndex(activeIndex) {
    valueRows.forEach((row) => {
      const idx = Number(row.getAttribute('data-index'));
      row.classList.toggle('is-active', idx === activeIndex);
    });
    railLetters.forEach((letter) => {
      const idx = Number(letter.getAttribute('data-index'));
      letter.classList.toggle('is-active', idx === activeIndex);
      letter.classList.toggle('is-passed', idx < activeIndex);
    });
    railDotsMobile.forEach((dot) => {
      const idx = Number(dot.getAttribute('data-index'));
      dot.classList.toggle('is-active', idx === activeIndex);
      dot.classList.toggle('is-passed', idx < activeIndex);
    });
  }

  const spyObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const idx = Number(entry.target.getAttribute('data-index'));
        setActiveIndex(idx);
      }
    });
  }, { threshold: 0.5, rootMargin: '-20% 0px -20% 0px' });

  valueRows.forEach((row) => spyObserver.observe(row));
</script>