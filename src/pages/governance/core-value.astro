---
import MainLayout from '../../layouts/MainLayout.astro';

const values = [
  { letter: "C", title: "Customer-centric", description: "Berfokus pada penyediaan solusi sesuai dengan kebutuhan pelanggan.", id: "01" },
  { letter: "O", title: "Optimistic", description: "Senantiasa berpikiran positif.", id: "02" },
  { letter: "N", title: "Noble", description: "Menjaga kehormatan diri sendiri dan Perusahaan.", id: "03" },
  { letter: "F", title: "Focus", description: "Konsisten bekerja dengan tujuan yang jelas.", id: "04" },
  { letter: "I", title: "Integrity", description: "Sejalan antara kata dan perbuatan.", id: "05" },
  { letter: "D", title: "Dedication", description: "Kesetiaan pada Perusahaan dengan bekerja secara profesional.", id: "06" },
  { letter: "E", title: "Efficient", description: "Menyelesaikan pekerjaan dengan cepat dan tepat.", id: "07" },
  { letter: "N", title: "Nimble", description: "Inovatif & mampu menyesuaikan diri pada perubahan yang cepat.", id: "08" },
  { letter: "T", title: "Teamwork", description: "Saling menghormati, bekerja sama untuk mencapai tujuan bersama yaitu Visi & Misi Perusahaan.", id: "09" }
];

const word = "CONFIDENT".split("");
---

<MainLayout
  title="Core Values - CONFIDENT | Good Corporate Governance | PT Prasetia Dwidharma"
  transparentNavbar={true}
>

  <!-- ============ HERO ============ -->
  <section class="hero-section relative flex h-screen min-h-[560px] w-full items-center justify-center overflow-hidden">
    <div
      id="hero-bg"
      class="absolute inset-0 scale-110 bg-cover bg-center will-change-transform"
      style="background-image: url('/images/governance/gcg3.jpg');"
    ></div>
    <div class="absolute inset-0 bg-gradient-to-b from-red-950/80 via-red-900/40 to-white"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_15%,rgba(220,38,38,0.25),transparent_60%)]"></div>

    <div class="relative z-10 flex flex-col items-center px-6 text-center">

      <h1 class="flex flex-wrap justify-center gap-x-0.5 font-sans text-[clamp(1.6rem,2.8vw,2.2rem)] font-black leading-[1.2] tracking-tight text-white">
        {word.map((char, i) => (
          <span
            class="hero-letter inline-block translate-y-12 opacity-0 transition-all duration-700 ease-out"
            style={`transition-delay:${i * 70}ms`}
          >{char}</span>
        ))}
      </h1>

      <p class="mt-6 max-w-2xl text-[15.5px] font-normal leading-relaxed text-white/90 opacity-0 sm:mt-8" id="hero-sub">
        Senantiasa <strong class="font-semibold text-white">Percaya Diri</strong> dalam menjalankan pekerjaan,
        penuh integritas, dan memberikan pelayanan terbaik bagi pelanggan serta mitra bisnis Perusahaan.
      </p>

    </div>
  </section>

  <!-- ============ INTRO STRIP ============ -->
  <section class="bg-white px-6 pb-16 pt-14 sm:pb-24 sm:pt-16 md:pb-28">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="reveal translate-y-8 opacity-0 text-xs font-bold uppercase tracking-[0.3em] text-red-600">
        Nilai-Nilai Luhur
      </h2>
      <p class="reveal mt-5 translate-y-8 opacity-0 font-sans text-[clamp(1.1rem,1.6vw,1.4rem)] font-medium leading-snug text-gray-900 sm:mt-6">
        Sembilan pilar yang membentuk identitas kerja kami
        <span class="text-red-600">satu budaya, satu tujuan.</span>
      </p>
      <div class="reveal mx-auto mt-6 h-px w-14 translate-y-4 bg-red-600 opacity-0 sm:mt-8 sm:w-16"></div>
    </div>
  </section>

  <!-- ============ CORE VALUES : LETTER-RAIL EDITORIAL LIST ============ -->
  <section id="values-section" class="relative bg-white px-4 pb-20 pt-8 sm:px-6 md:px-12 md:pb-28">
    <div class="mx-auto max-w-5xl">

      <div class="grid grid-cols-1 gap-4 md:grid-cols-[140px_1fr] md:gap-12 lg:grid-cols-[160px_1fr] lg:gap-16">

        <!-- ===== Rail huruf (desktop only) — sticky native, tidak ada lagi JS penghitung posisi ===== -->
        <aside id="rail-wrapper" class="relative hidden md:block">
          <div id="rail-inner" class="sticky top-32 z-10 flex gap-4">
            <!-- garis progress vertikal -->
            <div class="relative w-px shrink-0 self-stretch bg-gray-200">
              <div id="rail-progress-fill" class="absolute left-0 top-0 w-px bg-red-600" style="height: 0%;"></div>
            </div>

            <div class="flex flex-col gap-3.5">
              <span class="mb-1 text-[10px] font-semibold uppercase tracking-[0.3em] text-gray-400">
                Progres
              </span>
              {word.map((char, i) => (
                <div class="rail-letter flex items-center gap-3 transition-all duration-500" data-index={i}>
                  <span class="rail-dash h-px w-4 bg-gray-300 transition-all duration-500"></span>
                  <span class="rail-char font-sans text-body-lead font-black leading-none text-gray-300 transition-all duration-500">
                    {char}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </aside>

        <!-- ===== Values list (mobile progress bar sekarang ikut di dalam sini, biar sticky-nya
               "mengikat" ke tinggi seluruh daftar, bukan cuma tinggi bar itu sendiri) ===== -->
        <div class="min-w-0">

          <!-- Progress bar mobile/tablet — sticky native, otomatis berhenti pas selesai ===== -->
          <div id="mobile-progress-bar" class="sticky top-0 z-30 -mx-4 w-[calc(100%+2rem)] bg-white/90 px-4 py-3 backdrop-blur sm:-mx-6 sm:w-[calc(100%+3rem)] sm:px-6 md:hidden">
            <div class="mb-2 flex items-center justify-between text-[10px] font-semibold uppercase tracking-[0.25em] text-gray-400">
              <span>Progres</span>
              <span id="mobile-progress-label" class="text-red-600">C</span>
            </div>
            <div class="relative h-1 w-full overflow-hidden rounded-full bg-gray-100">
              <div id="mobile-progress-fill" class="h-full rounded-full bg-red-600" style="width: 0%;"></div>
            </div>
          </div>

          {values.map((v, i) => (
            <div
              id={`value-${i}`}
              data-index={i}
              data-letter={v.letter}
              class="value-row group relative min-w-0 border-b border-gray-100 py-6 first:pt-0 sm:py-7 md:py-10"
            >
              <span
                aria-hidden="true"
                class="pointer-events-none absolute -left-1 top-1/2 hidden -translate-y-1/2 select-none overflow-hidden font-sans font-black leading-none text-gray-50 transition-colors duration-500 group-hover:text-red-50 sm:block sm:text-[4.5rem] md:text-[6rem] lg:text-[7rem]"
              >{v.letter}</span>

              <div class="relative flex min-w-0 items-start gap-4 sm:gap-5 sm:pl-12 md:pl-16 lg:pl-20">
                <span class="value-num mt-1 shrink-0 font-sans text-xs font-bold tracking-widest text-gray-300 transition-colors duration-500">
                  {v.id}
                </span>

                <div class="min-w-0 flex-1">
              <h3 class="value-title break-words font-sans text-[clamp(1rem,1.3vw,1.2rem)] font-bold leading-tight text-gray-900 transition-colors duration-500 text-body-lead">
                    {v.title}
                  </h3>

                  <span class="value-underline mt-3 block h-px w-0 bg-red-600 transition-all duration-700 ease-out"></span>

                  <p class="mt-3 max-w-lg break-words text-sm leading-relaxed text-gray-500 sm:mt-4 sm:text-[0.95rem] md:text-base">
                    {v.description}
                  </p>
                </div>

                <span class="hidden shrink-0 self-center font-sans text-section-title font-black text-gray-100 transition-all duration-500 group-hover:translate-x-1 group-hover:text-red-100 md:block text-section-title">
                  {v.letter}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CLOSING ============ -->
  <section class="relative flex min-h-[50vh] items-center justify-center overflow-hidden bg-gradient-to-b from-white via-red-500 to-red-700 px-6 py-20 sm:min-h-[60vh] sm:py-28 md:py-32">
    <div
      class="absolute inset-0 bg-cover bg-center opacity-15 mix-blend-overlay"
      style="background-image: url('/images/governance/gcg3.jpg');"
    ></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_100%,rgba(0,0,0,0.15),transparent_70%)]"></div>

    <div class="reveal relative z-10 mx-auto max-w-3xl translate-y-8 text-center opacity-0">
      <p class="break-words font-sans text-[clamp(1rem,1.5vw,1.25rem)] font-medium leading-relaxed text-white">
        "Budaya <span class="font-bold not-italic">CONFIDENT</span> adalah fondasi
        setiap langkah kami dalam bekerja, melayani, dan bertumbuh bersama."
      </p>
      <div class="mx-auto mt-8 h-px w-20 bg-white/60 sm:mt-10 sm:w-24"></div>
      <p class="mt-5 text-[11px] font-semibold uppercase tracking-[0.3em] text-white/90 sm:mt-6 sm:text-xs">
        PT Prasetia Dwidharma
      </p>
    </div>
  </section>

  <!-- Footer diasumsikan menyambung langsung setelah ini di MainLayout. -->

</MainLayout>

<style>
  html {
    scroll-behavior: smooth;
    /* aman untuk sticky, tidak memicu body jadi scroll-container baru
       (berbeda dari overflow-x: hidden yang memaksa overflow-y jadi auto) */
    overflow-x: clip;
  }

  /* Values row entrance */
  .value-row {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .value-row.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Active row accents */
  .value-row.is-active .value-title { color: #dc2626; }
  .value-row.is-active .value-num { color: #dc2626; }
  .value-row.is-active .value-underline { width: 3rem; }

  /* Rail letter active state */
  .rail-letter.is-active .rail-char {
    color: #dc2626;
    transform: scale(1.15);
  }
  .rail-letter.is-active .rail-dash {
    width: 1.75rem;
    background-color: #dc2626;
  }
  .rail-letter.is-passed .rail-char { color: #111827; }
</style>

<script>
  // ---------- Hero entrance ----------
  window.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.hero-letter').forEach((el) => {
      requestAnimationFrame(() => {
        el.classList.remove('opacity-0', 'translate-y-12');
      });
    });
    setTimeout(() => {
      const sub = document.getElementById('hero-sub');
      sub?.classList.add('transition-all', 'duration-700');
      sub?.classList.remove('opacity-0');
    }, 850);
  });

  // ---------- Generic reveal (intro strip & closing) ----------
  const revealEls = document.querySelectorAll('.reveal');
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.remove('opacity-0', 'translate-y-8', 'translate-y-4');
        entry.target.classList.add('transition-all', 'duration-1000');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });
  revealEls.forEach((el) => revealObserver.observe(el));

  // ---------- Values: entrance reveal per row ----------
  const valueRows = document.querySelectorAll('.value-row');
  const entranceObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        entranceObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  valueRows.forEach((row) => entranceObserver.observe(row));

  // ---------- Values: scrollspy → aktifkan huruf & label sesuai baris aktif ----------
  const railLetters = document.querySelectorAll('.rail-letter');
  const mobileLabel = document.getElementById('mobile-progress-label');

  function setActiveIndex(activeIndex, letter) {
    valueRows.forEach((row) => {
      const idx = Number(row.getAttribute('data-index'));
      row.classList.toggle('is-active', idx === activeIndex);
    });
    railLetters.forEach((rail) => {
      const idx = Number(rail.getAttribute('data-index'));
      rail.classList.toggle('is-active', idx === activeIndex);
      rail.classList.toggle('is-passed', idx < activeIndex);
    });
    if (mobileLabel && letter) mobileLabel.textContent = letter;
  }

  const spyObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const idx = Number(entry.target.getAttribute('data-index'));
        const letter = entry.target.getAttribute('data-letter');
        setActiveIndex(idx, letter);
      }
    });
  }, { threshold: 0.5, rootMargin: '-20% 0px -20% 0px' });

  valueRows.forEach((row) => spyObserver.observe(row));

  // ---------- Progress fill (garis vertikal desktop & bar horizontal mobile) ----------
  const railFill = document.getElementById('rail-progress-fill');
  const mobileFill = document.getElementById('mobile-progress-fill');
  const valuesSection = document.getElementById('values-section');
  const heroBg = document.getElementById('hero-bg');

  function updateProgressFill() {
    if (!valuesSection) return;
    const rect = valuesSection.getBoundingClientRect();
    const viewportH = window.innerHeight;
    const total = rect.height + viewportH;
    const scrolled = viewportH - rect.top;
    const percent = Math.min(Math.max((scrolled / total) * 100, 0), 100);

    if (railFill) railFill.style.height = `${percent}%`;
    if (mobileFill) mobileFill.style.width = `${percent}%`;
  }

  function updateHeroParallax() {
    if (!heroBg) return;
    const y = window.scrollY;
    heroBg.style.transform = `translateY(${y * 0.35}px) scale(1.1)`;
  }

  // ---------- Satu handler scroll, di-throttle via requestAnimationFrame ----------
  // Ini kunci "smooth": semua pembacaan layout (getBoundingClientRect dll.)
  // digabung jadi satu batch per frame, bukan dieksekusi berkali-kali per
  // event scroll mentah.
  let ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      updateHeroParallax();
      updateProgressFill();
      ticking = false;
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', updateProgressFill);
  window.addEventListener('load', () => {
    updateHeroParallax();
    updateProgressFill();
  });
</script>