---
import MainLayout from '../../layouts/MainLayout.astro';

const purposes = [
  "Mewujudkan iklim kerja yang kondusif dan menjadi sarana bagi para pemangku kepentingan (stakeholders) maupun Insan PD untuk melaporkan hal-hal yang dapat menimbulkan kerugian perusahaan baik finansial maupun non finansial yang dapat merusak citra dan keberlangsungan usaha perusahaan.",
  "Memberikan kesempatan kepada para pemangku kepentingan (stakeholders) maupun Insan PD dalam menyampaikan laporan dugaan pelanggaran berdasarkan bukti-bukti yang dapat dipertanggungjawabkan.",
  "Mewujudkan tata kelola perusahaan yang bersih, sehat dan baik.",
  "Menjadi pedoman dan koridor penerapan Pedoman Perilaku & Etika Perusahaan (Code of Conduct).",
  "Menciptakan iklim bisnis dan kerja yang berlandaskan pada peraturan perundang-undangan, nilai moral dan etika."
];

const violationScopes = [
  "Penyimpangan dari peraturan dan perundangan yang berlaku",
  "Pencurian, penyalahgunaan, dan pemalsuan data dan/atau pembayaran klaim / tagihan",
  "Penyalahgunaan jabatan untuk kepentingan lain di luar Perseroan",
  "Pembocoran rahasia Perusahaan",
  "Penyelewengan uang Perusahaan",
  "Pelanggaran terhadap Pedoman Etika & Perilaku Perusahaan PT Prasetia Dwidharma",
  "Penggelapan aset Perusahaan",
  "Pemerasan",
  "Perbuatan curang",
  "Penipuan",
  "Benturan Kepentingan",
  "Gratifikasi",
  "Pemaksaan yang berujung pada penyimpangan",
  "Negosiasi kecurangan",
  "Perbuatan Asusila"
];

const conditions = [
  { title: "Identitas Jelas", desc: "Identitas pelapor dan terlapor harus jelas." },
  { title: "Bukti Valid", desc: "Dugaan pelanggaran yang dilaporkan harus jelas dan dilengkapi dengan bukti-bukti yang valid." },
  { title: "Ditangani Tim WBS", desc: "Laporan akan ditangani oleh Tim Pengelola Whistle Blowing System (WBS)." }
];
---

<MainLayout
  title="Whistle Blowing System (WBS) | Good Corporate Governance | PT Prasetia Dwidharma"
  transparentNavbar={true}
>

  <!-- ============ HERO ============ -->
  <section class="hero-section relative flex h-screen min-h-[560px] w-full items-center justify-center overflow-hidden">
    <div id="hero-bg" class="absolute inset-0 scale-110 bg-cover bg-center will-change-transform" style="background-image: url('/images/governance/gcg1.jpg');"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-red-600/70 via-red-400/40 to-white"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_15%,rgba(220,38,38,0.35),transparent_60%)]"></div>

    <div class="relative z-10 flex flex-col items-center px-6 text-center">

      <h1 id="hero-title" class="max-w-4xl translate-y-8 font-serif text-4xl font-black leading-[1.1] tracking-tight text-white opacity-0 transition-all duration-1000 ease-out sm:text-6xl md:text-7xl drop-shadow-sm">
        Whistle Blowing System
      </h1>

      <p class="mt-8 max-w-2xl translate-y-6 text-base font-light leading-relaxed text-white/90 opacity-0 transition-all delay-300 duration-1000 md:text-lg" id="hero-sub">
        Sarana pelaporan independen dan terpercaya untuk mewujudkan tata kelola
        perusahaan yang <span class="font-semibold text-white">bersih, transparan, dan akuntabel.</span>
      </p>


    </div>
  </section>

  <!-- ============ INTRO STRIP ============ -->
  <section class="bg-white px-6 pb-20 pt-16 md:pb-28">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="reveal translate-y-8 text-xs font-bold uppercase tracking-[0.3em] text-red-600 opacity-0">
        Pedoman Pelaporan Dugaan Pelanggaran
      </h2>
      <p class="reveal mt-6 translate-y-8 font-serif text-2xl font-medium leading-snug text-gray-900 opacity-0 md:text-4xl">
        Ruang aman untuk bersuara
        <span class="text-red-600">tanpa nama, tanpa rasa takut.</span>
      </p>
      <div class="reveal mx-auto mt-8 h-px w-16 translate-y-4 bg-red-600 opacity-0"></div>
    </div>
  </section>

  <!-- ============ MAIN CONTENT : STICKY RAIL + SECTIONS ============ -->
  <section class="relative bg-gradient-to-b from-white via-red-50 to-red-100 px-6 pb-32 pt-4 md:px-12">
    <div class="mx-auto max-w-6xl">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-[200px_1fr] md:gap-16">

        <!-- ===== Sticky rail (desktop) ===== -->
        <aside class="hidden md:block">
          <div class="sticky top-32 flex flex-col gap-6">
            <span class="mb-2 text-[10px] font-semibold uppercase tracking-[0.3em] text-gray-400">Daftar Isi</span>

            <a href="#wbs-section-0" class="rail-item group flex items-start gap-3 transition-all duration-500" data-index="0">
              <span class="rail-dash mt-2 h-px w-4 bg-gray-300 transition-all duration-500"></span>
              <span class="flex flex-col">
                <span class="rail-num font-serif text-xs font-bold tracking-widest text-gray-300 transition-colors duration-500">01</span>
                <span class="rail-label text-sm font-semibold text-gray-400 transition-colors duration-500">Tujuan</span>
              </span>
            </a>

            <a href="#wbs-section-1" class="rail-item group flex items-start gap-3 transition-all duration-500" data-index="1">
              <span class="rail-dash mt-2 h-px w-4 bg-gray-300 transition-all duration-500"></span>
              <span class="flex flex-col">
                <span class="rail-num font-serif text-xs font-bold tracking-widest text-gray-300 transition-colors duration-500">02</span>
                <span class="rail-label text-sm font-semibold text-gray-400 transition-colors duration-500">Ruang Lingkup</span>
              </span>
            </a>

            <a href="#wbs-section-2" class="rail-item group flex items-start gap-3 transition-all duration-500" data-index="2">
              <span class="rail-dash mt-2 h-px w-4 bg-gray-300 transition-all duration-500"></span>
              <span class="flex flex-col">
                <span class="rail-num font-serif text-xs font-bold tracking-widest text-gray-300 transition-colors duration-500">03</span>
                <span class="rail-label text-sm font-semibold text-gray-400 transition-colors duration-500">Syarat &amp; Pengaduan</span>
              </span>
            </a>
          </div>
        </aside>

        <!-- ===== Mobile progress bar ===== -->
        <div class="md:hidden">
          <div class="mb-8 flex items-center gap-1.5">
            <span class="rail-dot-mobile h-1 flex-1 rounded-full bg-gray-200 transition-all duration-500" data-index="0"></span>
            <span class="rail-dot-mobile h-1 flex-1 rounded-full bg-gray-200 transition-all duration-500" data-index="1"></span>
            <span class="rail-dot-mobile h-1 flex-1 rounded-full bg-gray-200 transition-all duration-500" data-index="2"></span>
          </div>
        </div>

        <!-- ===== Content column ===== -->
        <div class="flex flex-col gap-24">

          <!-- ---- 01 : TUJUAN ---- -->
          <div id="wbs-section-0" data-index="0" class="wbs-section relative">
            <span aria-hidden="true" class="pointer-events-none absolute -left-4 -top-10 select-none font-serif text-[9rem] font-black leading-none text-red-50 md:text-[11rem]">01</span>

            <div class="relative">
              <div class="mb-3 flex items-center gap-4">
                <span class="h-px w-10 bg-red-600"></span>
                <span class="text-xs font-bold uppercase tracking-[0.35em] text-red-600">Tujuan</span>
              </div>
              <h3 class="max-w-2xl font-serif text-2xl font-bold leading-snug text-gray-900 sm:text-3xl">
                Pedoman ini diterapkan Perusahaan untuk:
              </h3>

              <div class="mt-10 flex flex-col">
                {purposes.map((purpose, index) => (
                  <div class="wbs-row group flex items-start gap-6 border-b border-red-100 py-6 first:pt-0 last:border-b-0">
                    <span class="mt-1 shrink-0 font-serif text-2xl font-black leading-none text-red-200 transition-colors duration-500 group-hover:text-red-400 sm:text-3xl">
                      {String.fromCharCode(97 + index)}
                    </span>
                    <p class="text-sm leading-relaxed text-gray-600 sm:text-base">{purpose}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- ---- 02 : RUANG LINGKUP ---- -->
          <div id="wbs-section-1" data-index="1" class="wbs-section relative">
            <span aria-hidden="true" class="pointer-events-none absolute -left-4 -top-10 select-none font-serif text-[9rem] font-black leading-none text-red-50 md:text-[11rem]">02</span>

            <div class="relative">
              <div class="mb-3 flex items-center gap-4">
                <span class="h-px w-10 bg-red-600"></span>
                <span class="text-xs font-bold uppercase tracking-[0.35em] text-red-600">Ruang Lingkup</span>
              </div>
              <h3 class="max-w-2xl font-serif text-2xl font-bold leading-snug text-gray-900 sm:text-3xl">
                15 kategori pelanggaran yang ditindaklanjuti Tim Pengelola WBS
              </h3>
              <p class="mt-4 max-w-2xl text-sm leading-relaxed text-gray-500 sm:text-base">
                Meliputi tindakan yang dapat merugikan Perusahaan, baik secara langsung maupun tidak langsung, sebagai berikut:
              </p>

              <div class="mt-10 grid grid-cols-1 gap-x-8 gap-y-0 sm:grid-cols-2">
                {violationScopes.map((scope, index) => (
                  <div class="scope-row group flex items-start gap-4 border-b border-red-100 py-5">
                    <span class="mt-0.5 shrink-0 font-serif text-sm font-bold text-red-200 transition-colors duration-500 group-hover:text-red-600">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="text-sm leading-relaxed text-gray-700 transition-colors duration-500 group-hover:text-gray-900 sm:text-[15px]">
                      {scope}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- ---- 03 : SYARAT & PENGADUAN ---- -->
          <div id="wbs-section-2" data-index="2" class="wbs-section relative">
            <span aria-hidden="true" class="pointer-events-none absolute -left-4 -top-10 select-none font-serif text-[9rem] font-black leading-none text-red-50 md:text-[11rem]">03</span>

            <div class="relative">
              <div class="mb-3 flex items-center gap-4">
                <span class="h-px w-10 bg-red-600"></span>
                <span class="text-xs font-bold uppercase tracking-[0.35em] text-red-600">Syarat Laporan</span>
              </div>
              <h3 class="max-w-2xl font-serif text-2xl font-bold leading-snug text-gray-900 sm:text-3xl">
                Laporan dapat diproses apabila memenuhi tiga syarat berikut
              </h3>

              <div class="relative mt-12 flex flex-col gap-10 pl-2 sm:pl-4">
                <div class="absolute left-[15px] top-2 h-[calc(100%-2rem)] w-px bg-red-200 sm:left-[19px]"></div>
                {conditions.map((c, i) => (
                  <div class="relative flex items-start gap-6">
                    <span class="relative z-10 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 border-red-600 bg-white font-serif text-sm font-bold text-red-600 sm:h-10 sm:w-10">
                      {i + 1}
                    </span>
                    <div class="pt-1">
                      <h4 class="font-serif text-lg font-bold text-gray-900 sm:text-xl">{c.title}</h4>
                      <p class="mt-1.5 max-w-xl text-sm leading-relaxed text-gray-600 sm:text-base">{c.desc}</p>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Kontak WBS -->
              <div class="mt-10 max-w-xl border-l-2 border-red-600 pl-6">
                <p class="text-sm leading-relaxed text-gray-700 sm:text-base">
                  Ingin melapor? Hubungi Tim WBS melalui <a href="mailto:wbs@prasetia.co.id?subject=Laporan%20Dugaan%20Pelanggaran%20WBS" class="font-semibold text-red-600 underline decoration-red-300 underline-offset-4 transition-colors duration-300 hover:text-red-700 hover:decoration-red-600">wbs@prasetia.co.id</a>.
                </p>
                <p class="mt-3 text-xs leading-relaxed text-gray-500 sm:text-[13px]">
                  Setiap laporan akan dijaga kerahasiaan identitas pelapornya sesuai dengan ketentuan perlindungan saksi internal perusahaan.
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ============ CLOSING ============ -->
  <section class="relative flex min-h-[55vh] items-center justify-center overflow-hidden bg-gradient-to-b from-red-100 via-red-500 to-red-700 px-6 py-24 md:py-32">
    <div class="absolute inset-0 bg-cover bg-center opacity-15 mix-blend-overlay" style="background-image: url('/images/governance/gcg1.jpg');"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_100%,rgba(0,0,0,0.1),transparent_70%)]"></div>

    <div class="reveal relative z-10 mx-auto max-w-3xl translate-y-8 text-center opacity-0">
      <p class="font-serif text-2xl font-medium italic leading-relaxed text-white md:text-4xl">
        "Mewujudkan tata kelola yang <span class="font-bold not-italic">bersih dan sehat</span>, dimulai dari keberanian untuk bersuara."
      </p>
      <div class="mx-auto mt-10 h-px w-24 bg-white/70"></div>
      <p class="mt-6 text-xs font-semibold uppercase tracking-[0.3em] text-white/90">PT PRASETIA DWIDHARMA</p>

      <p class="mt-8 text-sm leading-relaxed text-white/85 md:text-base">
        Mewujudkan tata kelola bersih dan sehat, WBS Prasetia memberi ruang pelaporan pelanggaran. Info selengkapnya di <a href="https://kadinjakarta.org/" target="_blank" rel="noopener noreferrer" class="kadin-link">Kadin Jakarta<svg class="kadin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"></path></svg></a>.
      </p>
    </div>
  </section>

</MainLayout>

<style>
  html {
    scroll-behavior: smooth;
  }

  .wbs-section {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .wbs-section.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .wbs-row,
  .scope-row {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .wbs-row.is-visible,
  .scope-row.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Hanya SATU status aktif pada satu waktu; sisanya kembali netral */
  .rail-item .rail-label,
  .rail-item .rail-num {
    color: inherit;
  }
  .rail-item.is-active .rail-label,
  .rail-item.is-active .rail-num {
    color: #dc2626;
  }
  .rail-item.is-active .rail-dash {
    width: 1.75rem;
    background-color: #dc2626;
  }

  .rail-dot-mobile.is-active {
    background-color: #dc2626;
  }

  /* Link Kadin Jakarta: garis bawah + panah muncul saat hover sebagai penanda bisa diklik */
  .kadin-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .kadin-link:hover {
    color: #fecaca;
    border-color: #ffffff;
  }
  .kadin-icon {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }
  .kadin-link:hover .kadin-icon {
    transform: translate(2px, -2px);
  }
</style>

<script>
  // ---------- Hero entrance ----------
  window.addEventListener('DOMContentLoaded', () => {
    const title = document.getElementById('hero-title');
    const sub = document.getElementById('hero-sub');
    const cue = document.getElementById('hero-scroll-cue');

    requestAnimationFrame(() => {
      title?.classList.remove('opacity-0', 'translate-y-8');
    });
    setTimeout(() => {
      sub?.classList.remove('opacity-0', 'translate-y-6');
    }, 200);
    setTimeout(() => {
      cue?.classList.add('transition-opacity', 'duration-700');
      cue?.classList.remove('opacity-0');
    }, 900);
  });

  // ---------- Hero parallax ----------
  const heroBg = document.getElementById('hero-bg');
  window.addEventListener('scroll', () => {
    if (!heroBg) return;
    const y = window.scrollY;
    heroBg.style.transform = `translateY(${y * 0.35}px) scale(1.1)`;
  }, { passive: true });

  // ---------- Generic reveal ----------
  const revealEls = document.querySelectorAll('.reveal');
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.remove('opacity-0', 'translate-y-8', 'translate-y-4');
        entry.target.classList.add('transition-all', 'duration-1000');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });
  revealEls.forEach((el) => revealObserver.observe(el));

  // ---------- WBS sections: entrance ----------
  const wbsSections = document.querySelectorAll('.wbs-section');
  const sectionObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        sectionObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });
  wbsSections.forEach((el) => sectionObserver.observe(el));

  // ---------- Rows: staggered entrance ----------
  const rowEls = document.querySelectorAll('.wbs-row, .scope-row');
  const rowObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        setTimeout(() => entry.target.classList.add('is-visible'), i * 40);
        rowObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  rowEls.forEach((el) => rowObserver.observe(el));

  // ---------- Scrollspy: hanya satu section aktif pada satu waktu ----------
  const railItems = document.querySelectorAll('.rail-item');
  const railDotsMobile = document.querySelectorAll('.rail-dot-mobile');

  function setActiveIndex(activeIndex) {
    railItems.forEach((item) => {
      const idx = Number(item.getAttribute('data-index'));
      item.classList.toggle('is-active', idx === activeIndex);
    });
    railDotsMobile.forEach((dot) => {
      const idx = Number(dot.getAttribute('data-index'));
      dot.classList.toggle('is-active', idx === activeIndex);
    });
  }

  const spyObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const idx = Number(entry.target.getAttribute('data-index'));
        setActiveIndex(idx);
      }
    });
  }, { threshold: 0, rootMargin: '-20% 0px -70% 0px' });

  wbsSections.forEach((el) => spyObserver.observe(el));
</script>